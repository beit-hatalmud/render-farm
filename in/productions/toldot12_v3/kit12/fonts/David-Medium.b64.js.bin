זְֳו׳זאצזמזודזג׀זףצזזץאב•ֶנצְצ—ßיזזויזאעז‎זו׳זןעזֵצזזףנסֶּÿס׃זזואזאזְֵו—זג‏זֵ׀וÞזאִז‎צזְזדמזכְז׀זהזזטְזְזגצז‏צו•זאּז‎זזְזגךזףזויזהזזףצוֻזאצזֶצו–זא—זמזז‘זהזזךְז’זה—זי׀ז׃זדמזךזזÞזדצזזג‎ֵֹׁץאֵ”םֹ‎פזÞכֽזְט־וג‏ÿ‎׳‎הודףג—ְףנסֶּÿס׃מדְָךּֽ׃יÞ—Þךדמ—זזוגזאגזְֳו׳זאצזמזודזג׀זףצזְזג—ז‎צוּזאּזֳצו׃זזוג‏ÿ‎׳‎הודףג—ְףנסֶּÿס׃זזונזאעזְִוÝזאּזֵ׀וׂזהזזךזזׂזדגזיזז׀זזונ‎ÿםÝֶנׂמדזׂךףצ׀זזוגזאגזְֳו׳זאצזצ׀וךזג—זכצויזאעז‎זו׳זןעזֵצזזץאב•ֶנץדףג—׃ףנסֶּÿס׃זזזזזזךזזזזדזזזזןזזוזזזזזזבְזזךזזצזזזו׀זוזבגזזזזמְזְזזצזזְזזזן“זָ׀יקוֶװבßצÿןוֲָבהזֲמה‏ְױהמפםִÝָהֱ׃קˆˆזזזזזזהזזָזיקוֶװבװזÿןוֳזבהזךמה‏ְײ־מפםִÝָזֱװֳˆˆזזֱˆ־זזדבקײ’ױÿ‘׃קײװײִזזטהדזזדֲÊ׃ױֿזזזזזזזוזזזזזזזֲזזזזזזזזזזזזזזזזזוְזזזז‘זזזזזזז‘זגָזזזוֿזזזזזזו־זם׀זֹצהֲזםזזזזזזזזזָזהֿזלמזזזזזזלךז׳זהֻזזזז׳ְהֹזלְזײְזזזלװזױְהׁזכזזװצהÞזכךז׃זה–זכ‏ז׃׀ה“זכּזְׂהזכ׀זׁצהזכז׀זדוזךמז׀׀דגזךעזßְדןזךְזÞצדלזךװזÝזדיזך“זÝ׀דצזיגז—ְדףזיצז–צדנזיִז•זד‎זיָז•׀דִזי—ז”ְדֱזטזז“צד־זטךז’זדֻזט‏ז’׀דָזטּזזזגאזזזוזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזמדוזעאו׀ְםהְװךדצ“קגוגפגßצסבִֿ‏אץֵָןו—ֲןÞזֿמ־ךּםפ‏ֹלהּײלÞ׀׃כ־׀ךףמÝידע•יÝְ’טֽװקף“ˆצגבהצ—ץבץֳּמפע׳כףג–טף–וץעֻיעסס‎ÿנבֶֻנ–ßֳÿֻְזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזז‏ְזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזה׳‏צזזזזזזָלאÊ׳‘טּזזזזזזהױזזזזזזזז׳ְֶזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזז׀זזזזזזזק–זדמזזזזזזזזזזזזזזזזזזזזזזזזזזזגזוזצזזצגוגגץֳֿÊֻּצ—ßיכע–ֻ‎אֻ–ֵצזוזְזוזגׁ“ְָד“ָ׀ן“׳זכ“׳צק“ב׀צֲהְזמךÝךˆ־“װֲהְזמךÝךˆ־“װךוˆׂכזִוצכ’–׀עֳזזזןגְֳזזזזזוזֳזזזמץגֳזזזזמֿ—זזןהגְהכזְזוזזְזד׀זנזו—זםְזׁזדְזצצולזבךזÿזוֻזא“זֳ׀וזמִזּזה‎זלמזײ׀ה—זכ—זßְדקזי‏ז”צדּזט—זְדˆזצְוגצגֶזפךוכזג–זף“וץ׀בצזסּו‏ְבױזÿצוֱצאאז‏וÊזאֿזֶָוװ׀אזִעוÝְןÿזֲזו‘צןÞזֱּהזזמםזֿזהב׀מֲז־ִהךזמ—זֽװהצְםםזֻזהס׀םֲזÊעהֵזםÝזָֹהְצלמזָהְֻלֳזײצהײ׀לÞזױּה׀זכןזװ“ה–צכִזׂךה‘ְכßזְׁהˆ׀ךאז׀—דבזךֵזÞמדלצך׀זÝִדקְיבז—׀דע׀יֶז•גדֶזיׁז”‏דֱצטגז“װדְּט‎ז‘זד׳׀טׂזעדׁזקדזָד—צק‏זד‘׀ק”וזצגבצצÊודְגץזץקובצבֳזנגו‏––ֵÊּ׀ךדז׀ֳנ’׳ךדווךןסֶׂףזÝיג‎–ֵÊּ׀יעבה‏נ‎׳ֶףע”יÝּ’‏נ‎׳ֶףע”טדזß‏נ‎׳ֶףע”טדז׀‏נ‎׳ֶףע”טדזÞ‏נ‎׳ֶףע”יÝּÝ‏נ‎׳ֶףע”יÝּ—‏נ‎׳ֶףע”יÝּ–‏נ‎׳ֶףע”יÝּ“‏נ‎׳ֶףע”יÝּ”‏נ‎׳ֶףע”טדז•ֳנ’׳ךדסהצנבÊֶנּ–יÝִ’יÊבÊֶנּ–יÝְ