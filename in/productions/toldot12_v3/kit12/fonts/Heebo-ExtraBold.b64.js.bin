הךצֳ–ֵÊּ׀יעמÞו”סֶׂףז–צֽךןֳנ’׳ךדסהיזֳ–ֵÊּ׀יעמ–ו”סֶׂףז–צֽ‏ןֳנ’׳ךדסהי׀ֳ–ֵÊּ׀יעך”ו”סֶׂףז–צְֽןֳנ’׳ךדסהטצֳ–ֵÊּ׀יעםוו”סֶׂףז–צּמןֳנ’׳ךדסהצ׀ֳ–ֵÊּ׀יעםאו”סֶׂףז–צÝגןֳנ’׳ךדסדךְ‎װֵ•’ִֹ”צהִ”צמ‏”םִׁ”י־‏ÿמךכֹץ—‎Êב–ֳאֶָנ’—זזגזזֱˆˆזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזבבזעעזˆזדוכגזזק’ְהאכְָףצˆֽ‏זֿ־ˆלמוטזג“זק׀זˆזנ׀זזזבזצ‘זזד‏זֿ־ˆלמבßקˆװוְֱגףׁˆװˆּװמ‏ׁÞ־זי‏ז–ְה׃זל—וױק‘ÿהאכְָא“ˆָ׀מ‏ׁÞ־זי‏ז–ְה׃זל—בװזלֵהאכְָנז׳זמ‏ׁÞ־זזה׀זה׀ְװזוסנגס‎מהוכׂזזטעעׂ׀וֻיֶנכז—אזָננוÊממ׳סנכזהםנא’הזזמזאיֽמ•מֵמפא׀זבÊ׀זגךֽץכמזזצוד‏גמ׃װזגװװהוְ‎־•׀ז־׀ְ‎הה׀׀בה׀וה‎ֶװ־ְוה—יב‏—נ׀וּס‏מֵזדםסֻפנ–ְֿמÞגֵ־ְְֻװבוצנהא׀צבֵּמכז“עבְֿװדֿ‎נפהßזצ׃דץניב‏נפ׀לבו‏מֵגוה—יב‏—עְװדוצנהא׀ךבֵּמכדזעבְְ‎־הל־Êגְװז׳צנאזֵמכזְעבְֿװז׳ְאÞה׀יֻו‏מֵז•‏ו׃ְנסֻ‎אזהםֵזלצ•ט׀זבם‏װזוכװז׳צנהא׀הּךֵפזֲעבְֿװו’כ‏ְֵצזאט׀הּיֽׂזעז‏ֻֻ‎‎אב‎װזגױנסּֽװזוצנאס‎נפ•׀זÞ׀ְץפה׀והסֿ‎הה׀ועיצנכזבמ—ל׀ו־יהאÞגֿנֵזו‏ה•׀וה׀ֽמפךֿמאפßונםהמכזאמ—ל׀וּס‏אגוה—יב‏גוה—ט׀ואוב‏זדל־גְװז‎דממְָ־ױזולג׀ופנ׀וה‎ץנאוצא•בפנסְֽנפב‎מכוזע–־׀זפװֵמֵוזנפט׀זבו‏‎סּ׃װזעװװזֳדלמזזְוד‏גמ׃װז‏װװזִֽצ־ךְװזזֽצÊא׀זÊםÊװזבֽװזבְװזעײכֵזןכהזְץפה׀דגיֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זניְץכזו‏ה•׀ההÞÞו׀׀זצ—סהל־אÞזזגזצ•והכֵזםככזזצÞיגװְזוזגיְצ־•׀ה־׀ְמגעְװזגױמזזצזגםנזְץ‏ָֽ‏פוּמכזְעבְֿװזזֵװדוצנכזְאוזנסּֽװזוצנאס‎װזךֻמ•בגץכזו‏ה•׀הÞ׀ְמגעְװזגױמזזצזגםנזְץ‏ָֽ‏פוּװהץצנכזזאוזנפט׀זבו‏‎סÊ׀זÞעֽ‏עץגװזבְכֵזךכהה׀זהיהװְװלז—ס‏מץװֽמסּײמפ•׀דפÞßזְםבװאץֿץה•׀ד־Þ׀זנזְמכזיצ—ײ׀זבו‏מכזימ—ם‎װז’דפױזזעְְֻװז“ֽצֻּ׃װזװמכזצ‏Êֶ׀זנךְׂזצז‏“ָֽ‏ֵזקצ•זְ־Êזְװזֽצ־ך׃װוזװפ–ץ‏װצץּץבּּװז–ֻמ”ְ׃װוגװפ–ב‏פ–י‏װצץּץבֵּמסּּװויֻמ”ְ׃װומװװצזצצ–ס‏װץזצצזו‏על׀דÞ׃‎װזודװזמֻצױגיז־סהװצ“הםעל׀זץ‏ֽמכזדםסו‏װצגזצ•ה׀והסה־ְָָ־־יֿװז“ײמפט׀זנגְ־־יֿװז“ײמץׂßזצוד‏כזהםעל׀ז־סֿװז“ײמסÊ׀דעיןװז’דץ•ה׀זÊמְװזוצנכוז‏בֻÊװזבֽמכזךצ•ט“וזו־מכזזעב־׀צאו‎‎ױזו‏•הßזזזףמ—פ׀זעט׀זד‘Þזצגוצ•והכֵזףכזהßזזםבסב־׀גהיהמגנ׀דהיהװזװֽװזץְצ־וְװזבֿ׃ץמפזצזקזגםה־Êהßגְ‏ױװמּױאÞם‎כֵזעככגזגÞװ׃װועװװצגףלÞ•׀ב־ÞßזֿךױכֵזÿככגדגÞװ׃װוְװװצצףלÞ•׀אפÞßוץךױכֵזֶככגאגÞװ׃װוװװװצִףלÞ•׀ןהÞßהוךױכֵזֳככגםגÞװ׃װהּװמÞה׀גאםÊװזבֽװז‎ְפ–ץ‏מÞזׂװזבֳאÞגֿנפ•׀ל־׀ֽמכזצ‏Êֶ׀זנט׀בÊוכסבְֽמה‘׀זÿגֵמפב‎כֵזױכהךְװוו־‎ױזו‏זÊ‏ג׃ענהךְכױזוִֿװֿמסּ׃װו“װזכזילגזזּסענכזצמ—מְץֵזךמ—ל׀הÞט׀ואוהמאה׀זנא–גֿמוזזזצּלל‏כגפו־ׂ׀־פװֵמֻּ׃װוװװצזֲלÞ•׀מהÞßזץ“ױכֵזֿככגהן־װ׃װהמװװצךֲלÞ•׀מÞÞßוו“ױכֵזּככגבן־װ׃װהעװװצ‏ֲלÞ•׀ם־Þßוß“ױכֵזֹככגמן־װ׃װהְװװצֲּלÞ•׀כה׀ְקכזו‏ה•׀כפ׀ְ‏כזפ‏הודמזו‏גט׀ז־סֿװזבְװה׀ײמפ•׀כ־Þ׀כפׂ׀כפָ׃װהװמהוןמהה׀דגיֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זניְמ•ג“מÞהלססְְץÞזְװזßד‏ְגזאמְװזוצנכוז‏בֻÊװזבֽ‏היֿטוװֿנפ•׀ךה׀זװצזהץסץ‏װזגנװהײװצעובעס‏ךבֵּמֻּ׃װדגװזכזילגזזּסענכזובױזׁלױגבזץסבנדו‎אÞם‎כֵזÞכהז–װזבְכֵזÝכזה׀זעסֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זנט׀זפׂ׀דגיֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זנט׀זפׂ׀זוֶ—זזזזזזוגק־ך“װףמובפָֿכֵז—כהזמגְִװזßד‏ְגזאמְװזוצנכוז‏בֻÊװזבֽ‏כזזצ•ג“כֵז–כה“ÿקה•׀י־׀ְקהוןמכזךצ•ט“וזו־מכזזעב־׀צאו‎‎ױזו‏•ה׀זגיֿװזבד‏Ýְ׃װדִװװצמזב־עְכ־וןװזזֽצױזהםעÊל־ִּֽץÞיֿמבֿ־אÞב‎װזגֽצױמ•זצגסבהָ׃װדְװװזזנװוגֽצױזגםֵזגםעִֽץÞיֿװצָזצױזםצÞ׃ֻ־־“ֽמהז־ְֽ׃װדּװװזזנװוגֽצױזגםֵזגםפזׂץÞיןמ•גְװזצֽצױגלזגל׀העךױמכוְעבְְװגוץנכךהמזךְאךהםְךֶנעםהמÞה׀הגךְ־־יןמ—ִֽ‏פיא‏כזגצזה‏־ה׀זבו‏װגוְננֶ׀זניְמכזולÞהל־Êגְװזםד‏אצֽװזיד‏נץצנכזהצ•גֵװזיד‏בÊ׀זÞנ׀זÊמְװזוצנכוז‏בֻÊװזבֽ‏פךְמכזגם־יא‏ףְֵמזמצ—ֶ׀ז־נ׀הגיןמ—ִֽ‏נזְװזץדװזם־מכזזעב־׀צאו‎‎ױזו‏•זֽמכזולÞט׀וגיְװזגױװזעֻ‏ֵזבםֵזה‏־ה׀זבו‏װגוְננֶ׀זנט׀וה‎ֿמכזגםנוּמזדםנוּעבְֿאÞךֿנפךְמכזגם־יא‏ףֿ‎כֵז‘ככזזבױזץמ—מְמהה׀ופ‏ְכִּֽץÞיֿמÝ׀“כֵזככזזבױזץמ—מְװזְֽצ־זְמג‏ֽץזולÞיֿטה•׀קהÞ׀זוֶ׀גפיהװזךֻװזמֻץÞיןמ•א׀זבץ‏כ־זמÞגֵװזמֻװזמֻץÞיןמ•גְװזעֻװזצֻץÞיןמ•א׀ו־נ׀ופסםװזמֻ‏ֵּמזזְז‏•ךֽמבֿ־אÞב‎‏ְגזאמְװזוצנכוז‏בֻÊװזבֽ‏הךׂמÞזְקמָ“מÞב‎כֵזככזזבױזץמ—מְװזֿדמה’ןמ—ִֽ‏פוְװהוְ‎ױזה‏־ה׀זבו‏װגוְננֶ׀זנךֽמהז־ְֽ׃װד“װמÞזׂץױזהםעֶ׀געי‏עו׃פנסְְקבּׂװפ“ובהװ׃װדװמÞזׂץױזהםעֶ׀געי‏עֿ׃צנסְְקבּׂװפ“ובהװ׃װגזװמÞזׂץױזהםעֶ׀געי‏עו׃פנסְְקבּֽמה’אװזמֻץױזץצ–ֿפא–ו‎נהזנפ‘ßכְגעלÞ•׀צפÞ׀טהװֽמה’אװזמֻץױזץצ–ֿצא–ם‎נהזנפ‘ßכְגעלÞ•׀צ־Þ׀טפׂלמהזװזצֽצָָ“מÞזׂץױזהםעֶ׀געי‏עו׃פנסְְקבּׂװפ“ובהׂ׀וגךׂװה“ױכֵודככזזבױזגםֵזגם־זְמג‏ֽץ•א׀ה־יהכִּֽץÞיֿװזֻדלÞךְקהזׂמÝ־ßכְגעלÞ•׀ץהÞßהזצֻצױזזבױזגםֵזגםפזׂץÞיןמ•גְװזצֽצױגלזגל׀העךױמכוְעבְְװגוץנכךהמזךְאךהםְךֶנעםהמÞוןװזץדװזם־מכזזעב־׀צאו‎‎ױזו‏•זְװזגױממײל‏פה׀זּיְ‎הט׀ז—יֿ‎בו‏װזםד‏ץׂ׀ז—יְנֵזדםֵזה‏־ה׀זבו‏װגוְננֶ׀זניֿװזמֻץÊג“מÞזמÝְֵמפזְץ־יןװזגױמ•ג“מסÊßכְגעלÞ•׀ץפÞßזדְױכױגׂזץצױכֵואככגזטפװֿמÞזְקכזגמ—מֽטכגׂזץצױװזץדכױזׂלÞ•׀ץÞÞ׀זועְץזזמ—לÞזזגובץצףכױז—ל־•׀פהÞ׀זועְץזזמ—לÞזזגובץצףכױז—ל־•׀פפÞßזזגעגז–ל־•׀פ־Þ׀יÞָ׃װגװװװזזנץפךְכ־וא־־יֿטכגׂזץצױכֵוךככזממ—ל׀פÞװ׃װג—װװְזזץהװ׃װג“װװְזוץהװ׃װגװװְגזץהװ׃װבזװװְגוץהװ׃װבגװװְזזץפװ׃װבמװװְזוץפװ׃װבךװװְגזץפװ׃װבצװװְגוץפװ׃װבעװװ׀זזזגגױכֵונככךזזצוולÞ•׀סÞÞÝזצזזצפװ׃װבְװװ׀גוזגגױכֵו‎ככךזזזבולÞ•׀נ־ÞÝזזגוצפװ׃װבװװװ׀גזזעגױכֵוִככךוזצבולÞ•׀ÿפÞÞזזודלÞ•׀ÿ־ÞÞזזבדלÞ•׀ÿÞÞÞזצודלÞ•׀‏הÞÞזצבדלÞ•׀‏פÞÞזזואלÞ•׀‏־ÞÞזזבאלÞ•׀‏ÞÞÞזצואלÞ•׀‎הÞÞזצבאלÞ•׀‎פÞÝזזזזצ־װ׃װא‏װװ׀זוזגמױכֵוֹככךוזזוהלÞ•׀ֶהÞÝזצגזצ־װ׃װאּװװ׀זזזעמױכֵוײככךזזצבהלÞ•׀ֶÞÞÝזצזוצ־װ׃װא׀װװ׀גוזעמױכֵו׃ככגזט־װׂװפ“ובהװ׃װא“װװצז‘לזלÞ•׀ֵÞÞßזדָױװדױכֵו׀ככזזבױגזט־ׂ׀צהװ׃װןגװװצג‘לזלÞ•׀ִ־ÞßזףָױװדױכֵוÝככזזבױגוט־ׂ׀צהװ׃װןצװװצזלÞ‘ßכְגעלÞ•׀ֳפÞßזדװױװד“ױכֵו•ככגזטÞׂ׀קÞװ׃װןִװװצזלוזלÞ•׀ֲהÞßזףװױװד“ױכֵו’ככגוטÞׂ׀קÞװ׃װןָװװצגלוזלÞ•׀ֲÞÞßזד׀ױכױגׂזץצױכֵוככגזקהׂ׀ק־װ׃װן—װװצזלזˆלÞ•׀ֱ־Þßזד׀ױװגזױכֵוˆככגוקהׂ׀ק־װ׃װמזװװצגלזˆלÞ•׀ְפÞßזף׀ױװגזױכֵההככגזקפװׂװפ“ובהװ׃װמךװװצזלזלÞ•׀ֿהÞßזד—ױװדױכֵהבככגזקפׂ׀צהװ׃װמ‏װװצגלזלÞ•׀ֿÞÞßזף—ױװדױכֵהמככגוקפׂ׀צהװ׃װמּװװ׀ּגזְיבנהגֵמÞב‎צ־ׂ׀האנ׀זÞץצֲכגבזץסבנדו‎כצזזזגׂ“זךֿפנכגוז‏’‎װזא’הזזמזאי׀װצזןצױעזזדזזוזזײװצזןצּזלצ׀צ”והךמבצעגההײßזזֳהצז׳םזֽ—הכצ‏ִז׀צמלױגזה—לגצזטזזּזו‏זזוזזםלױגזד—לזגזזצזוזזגזזוזזםלױגדזגפßםזאמעס־׀צמֿ‏װציּץכגÊז‏ֿץנכָמְזזווגהמ‏–ץ‏װצךזץבֻ‎נסֻזהּעגטצצֻהוִבוז׀ײׂזןˆֵֿזגֵֽגהזגפÝונצאזגץגזזזזזזזזזצזזזזז…×­