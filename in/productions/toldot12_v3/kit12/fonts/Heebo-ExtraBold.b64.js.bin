זז׀זווזּזגזזלוסךזז׀זווזּזגצזפוס–דֵ”ו’ִÊֶֹֻןצְךֽזßיהועֶאעְפאסֻ‏ÊְעןםֶׁÊסֳֽהווֳÿץֵָ”םÝכֻּֿ‎נםׁץÿֿ—ִÊבהֵ•ßּך־“׀ךדגסע׃ÿףֽ׃מ‎נס־ֵÞ–בֲןץÞ‏עםֵׁאץמ‎נס־ֵÞובֲןץÞ‏עםֵׁאץנ‎ÿםÝֶנׂמדמׂךדזßטÞו—ֳא‎ֳֿÿץֶׁאֳֻׂהזֳָֽגׂיפ“ßיה–ֽ‎ףזÞלפז׃ֵהז“מה–Þמדע׀מה–ןמדמ׀ךהז׃ֲהזßיהז׃ץהוָ‎נםÞמה–Êמאßֳֿא“ְכÿְִץÞז׃סÞז׃‏Þז׃נהז־מֻּֿ‎נםׁכעס“ֳןםֿצÊװ‎ג–ֶֻÿמְע•בּ‏נ’ק‎אסּמגס‘‎ÿם׃‎נֻÞִ•בּ‏נ“ׂ‏•׃ֵ•ץֻ‎אס‘‎ÿמׂ‏•׃סאֿ׳ִÞואֵ•’—מביׁ‎ֹץ”‏ÿםֻמאֻÝמאß׳‏•סִׂ•סּמןסׂ‎אסÞמןץָ‎פוףפע׀ְף”וֵֻ־ואֵ•’—מגß׳‏•סִׂ•עװמב‎ִֹֻי׳ֵ•“ְךפ“ßכ־ועֶאֻÝמאß׳‏•סִׂ•עְֶÿךְ‏•׀ֶנסּמאםֵֻא”כהוֵֿÊצְֶÿךְ‏נßÝֵÞוֳֿÊב׳ֵאב־ֵאעְֳ•ֻ—ֶהוֿמג‎ועפוֳֿדְֶָןץ—ִדָׁכ”יִֽÊֻ׀ֳןךִׂ•ֻװכÊÞ‎Þקץּßֳָןץ׀ט־ִׁ•יÞֶÿו—ִÞ’Ýֶנ׀ֵׂ”םֹכ—אףזודזאזִזו’זןמזֶצוֹזאְזֳזזְזדמזךזזßזדצזמזועזאְז‎צזְזגְז‎צוֻזאמזֵ׀זְזבזזְִוׁזאָז‎צוֽזןצזמזווזןעזֳזוָזאזְִוÝזה“זפזוֻזאעז‏ְוׁזהזזץצו“זןצזְִוֿזגמזֵ׀וװזאצזעְוֻזאִזֳצוװזאגזְִזÞזה“זךזז׀זדגזט׀וסזגװזס׀וטזדװזפזוֻזאעז‏ְוׁזה—זץצו“זןצזְִוֿזגמזֵ׀וװזאצזפזוֻזאעז‏ְוׁזה—זץצו“זןצזְִוֿזגמזֵ׀וװזאצזסְוֻזןמזִ׀ו׳זאזְֵזְזדמזכְז׀זדזזךצזזהזזֳזו—זא‏ז‏צו–זןצזֵ׀וָזאּזְֵו—זהזזלזו•זדגזכְז–זה“זךצז—זה—ז‏׀וֻזדזזךְז׳זהזזכצוװזהזזטזזְזה—זְִזְזדעזךזזְזה—זץ׀זְזדמזךזז׀זהזזכצו“זהזזךצז—זהזזכצוגזהזזֶזוֻזאמזְִזְזה—ז‎ְזְזא׀ז‏צו—זא“זמזז׃זןִזמזוןזהזזכצוÿזהזזכצוֽזהזזכצו‏זהזזמְז־זגְז‎צוֻזאמזֵ׀ז׃זגעזֲזו—זןמז‏צוהזאזֵזוּזג—ז‎צו׳זןמזמזוףזאגז‎זוֿזא“זף׀וּזאעז‎זזְזגעזְֲוֻזןמזֵצוֻזאּזְִוÝזאגז‎זוֿזא“זכְוֽזאזֵצוׁזאצז‎צוּזאעזְֲוֻזןמזכְוֽזאזֵצועזאְזֶצוÝזהזזץְוׁזא“זֳזזְזבךזֵ׀וÊזןצזֳ׀וֿזןמז‎צזְזאּזִ׀זְזא׀זֶצוֽזאעזְֵוÝזאעז‎זזְזןעזְֵוּזאעזְִזְזןצזֶזוֻזהזזע׀וםזג׀זמזוקזןזז‎צוׂזהזזץְוׁזא“זֳזזְזג׀זֶצוֽזאעזְֵוÝזאעזכזזְזב‏ז‎צוÞזןךזֶצוׁזא“זמזזßזה“זךצזׂזהזזסזוָזאּזִ׀זְזא׀זֶצוֽזאעזְֵוÝזאעזמזו׳זןךזמזוֽזאזִזו׳זאעז‎זזְזאמז‎צוװזאזֳ׀זװזהזז‏צוׂזאצזמזו׳זןךזמזוֿזא׀זִ׀וׁזהזז‏צו•זאגזֶצוװזאגז‏ְוװזאעזמזו”זאּזֳזוָזהזז‏צזְזג‏זצצוץזהזז‏צו—זדָזמזוָזןצזֳזו׀זדָזכ׀זׁזןךז‏׀וÞזאּזִזו—זןךזכְוÝזאּזֵזזׂזאזְִוֹזהזף׀ואזג׀זֶזו—זןצזִזז‘זהזכ׀וÝזאךזְִו׳זןזזֳזוÝזה“זִ׀ו׳זא׀זכְוׁזןמז‎׀זׁזגזץְוךזגְז‎צוֻזאמזֵ׀ובזןְזֳזוÞזאגזצְוׁזא׀ז‎זזזזזזהזזזזזזזזˆ’׀ז‎זזזזזזזזזזזזזזזזזזזזזזזזזזזזֳזזזזזוזזךזםזדםזךִז‏ְה׃זאךזױְהצזהעזםְוּזהִז‘צזָזאעזÞזדלזךװזלצזײזהװזכזדךזך—זÝְדקזה—זכְזׁזדזזךצוÊזדמז—זדץזאִז—׀הץזלזװזזÝזט—זיזז–זד‏וזְז”זדְז–זדסזאְז–ְז’זדָזט׀זזטװזקצגדזצצווצגאזצִוהזגםזצָזץזו׳זאװזֵזוײזא“זֵצהְזגעזץְוׁזגִז‘ְומזןזזְִוÝזןגזפצולזגװזףזדÿזןצזְֳו”זןעזףצוטזגזעזוץזןְזעְו’זןװזֱזו‘זלגזֱצהßזבךזְועזבעזסְהםזצװזס׀ו‏זן“זְזהוזןזנצוֶזבװזÿזדװזכָזÿצגךזצ—ודְגקזץזוגצגפזץךובזגסזץ‏וב׀ג‏זץּואְגֵזךזוןזגֳזץ“ון׀גְזפגומְגֽזפצוםצגÊזפִולזג׳זפָול׀גװזפ—וכְגׁזףזוךצגÞזףךויזג–זף‏וי׀ג“זףּוטְגזף׀וקצגזףוצזבוזעמוצ׀בגזעעוץְבןזעְופצבלזעװוףזביזע“וף׀בצזסגועְבףזסצזֹצהֲזסעוסְבÿזסְונצבֶזסװוÿזבֳזס“וÿ׀בְזנגו‏ְבֽזנצו‎צבÊזנִוֶזב׳זנָוֶ׀בװזנ—וְֵבׁזÿזוִצבÞזÿךוֳזב–זÿ‏וֳ׀ב“זÿּוְֲבזÿ׀וֱצבזÿוְזאוז‏מוְ׀אגז‏עוְֿאןז‏ְו־צאלז‏װוֽזאיז‏“וֽ׀אצז‎גוְּאףז‎צוֻצאנז‎ִוÊזא‎ז‎ָוÊ׀אִז‎—וְֹאֱזֶזוָצא־זֶךו׳זזףזוצזבצזנזוִזאזז‎זוָזא׀זִזֶעו׳ְאֹזְֶוײצאײזֶװוױזא׃זֶ“וױ׀א׀זֵגוװְאÝזֵצו׃צא•זִֵוׂזא’זֵָוׂ׀אזֵ—וְׁאˆזכ׀ו׀זןוזִמו׀׀ןגזִעוßְןןזְִוÞצןלזִװוÝזןיזִ“וÝ׀ןצזֳגו—ְןףזֳצו–צןנזֳִו•זן‎זֳָו•׀ןִזֳ—זדצזˆזךךזֿ׀זֳזזזײ׀זגזלךזוְזץזהמזְָזבזזָזןְזפזגמזÿְוְזד“זצזזכזז׀זװ׀הÞזוזו”ְה׳זלָזְׁהˆזךעז׃זה–זכ‏ז׃׀דגזֳו“זןֿזֲמו“׀ןּזֲעו’ְהגזכ—זו׀הבזם‏ז‏צה“זהזזמצזֱזלצז׀ד׀זזְזדְהףזבז‘זזֽזזּז־זהכזמָזְֿהדזגגו’׀ןָזֲּו‘ְןױזֲ׀וצןׂזֲזֽצדֲזיְזְֽודזיָז”צד‎זֱזוצןÞזֱךוזן–זֱ‏ו׀ן“זֱּוְןזֱ׀וˆצןזֱהזזמוזְמהז׀מגו”סֶׂףבבטעעבפÞ’ֵֿןצבע־’ֵֿןצאפÞ’ֵֿןצÞוּךִׂ”ך׀יְ‎גכֹיÝךד‏אץÞ’ÝִÝז•וּִׂ”ך׀יְ‎ץכֹיÝךד‏בֵאׂ‎”ךב‎Þ’ֵֿןצבֶÞ’ֵֿןצאֶÞ’ֵֿןצÞוÊמִׂ”ך׀יְ‎ֽכֹיÝךד‏א‎ה’ÝִÝז•וÊִִׂ”ך׀יְ‎ׁכֹיÝךד‏אִה’ÝִÝז•וֹגִׂ”ך׀יְ‎ֻכֹיÝךדִא‎Þ’ÝִÝז”ז•‎ֱ‎ְסÊÿ•‎ֱֶצסÊÿ•‎ֱֵזיÊÿ•׀אצפ’Ýֵני׀ה—בֿ‏”ס—‎פ’Ýֵני׀גגבֶֽÿםֳֽנ–Êֵאס“כֹי׃‏”זטצנץ׳‎ÿםִֻ•ֻÝכֹי׃‏”זכצנֳÞ‏ÿ‎ֻכֹי׃‏”זלצÿם׳ֵÊִִׂ•–ִֽז׃וֳאֻװ‎אעִׂ•–ִֽזֳוץפ’Ýֵני׀וּמִׂ•–ִֽז‎דכֹי׃‏”זיצ•יֻ‎אֻװֵאגִׂ•–ִֽז‎גכֹי׃‏”זמץÿץָכֹי׃‏”זאץפ’Ýֵני׀ה—סֿ‏”ס—‎פ’Ýֵני׀גגסֶֽÿםֳֽנ–Êֵאס“כֹי׃‏”זטץנץ׳‎ÿםִֻ•ֻÝכֹי׃‏”זכץנֳÞ‏ÿ‎ֻכֹי׃‏”זאץ־’Ýֵני׀וִִּׂ•–ִֽז‎מכֹי׃‏”זאפפ’Ýֵני׀ה—ֻֿ‏”ס—‎פ’Ýֵני׀גגֶֻֽÿםֳֽנ–Êֵאס“כֹי׃‏”זטפנץ׳‎ÿםִֻ•ֻÝכֹי׃‏”זכפנֳÞ‏ÿ‎ֻכֹי׃‏”זאפ־’Ýֵני׀וּװִׂ•–ִֽז‎ךכֹי׃‏”זאףפ’Ýֵני׀וּ“ִׂ•–ִֽז׃טֳאֻװ‎אעִׂ•–ִֽז‎קכֹי׃‏”זכף•בֳֽÿץֻכֹי׃‏”זצף•י׳ִÊי–ֵנ‎װ‎ÿְִׂ•–ִֽז’ק‎אִֻֻÊסÝֶÿךִׂ•–ִֽז׃ק‎”םֳֿÊעִׂ•–ִֽז׃קִ•ßִֿ•ְִׂ•–ִֽז׃קֳאֻװ‎אעִׂ•–ִֽז‎צכֹי׃‏”זלסאִֿׁÊ“ִׂ•–ִֽז‎ץכֹי׃‏”זאע־’Ýֵני