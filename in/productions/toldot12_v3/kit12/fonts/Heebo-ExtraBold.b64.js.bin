ה–ˆ—׳זזזזז׀וףˆװגצפֳזהגזכְז”זםץכװוֳצנגזףםוָכז׀מגךףזֵז׀עהמזגהזזעדפֿ׃זגÞצֶה׀ךהודג׀א׀ךבז־זוזְךבז—׳‎פזÿעבֿזמְזוזזצהזצץֹזזמהזבאז׀מזזה’כו׀גבוצוֱוְךהזזזׂזג׀ֵצוזזצזגזְגג‎׀זהזְיֳוְגדזÞ‎כו׀גבוצוֱזזזזכְוךנעזעכÞזזה”כÝ‏װלְזֿזהגֶכפממהוִױמפִאמÞמÊםֽע—יִֽ”ם־‏–יד‏•ךÝמנבֿעעוְִןבÝ‏–מץצןב׀זנבÝִ•יֽע—ם־ך־וֿעפיÞִןוֿעעבֽךדָףפ‎׃ָׁצִאֻ׃בגֳדסײס׀ִײ׃ִ‏ֻעÝ׀ÝגוהןˆןˆךֹּםÞצםףָׁךֲֽÝקךִףץגאך—ֿפּס–ֲּֿךיפÿףףמספפ“–ֱף“ִ•מךוי‎׃ײצ׀׀ךט־ִנםףזֱן־Ýלק•יגךעךלÝִßיְזזזזזוזדֹˆג׀צכוÿךזך׀זˆצד׀ֽמזמבז׀ּאזְזהזָּזוזעווצצוְֱזוזְעוזֹ׀זז׀זבוזךב‎׀זהזזזהס׀זהזְוֳזזזהזג—ֽבו־בץִאהוָױזו‏נבץצאוßעֽיפ“היפגעבֽךÞיֽע—ם־‏ֹכְמ–יד‏•יÝעÝבץ‏נבפג—ם־‏ֽמְ‏אבץצנבִֿה’בֱÝכלְֳװי”זףִֹֻֻואם–ßצֹױֳ‏‎כםÞָכןץˆװְײעדע—ץÞךÊסּװהײ•אסֵ׳ל׀גֲןֿה–ײֲֹסֿטצפּֽיהּפםסÊמֶ–‘ÿÿזױ‏”וֶ‘ֻÞצˆם־גßאץװםץמזזזגזפקˆ׀זמגָצז׳זביזעוְווְע‎זצצאזְגכזצךוזזװגפְזבזז‏גוצ‎ֹו׀גגהזגדזְצד‎צּוזְָוזצװהזנעךזצװכזבזזזזׂזג׀זזזז׳זהְÊםפצֽגץמֻמßגץגץךֻדצְֳלÞצ•יßִאו־ך־ם־‏ֹמÝעÝיפך–ךÝ“הךÝמנב׀ִÊם־ך־וְִֿבפגסמץעֿבֿ‏Ýזßֳפצֿ‏‎ֽÞי•‏ִסÊ‏קÊץֶן–“׀ˆ‎ף—נטבָ’עאזףזסףְֹב־ˆײװע‏בכװדז”גזִײ”ֶÞץֵיװס“צגִׁצדעֿאװ—נÞצעזזזזזוזגצזזזץפום—זמְו׀׃זךוהזבםפזטעבֿזםצזגוצמבוןזזז׀זבוזךב‎׀‏וזְִוזצְהזנעםזצְמזב—זזזזÊזג׀ֵצה‏זוזעהוצצהְֱזדזזעגז׀סֹוְגהו׀גוהזמו‎צּוהזְזÿצזזזה‏זףבֻזגצזזזהמזמֿגסמֿךּגץעץהְְִלÞעסמףעÝיֽ‏–מÝעÝםÞ‏•יֽךÞבֿ‏סמףצÊמÞמאבץצÿבÞגסמצ‏ןובכטצָ׃םללֳזְץÊß‏ֶצßÊכß—זטֽווזבÊˆײגןÿׁÝˆז׃’סיטֽװßױֶכ•זנ–בֶסץךלףױטונְזוזז‏זזזטּומ—זאזזצדװנזצזםד׀צהזְגהפְָוהצזםְ׀ְוזזִוזצמזזנ‏אזצמבזצךגזְיֻזזצגםְץךאוִסבוגפגץגץגץמץגזװמןפװוךßעֽוßעֿבפגסמףעֿיפג–םÞך–ך׀ךֿגßךֿזװׂ׃ßצוהˆ–ˆװֽְגלדֱ•Ý•זבא־‏ְוץ׀לדװÞעװ׃ֵׁװ־ךְװ׀מלˆֻ“וְָזוזדצהמ׀צֶוכ‏זו׀זֲצוװהזצזזזצזו‏ְצוז׀ךÿז—׀זזזזןזזִץגץגבוßִױזץגֿגפגץמץגהׂצבֿˆוָו‏זפ•ˆֹױ׀גיז‏‏זזזזוˆןּגÞק‘טוְזזז׀זÊװצ‎ּץגזֵזזזוזצוסזזזזזס—הזצגזזע—זזזזדזזךץז׀ְסלגאזגצוזפגףˆ‎ד‘צבטß׀ףמזףֽÞזזזזזזוˆסמגÞקֻוְזזז׀זֹװצ‎ּץגזִזְגוזזזוסצמוזצגזÿצזזזצויזזזזז׀זדגצךמבפׂßוְוגז׀גֽג’ׁ‘ׁ”גוְדÞזג“זזןנזףּˆ–ךאוצזֵזה‘ßוÊץגצהךזוזגזובִבזצךזזצזדזנִזוזצז‏זמוזזצזעומּמßמּמְ‏מא־ׂßוְוגזְ‏אמÞמÊםÞ‏ÊמÞמאבפִ—יֽ‏Ýךֿ‏ÿבֿ‏Ýךֽ‏–ב‘—ֶּגױצ־ָֹיפגֽכֵגֶגגּקפָקהזּכזבװÿßלבß‏עגÞװהֳּפßענבוע׀כזװזזזזוזאזגÞזם—וְזזז׀זֹװצ‎ּץגזִזְגוזזזוסצמוזצגזÿצזזזצויזזזזז׀זדגצך