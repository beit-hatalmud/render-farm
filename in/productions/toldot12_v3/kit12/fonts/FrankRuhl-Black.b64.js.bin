לנהה׀עבו‏מֵוזנץװְװדֿצנהא׀טבֻ‎מכגוהּיב‏—סֿ‎כזָעבְֿװצגלצ—סֽץפה׀ךבו‏מֵז׀נץװְװךוצנהוÊממײל‏פה׀הֻו‏‏וװְװהוצנהא׀הÊזֵמכז•עבְֿװד‎ְא•ו‎נסֵּװזגױנסּֽװזוצנאס‎נפ•׀זÞ׀ְץפה׀והסֿ‎הה׀ועיצנכזבמ—ל׀ו־יהאÞגֿנֵזו‏ה•׀וה׀ֽמפךֿמאפßונםהמכזאמ—ל׀וּס‏אגוהּיב‏גוהּט׀ואוב‏זדל־גְװז‎דממְָ־ױזולג׀ופנ׀וה‎ץנאוצא•בפנסְֽנפב‎מכוזע–־׀זפװֵמֵוזנפט׀זבו‏‎סּ׃װזעװװזֳדלמזזְוד‏גמ׃װז‏װװזִֽצ־ךְװזזֽצÊא׀זÊםÊװזבֽװזבְװזעײכֵזןכהזְץפה׀ה—יֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זניְץכזו‏ה•׀ההÞÞו׀װזצ—סהל־אÞזזגזצ•והכֵזםככזזצÞיגװְזוזגיְצ־•׀ה־׀ְמגעְװזגױמזזצזגםנזְץ‏ָֽ‏פוּמכזְעבְֿװזזֵװדוצנכזְאוזנסּֽװזוצנאס‎װזךֻמ•בגץכזו‏ה•׀הÞ׀ְמגעְװזגױמזזצזגםנזְץ‏ָֽ‏פוּװהץצנכזזאוזנפט׀זבו‏‎סÊ׀זÞעֽ‏עץגװזבְכֵזךכהה׀זהיהװְװלז—ס‏מץװֽמסּײמפ•׀דפÞßזְםבװאץֿץה•׀ד־Þ׀זנזְמכזךצ—ײ׀זבו‏מכזךמ—ם‎װז–דפױזזעְְֻװז—ֽצֻּ׃װזװמכזצ‏Êֶ׀זנךְׂזצז‏“ָֽ‏ֵזטצ•זְ־Êזְװז“ֽצ־ך׃װוזװפ–ץ‏װצץּץבּּװז–ֻמ”ְ׃װוגװפ–ב‏פ–י‏װצץּץבֵּמסּּװויֻמ”ְ׃װומװװצזקצ–ס‏װצקצזו‏על׀דÞ׃‎װזודװזמֻצױגךז־סהװצ—הםעל׀זץ‏ֽמכזדםסו‏װצגזצ•ה׀והסה־ְָָ־־יֿװז“ײמפט׀זנגְ־־יֿװז“ײמץׂßזצוד‏כזהםעל׀ז־סֿװז“ײמסÊ׀דגיןװז–דץ•ה׀זÊמְװזוצנכוז‏בֻÊװזבֽמכזכצ•ט“וזו־מכזזעב־׀צאו‎‎ױזו‏•הßזזזףמ—פ׀זעט׀זד‘Þזצגוצ•והכֵזףכזהßזזםבסב־׀דÞיהמגנ׀הÞיהװזָֽװזץְצ־וְװזבֿ׃ץגץזצזטזגםה־Êהßגְ‏ױװמּױאÞם‎כֵזעככגזגÞװ׃װועװװצגףלÞ•׀ב־ÞßזֿךױכֵזÿככגדגÞװ׃װוְװװצצףלÞ•׀אפÞßוץךױכֵזֶככגאגÞװ׃װוװװװצִףלÞ•׀ןהÞßהוךױכֵזֳככגםגÞװ׃װהּװמÞה׀גאםÊװזבֽװז‎ְפ–ץ‏מÞזׂװזבֳאÞגֿנפ•׀ל־׀ֽמכזצ‏Êֶ׀זנט׀בÊוכסבְֽמה‘׀זÿגֵמפב‎כֵזױכהךְװוו־‎ױזו‏זÊ‏ג׃ענהךְכױזוִֿװֿמסּ׃װו“װזכזילגזזּסענכזקמ—מְץֵזכמ—ל׀ה־ט׀ואוהמאה׀זנא–גץגוזז“זצּלל‏כגפו־ׂ׀־פװֵמֻּ׃װוװװצזֲלÞ•׀מהÞßזץ“ױכֵזֿככגהן־װ׃װהמװװצךֲלÞ•׀מÞÞßוו“ױכֵזּככגבן־װ׃װהעװװצ‏ֲלÞ•׀ם־Þßוß“ױכֵזֹככגמן־װ׃װהְװװצֲּלÞ•׀כה׀ְקכזו‏ה•׀כפ׀ְ‏כזץ‏הודמזו‏גט׀ז־סֿװזבְװה׀ײמפ•׀כ־Þ׀כפׂ׀כפָ׃װהװמהוןמהה׀ה—יֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זניְמ•ג“מÞהלססְְץÞזְװז׃ד‏ְגזאמְװזוצנכוז‏בֻÊװזבֽ‏היֿטוװֿנפ•׀ךה׀זװצזהץסץ‏װזגנװהײװצעובעס‏ךבֵּמֻּ׃װדגװזכזילגזזּסענכזובױזׁלױגבזץסבנדו‎אÞם‎כֵזÞכהז–װזבְכֵזÝכזה׀זעסֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זנט׀זפׂ׀ה—יֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זנט׀זפׂ׀זוֶ—זזזזזזוגק־ך“װףמובפָֿכֵז—כהזמגְִװז׃ד‏ְגזאמְװזוצנכוז‏בֻÊװזבֽ‏כזזצ•ג“כֵז–כה“ÿקה•׀י־׀ְקהוןמכזכצ•ט“וזו־מכזזעב־׀צאו‎‎ױזו‏•ה׀זגיֿװזבד‏Ýְ׃װדִװװצמזב־עְכ־וןװזזֽצױזהםעÊל־ִּֽץÞיֿמבֿ־אÞב‎װזגֽצױמ•זצגסבהָ׃װדְװװזזנװוזֽצױזגםֵזגםעִֽץÞיֿװזֻדל•נלכ־ךְמדÞלטה•׀טפÞ׀זוֶ׀גהיהװזצֻװזצֻמה’ןמ—ִֽ‏פה׀והיהװזֻדלÞה׀‏בו‏מכוזעס־Ýז־זדמוׂÝז־‏דאֻֻהצ־ךְװזֿדממָֽץÞיןמ•גֽץÊה׀וגט׀זÊמְװזוצנכוז‏בֻÊװזבֽ‏הה׀זפװְ־ָ׳ֿמכזהצ•וּמזדצ•בּעב־׀זּיֿאזדצ•ו‎װזךֻװזם־מכזזעב־׀צאו‎‎ױזו‏•גֽמהה׀וה‏ֽץÊג“אÞט׀הגיאװזמֻװזֿדץÞיןמ•בְמכזגצזה‏־ה׀זבו‏װגוְננֶ׀זניְמÞה׀זפװֽװזץד‏כזולזבםנא׀ופנ׀זÊמְװזוצנכוז‏בֻÊװזבֽװזצÊ‏פה׀והסְ‎הט׀זÞסְ‎בו‏מץװֽמסּֽמהה׀וה‏ֽץÊג“נפ•׀ט־Þ׀זוֶ׀גהיהמהזְװזעÊמה’ןמ—ִֽ‏פךטה•׀טÞÞ׀זוֶ׀גהיהמכזממ—מְמהואמ—ֲ׀זפװֽ‏ףְ׃װד׀װװזזנװוזֽצױזדםֵזהםעִֽץÞיֿװזוענה“ְקהךֿאזהםֵזהםעִֽץÞיֿמכזבםֵזגםעִֽץÞיֿװז‏ֻװזעֻפֵזהםנא’הזזמזאיֽמÞו‏‏ֿװֿננט“וזו־מכזזעב־׀צאו‎‎ױזו‏•זֽכ־ךְמדÞלטהךֿנפ•׀קפÞ׀זוֶ׀גהיהמכזמצÞזׂץÞיןמ•גְ‏כזְ‏אֶ׀זÊמְװזוצנכוז‏בֻÊװזבֽמÞזְקמָ“כֵזכהךְכֶּ׀ז־סאװוודנבזֵעֻֻ‏מדß‎כױגׂזץצױכֵזˆכהךְכֶּ׀ז־סאװוודנבמֵעבֻ‏מדß‎כױגׂזץצױכֵוזכהךְכֶּ׀ז־סאװוודנבזֵעֻֻ‏מדß‎מÞזׂץױזהםעֶ׀גגי‏עֿ׃צנסְְקבּׂװפ“ובהװ׃װגגװװדְױמÞזׂץױזהםעֶ׀גגי‏עו׃פנסְְקבּׂװפ“ובהװ׃װגמװװדּױ־־זְקכזגמ—ללטהךְכֶּ׀ז־סאװוודנבזֵעֻֻ‏מדß‎כױגׂזץצױװזץדכױזׂלÞ•׀צÞÞ׀זוֶ׀והנ׀וה‏ְכִּֽץÞיֿװזֻדלÞךְקהזׂמÝ־ßכְגעלÞ•׀ץהÞßהזצֻצױזזבױזגםֵזגםפזׂץÞיןמ•גְװזצֽצױזםצÞװְװאוצנהה׀צבב‏װ׀מְזÞזֵװ׀מÊזß׳‎צּמֽמגֲ׀וגט׀זÊמְװזוצנכוז‏בֻÊװזבֽ‏הה׀זפװְ־ָ׳ֿמכזהצ•וּמזדצ•בּעב־׀זּיֿאזדצ•ו‎װזךֻװזם־מכזזעב־׀צאו‎‎ױזו‏•א׀ז־סא‏ףְֽמד׀ֽטוװֿמהואמ—ֲ׀זפװֽ‏ףְֿנֵגׂזץצױכֵובככגזטהװׂװפ“ובהװ׃װג‏װװצז’לÞגֽמהזװזצֽצ־ך“װפ“ובהׂ׀וגךׂװה“ױכֵוןככזזבפוןװזזֽצױמזזצגסבוךׂװדצײכֵומככזזבפוןװזזֽצױמזזצגסבוךׂװדצײכֵוםככגזזץצףװדעײכֵולככז”ל־•׀פÞÞ׀זו‎במÞזׂמגֶלמ•ג“װפ“ובהװ׃װג׀װװזְֽצױוכלÞ•׀ףפÞÞזזוגלÞ•׀ף־ÞÞזזבגלÞ•׀ףÞÞÞזצוגלÞ•׀עהÞÞזצבגלÞ•׀עפÞÞזזובלÞ•׀ע־ÞÞזזבבלÞ•׀עÞÞÞזצובלÞ•׀סהÞÞזצבבלÞ•׀ספÞÝזזזזצפװ׃װב‏װװ׀זוזגגױכֵוÿככךוזזוולÞ•׀נהÞÝזצגזצפװ׃װבּװװ׀זזזעגױכֵוֶככךזזצבולÞ•׀נÞÞÝזצזוצפװ׃װב׀װװ׀גוזעגױכֵוֳככמזזגךױכֵוֲככמזזעךױכֵוֱככמוזגךױכֵוְככמוזעךױכֵוֿככמזזג‏ױכֵו־ככמזזע‏ױכֵוֽככמוזג‏ױכֵוּככמוזע‏ױכֵוֻככךזזזוהלÞ•׀‎־ÞÝזזגזצ־װ׃װאִװװ׀גזזגמױכֵוָככךוזצוהלÞ•׀ֶפÞÝזזזוצ־װ׃װאָװװ׀זוזעמױכֵוױככךוזזבהלÞ•׀ֵהÞÝזצגוצ־װ׃װא—װװצז‘לÞ‘ßכְגעלÞ•׀ֵ־Þßזדָױװד“ױכֵוׁככגזט־ׂ׀קÞװ׃װןזװװזזנװצז‘לוזלÞ•׀ִפÞßזףָױװד“ױכֵוÞככגוט־ׂ׀קÞװ׃װןךװװזזנװצג‘לוזלÞ•׀ֳהÞßזדװױכױגׂזץצױכֵו–ככגזטÞׂ׀ק־װ׃װן‏װװצזלזˆלÞ•׀ֳÞÞßזדװױװגזױכֵו“ככגוטÞׂ׀ק־װ׃װןּװװצגלזˆלÞ•׀ֲ־Þßזףװױװגזױכֵוככגזקהװׂװפ“ובהװ׃װן׀װװצזלזלÞ•׀ֱפÞßזד׀ױװדױכֵוככגזקהׂ׀צהװ׃װןװװצגלזלÞ•׀ְהÞßזף׀ױװדױכֵהוככגוקהׂ׀צהװ׃װממװװצזלÞ‘ßכְגעלÞ•׀ְÞÞßזד—ױװד“ױכֵהגככגזקפׂ׀קÞװ׃װמעװװצזלוזלÞ•׀ֿ־Þßזף—ױװד“ױכֵהןככגוקפׂ׀קÞװ׃װמְװװצגלוזלÞ•׀־פÞÝהצצהז—ס‏מץװֽמסֻהלזמ‎ֵזדםבו“װצעובעס‏ךבּ׃זזזזזגׂ׀Þבם‏װצגוֻֽÊ‘זזגמזזְז‏”הßזזֳה׃סֻבךצזגזהײßזזֳהצז׳ךהדְמםזְסוְצמלױגזו—םזהֻ‏אצְ‏ׂוֿ—דוזְײװצזכצױװףצז’זהעזבְכגגהפײßזזה׃עוזצמזגהפײßז׀וגװפצו־בב‏װגהמנכגד‎גפßםְאמעס־‘המזזזצץז־איענכגדזגץ‎נסֻ‎צז׳טהדָמםְְ‏וצצךלױְוˆ“נ׀ומ•ßזְוגװ׀סּוְוגץזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזד׀זקזה“זכְז’׀מÊזזדˆ‏זקָˆÝְהםׁˆ—ˆ•זד‘ק“זלִז׳׀זְזהזהֻזזזזױמו–ְזזˆÝְד‘ק“זײדˆזלזֲכˆקװזֽˆטזהֹזלִזמזזְז‎עזזזלÞזֳ‏זזק“זֽˆטזאסˆˆ׀הׁצן־ˆˆףˆטזקָˆÝְז׳׀הֹזהזזמזלעזצהװְןנזזדˆטזקָˆÝְהֹ׀גכזױ—ו“ׁˆ—ˆÞ׀ד‘ק“זזזזאצז‎זאָזְֲהלזםָזײְה‘זפ—וקצביזֽגהױְךדזßךדמ׀צזוגִגָצפßוכּב‏׀סÝו‏ךבּ׀נֽוֵךב׀׀ÿףוױמןפצֱֻוˆעןˆצֽֿהםָמײְ־‘הךָמ•ְֽײהעִםָ׀ָטהָֿלִזײזהָ׀לÊזװדה”װכßְׁנה‏כְ׀הדד—ךףצßֳדא—ךֱצÞידטִך׀”עד־עטְזÊד–צק‎ז—ד“זצךֿוהגבמץװץאגֿזפמוכ־גׂ“ףטßיכג–װףֶßיג“װףֻßטֹג‏עףֿפ‘בץךסמßעÝבעךסעßנױבֵװסÞßÿֵבּ‏נעֿ‎ֲבÊָנֳֶֿהבָ—ÿאץִֻבÝגÿÞץְ׳אןָ‏ֿץ־ץאף׀‎ָץֹˆאְװֱֶßױםא׃עֶ“ץױ׃אֵּׁוץװץאß׀ֵלוׂגןאְִִß”ÿןֽעֲֿץ‘’ןװעֲ—ץֳןֲּׂץֹןזְקÞוכמןְֽÞהֵמלְִ‘־בßמֳזֿ•ÞןֹמֱךֿˆÞמ‘מּ‏־ע־םֲמÊָ־ֳפכץמ׃—ֽעÞקוםה—ּֿ־ף•םצגֻדהע‏םֶֻּ׃הÿזםׂÊÞֲֿםְֹה־נללמָפּולצ—׳אפֻּלףז׳׳פÊßלֲײקהײ־לÞעױךפװל—ּױספׁהל—ױ•פֻׁכן—װ“פ–לכ‏צ׃Þפ”סכֲג׃פ’‘כÞְׁÞˆעךדג׀װףדÞךק—ßעףאˆךּװÞּףכÊךÝװÝײÝקיןְ—”דעְיÿ‏–דֶÿיÞ”ֽ־Þטעע’ÊדָÝטָגףׁמקה‏ײדÝקÿזׁÝ“ףקֹצְד‘כקײג׃ֽהקװ“ˆ׳ד–ק‎זצּועצאסזֳּהמצםֳזײגה‘צךßז”ּדׁצצבוג—גֻצף‎ופגב‎צנ׃וֱעאמצ‎יוֹּא׳צÊßה•—ךִצ—’ד׀—צץמץגגעץ‎יבˆ—‎ֿץײßא”ֳּײץˆ’מץעּצפסם׃עָÞפײֳלּװּפ‘ךץגÞךףפ׳יֲ—”קףֽ׳טװע‘’ףװבטÞעץף׃ֻט“ע׳ףׁבטעוף׀ֻקגע‎ףÞבקלעßףÝֻקצעםף–בקִֻוץעצסץ–מ‘עÊ–פ––יָע‘עעבפ–סצ׃סֵֻÿטסְ’נצסֶװס–׃ÿ׃–ֿ‏נלֻ‎זבֻֽנֳֶֿÿס׳נײיֶ•סװענÝ׃ֵֿ–ׁזנˆ’ִעֻß—ÿיֳֳצב•יÿֵßֲזס“־ÿֽֲףב’‎ÿײיֲ‘ֻםÿÞֱֿעֻ“ÿ“ץֱּבִÿ‘ֱֿ׃בˆזÿֱֻÊזכ‏וְֳמ•זׁ‏א–ְױאדֳ‏צ’ֿענאִ‏ֲב־דנמ•‏ֻ–־ֶנם–‏ָב־ֽנלֽ‏׃’ֽוÊים‏•ֱֳֽנקֱ‎ג‎ּÝאע‘‎ִ‎Êיאֶ’‎”׳ָוא־זֶך׃׳דÊֻ‏ֶÿß׳ּÊÊִֶֿׂײהנֱֶָֽßײÿנױלֶ׃׳ײÊװֵֶ–ױ—אßֵָמװß•Ýְֵצֻ׃ם•—ֵני׃ˆ•‘םֵױ׳ׁעאˆ–ִםץ׀ןג‘ִ‏וßׂ”ןֳִּ‎ÞןךÝִ–ßÝֱ”טִֿס—זÿצֳֽגס—ֲÿפֳץֻ–י”ס׳ֳֳו•הֹ‏ֳָּם•‎ןֶÿֳױֿ”ןֳִֹֹÝו”טÿֳהֳ—׃”ֶןֳßֳ”׳”ְ”ֱֲֶבֻ“‘ֹÊÿֲִו’ˆֹ׳ףֲÊ‘ׂÿױ־ֲ׀׃‎ןׂיֲ’ßׂÿׁ־ֱז׃סזזהזמװזזזםˆזֹגזז׀זןזז־–וצצהזזמ׀לßךֿגפגֻגפגץ־׀ן—ˆְ׀ו’ק“ױזֹןֽßזהעֱ•ׁזזמזהצזזז׃מהֻזזֳזהגזט—ז“ן׀גמו׀ּוזזךהפְּוהזזדזזְד‎צזןוÞ‎כוְצהז׀זזזס—בזצגום׀בךןֿ“ֲמץ“ֿבוגץםוצֿגץמלהו׀ױםו‏נךßעֿיףךÞיףצֹםÞךןוֿעעךÝךסמÝעÞיֽ‏”גÝךףםÞִֽו׀לידֳָֿˆװזßא׀ע’Ýףָגן־ֵצןֿסהׂץֹ–קםÿז–ִ‘ג׀‏ֿמץעמד‎Êִה׀ְעמפגןבßּהקק•ˆׂטׁױˆˆזהצזזז׃מד׳זז־זזמזזזגןזֳמה‏׀הזזֶÝזְאךÞׁˆˆ׀זםזזזה—ְיÞזהמזזְזזזצִו–׀ם׳זכ“זוױךהזֵ“Ýלˆˆˆזזּזזזכפז”זמְזהזזזוו׀ןסזÊ׀זְׁזאװ׀מוֽׁךױˆˆזהצזזז׃מדִצז־זזמזזזגןזִהֱזהזזֶÝזְלךÞׁˆˆ׀זםזזזה—ְטֿזהמזזְזזזצִו—צםנזכ“זוױךהזֵ“Ýל׀זהזזֹˆךזכפז׳צזךזז—זבוזףףמוה׀ְנזצךגהצְהזזמדפְ׀וה׀זגז׀װג‎צזמהה‎כהצִבז׀ךדזֻ—לוְמהז־ֳכזזזזזסזזצגÝזע׀ßךףג—ךףצ׀כÞ“׃בוגץםוצֿבפצּדצְֳל׀צאבץצנךÝמ•יßִאמÞמÊיףצ•יÞך–ךÝמ–יהִֹמ׀ִאבץצÝךßעֽיףמ•יִֽףךßךֲזֽךסמ׀ךֹמ׀ִה‎Þֶבְעהß‏ָפÝזׁצÝֹגךץװבטִ—‘וו“Ê—ו“ֱבצױּ‎צםדֳָֿץֱ׃ÿז–ִעכÞג‏אז׀קגּעßמפָ“ןהגסהז•‎ֹזװמבהגֿוßִ‎זֽÝׁßּףו־גוהׁױˆˆזהצזזז׃מדּ׀ז־זזמזזזגןזְֳו׀הזזֶÝזְלךÞׁˆˆ׀זםזזזה—ְי׃זהמזזְזזזצִו•צםֻזכ“זוױךהזֵ“Ýל׀זהזזּזזזטבז׳צזק׀ודזץה–צצגמוְבלפזםעבֿזץזזמוְװאהןזץזצךזצגקִזזלזז—ההְ–ֻגְגצזזמךגזםֻהצגאוְֳֳזזִןםּװזדז׀כÿצזכהÞֻכדְעדז׀גוזב“גזצזזם׀וךא—ׂ׀ם–ו‏צג‏זהז‏כוְְכֱֿגוד׀׀ודזוְֱזלזז—ההְ–ֻגְגצזזמךגזםֻהצגאוְֳֳזזִןםּװזדז׀כÿצזכהÞֻכדְעדז׀גוזב“גזצזזם׀וךא—וגזזְאה׀‏מה”“ץזצךזצ׀קזÿ“זהְזיזְָי‎ץמוגזזהדוזה‎צזכזז׀קה׀ßֻהצגאוְֳֳזזִןםּװטוצךדזצגזÿְצוזזזֹזגß‎נעזּצגזזזגודצגךזק׀זˆקדָ•ידג׀כÞ“ױלפ‏ֽגץגֹגץגּבוגץג׀ְֳלÞעןמףעÞיֽ‏–יפךןוֿעעךÝךסמÝעÞיֽ‏”גÝ‏–יהךֽיפגסמÞ“המÞך־וֿעסךÝמ•יִֽÝבפךׂז־ךֽבץצנבֽךÞיֽ‏”םףעֽו׀טבדק”ׁמו׀םּ‏גאמהֶמו“נדׁ‏ימפ׀הף־ּימÝִ׀ךץצץ‏ßװִדְעֿמצצקןו׃ֽה־עױידײדק’ץוÿ־ׂױ־גמבֿױֹז׀מגÞגֿוß‏ֶזֳִÿגֿװֹֿףךÝגְף“זֹםׂגֹלזˆֱןץָכבדװ‘ֲֵׂÊזזזדזהגזזזםז׳צזב׀זֿזהװזֲױעץזצ‏גזע׳כװה–צנגזֿהזגגזז‏זוז‎ֹוצגוזצםֳזזמהםּװםו׀מזזזיֳזזךדם׀יךא—ז׃זזגהוצעוִזזזו׀ךןזןזמזצצזוְִגוÊִזוצעהÿְזהז־‎כהצגןו׀יֳזזךדם׀יךנעזÿמ־מ‎אהמױמ־ָֹםץ—ֵאהג‎מפּֿבßזלהוְױיÝמ•יֽעץיה‏ÊמÝעֿךֿ‏סבז‏ןבץ‏סבהגֿזףמ–יהך־וְ‏סבץמ–יה‏ֽמßעעבֽךֿןֿ—להץװֿזעיֱ—’ך׃ׁ—ˆױמון”׃‘בßמאּֿׂהךו׀Êמצּÿאזןְןוִןמע–כט—׀צזפהףװצבÝְןװבגוקףˆױטלפ–ןÊםץװזזצז־ˆˆצהֿצלְזהמזצעזןß“הוצךופְזווזךגזציזזצגזבזזזזׂפ׀זדז׀םֳזזמהםּװזוצעאÿ׀ִווְ‏ׁוּ׀זזזז־זהגּמֿגףמÞעמהוָױב־‏–יד‏•ךÝמנבß‏Ýךֽ‏”יÝךÿמÞ‏ÊמÞמאבץצנךÝמ•יßִאו־קֵׂסנֱֵדיוןßִכהצדזß—לםְ’ֽפÿםף‎נםםֶוְֲןֹßßדלÞֵֽ׳–פד׀׀להזְםׁע’ֶ׀ÿ־י׳בםגדבם‎זקˆˆזהכˆזלבז‘צזמְזיזזזוו׀ןְזם‏זְׁזאװ׀גוֽׁךױˆˆזמׁˆ—זָעדֱ׀ז־זז—זזזגןזֳ‏הפצהזזֶÝזצאךÞװזזצז־ˆÝעהֿצלְזד“והעזִטÝָההצִֵזצָםזְגדזז“וזְךיזצגהועֶָזצךופעׂ׀ה–ו‏צדזוצְןהזעןְֱזזהְךהזןזזז׀מלז•“זהזְגÿ׀זגוה’כזזִןוֻ—זוְ‏Êפ׀זםהצ׳ֱה׀גלה־כזזמהזנזזזצגױזע׀ֵפזצעבֿזצזזבהזִמוצֳזזזלז׀ָזז”“זז׀מלז•“זהזְגÿ׀זגוה’כזזִןוֻ—זוְ‏Êפ׀זםהצ׳ֱה׀גלה־כזזמהזנזזזצגױזע׀ֵצגגזוצְןהזעןְֱזזהְךלזזיזזךההְךהֱזזמהזץֱזזצגכּװזו׀ִאÿצזאו־‎כזזּםהֻכזצָלכ—װזזְמו‏זזוזפװוףבֻ‎צוצזזזזזד—“י־מץגÞךײםהךּםז׀מןפװגם׀ִ•יֽךÞבֿעעו־ך־םÝִנךÝמ•יףצÊמÞמאוÞִ”ם־‏–יד‏•ךÝמנבß‏Ýךֽ‏”יÝךÿמÞ‏ÊמÞמאבץצנךÝמ•יßִאו־ךוֶצּעוßִךןÞßציְֽֽג־מÿגß—פגצָיזץגְָ׳יסֹ•׀Ýצץÿה׀ּקז׀ךֳה־‏ט‏—ֻÞע•ס־פנְ‏ןֿ’ִצ׀וכְמדמÞז׃ם׀Êדßךעגוךןזצֿףגײ־ץֵ׳–פד׀׀להזְםׁע’ֶ׀ÿ־י׳בםגדבם‎זזמזמצזזז׃‏הֻזזפזהזזלעזÊוזגוזצםֳזזמהםּװאוצמזזזיֳזזךדם׀יךגßךףמוךֱםפצֿבßזןהוּױיÝמ•יֽעץיה‏ÊמÝעֿבֿ‏סבז‏ֽמפצ•יףצÊמÞמאבץגעבֿ‏Ýמפֲּהזֱָםְבצװֵףא׀קץז‎–ֽ‎אמֻאְװÿבÞגןבץ׀ו“ץװנההגהֹלטÞָפנץÊָצדוױבßָ‎הזזהזהגזזזכ׳ז׳צזבְזָזגוזקצִוז׀ְוזְגדזÊעאזצצגוס—לזצעבםּװכהצמוזצוֳזזזזם׀וךבßִזזוִָבÞִֽמ־גְןץװזבְזסבוגעגפצךהוּױזו‏סבז‏ֽמףעÞיֽ‏–יפך–ךÝע—ם־‏ֽיפגפיֽע—ם־ך־וֿעסךßעֽבץצנבֽךהיֵףא׀קץלץ“מ‏ÊמלןÞ‏ועג–ֽ‎אמֻאָאוהßִÿז׳לִָלֿמצִסןיּÝוװנההןּ‎אֶֽ’זךא׃װ—ָֿ‎הקˆˆזהגזזזכנז”זמְזץזזזוו׀ןנזָֹזְׁזאװ׀מוֽׁךױˆˆזמצזזזּׂהֻזזהזומזזזזוזהגזזזםפז׳צזכ׀דצפזםעבֿזי׀זדזצ‏וז”זזהְִזזז׳׀זזעזהזִבהאעגזצגוזֻ—זזְמÊפ׀זןו׀‎ֳזז‏אלעװםזצזזה–“זה׀װֹה—׀ֵפז׃עבֿזטצזדזצ‏וז׀‎זזָןזזִלזן“זוצזמו׀עמ‎צצוזצגהÿצזהז־‎כזזִןוֻ—זוְ‏׳פ׀ּוזזזכÿְזכהÞִכףו׃זי׀זדזצ‏וז׀‎זזָןזזִלזן“זוצזמו׀עמ‎צזאזזִלוְֳֻוזגוזצםֳזזמהםּװםזצזזה–“זה׀װֹה—ß‎נעזפכÞ“׃כהֹּמßגףמÝךץגץִצדזְֳלÝִÞיֽ‏–גףצÊם־ך–מץעֽכְמֽמÞמאבץעÝךֽ‏•יÝךסמÞ“המÞךסבו‏נךÝמ•יִֽÝוÞגֿמו׀םהץ׀ְזֿװ׳דפך”ךגעעגÿִֵןז“במפגגדß׀ֳֵ׀װ׳ךףץבכְװ׳דק”ֵמצְנאְןֿאִֿממ‎—Ýךßמקג“קם־ֱֻלהִט”ו‎הֿ‏י‘ˆˆ׀זֿזזזהעְטּזהמזבצזזזצִו—ְמ–זכ“זוױךוזֵ“Ýלˆˆˆזהגזזזםפז”זמְזסזזזוו׀ןנזֽ׀זְׁזאװ׀גוֽׁךױˆˆזמצזזזֻמדֱ׀ז־זועזזזגןזֳעהקְהזזֶÝזצאךÞׁˆˆ׀זֿזזזהעְיßזהמזבצזזזצִוÝ׀םטזכ“זוױךוזױ“Ýלˆˆˆזהגזזזםפז”גזמְזסזזזוו׀ןצזְֲזְׁזאװ׀גוֽׁךױˆˆזמצזזזֻמדָצז־זועזזזגןזֳגהלזהזזֶÝזצאךÞׁˆˆ׀זֿזזזהעְיפזהמזבצזזזצִו‘צהמזכ“זוױךוזֵ“Ýל׀זוזהןˆךזםפז׳צזצְגם׃ְּמזְזהזע׳כװזֻצנגואזז‏גהצצאִזזמזזװלהז׃ֻו׀גגוזסֳזזעבםּװזהְָםÿצזםהפֻכזז—יזֻ—טזצמהם—װךזצךדזֻ—טזצמהם—װזזזזוÿ׀זוזףךוףו׃כװה–צנגוןזז‏גהצצאהÿ“זהזזכהְְכ‎צִווזצבÿצזבופ‎כזזָלהס—זהצּ׳פ׀זידצםֳדְגהז־ֳכדזגדז׀םֳדְגהז־ֳכזזזזזסזזצגÝזע׀ֵצגעזוְצםוז‏םְֱזמזזװלהז׃ֻזזּזהְ—םהÊעןזצצגוס—זוצעÊפ׀זידצםֳדְגהז־ֳכדזגדז׀םֳדְגהז־ֳכזזזזזסזזצגÝזעß‎נעז‏צּבזקÝ׀‘יֽצßךהׂמÝךץגץִץבפצּד׀ְֳל׀צאבץצנךÝמ•יßִאמÞמÊיףצ•יÞג–ךֽ‏•יץג—ם־‏ֽיפגסמÞ“המÞך־וֿעסךÝמ•יִֽÝבפךׂז־ךֽבץצנבֽךÞיֽ‏”ך׀ִֽזֱ׀ׁאֿ‏קבזװנלגװ׀כ—ך’ˆֽ‏ְןזּםןהזהאÞּימÝִ׀ץץצץֳßװִדְעֿמצצקןו׃”הÞּßיגעׂהÞּךםוצׁמץְ‏דזפץףגֿלְִֽמצְנאְןֿאִֿממ‎—Ýךßמקג“קם־ֱֻלהִט”ו‎הֿ‏י‘“זזזגזמצזזז־ְהֻזזײזכֳכװזֻצנגז׀זזךווְגדִזזבזזְןוצֻֿוזגוזצםֳזזמהםּװזו׀ִאÿצזאו־ֻכהצגזזז׳ֳזזָלם׀׳ךא—ׂ׀אבו‏צדגזז׀גאזצךאְֱזבזזְןוצֻֿוזגוזצםֳזזמהםּװזו׀ִאÿצזאו־ֻכהצגזזז׳ֳזזָלם׀׳ךא—זׁזזךווְגדוֹ“זוצזמו׀עמ‎צזאזזִזוְֳֻוזגוזצםֳזזמהםּװםזצזזהֻ—זהְָֹהּß‎נעזצל־ָּםÞךץגÞךÝגץגÿגזװמןפװ”ךֽ‏•יץג—ם־‏ֽיפגסמÞ“המÞך־וֿעסךÝמ•יִֽÝבפךׂז־ךֽבץצנבֽךסמפגְןזּםןהזהוÞּימÝִ׀ךץצץֶוװִדְעֿמצצקןו׃ָהץ׀ְˆװָֿהו‏ֶזֲגֶב׀ְֹֿףךÝגְף‘זÊםעָם׀ְאץ‏םמצזזזצז־ˆˆצה—ְלְזדעז׳כעֲזצעאזע׳כװוßצנגזזזגגז׀צוז”“זו׀ְווְעןוÊִזוזצזÿ׀זזזה’כזזךדזֻ—זזְמÊפ׀זלה־ֳכזזּםם—װזוצעכÿ׀׀וה׀װׁה—׀ֵצד“זזצצדוזגדְֱזלוצּבהְֻזזִמזצ‏בו׀‎ֹזזצגזבזזזזׂפ׀זדז׀םֳזזמהםּװזהצֹּפ׀זבוצ׃ֱדזגכהÞכףבֻזבְזזזדעזידזׁכפ׀ֿגפ‏ּמֿגףמÞעיהו—ױב־‏–יד‏•ךÝמנבß‏Ýךֽ‏”יÝךÿמÞ‏ÊמÞמאבץצנךÝמ•יÝע—ם־‏ֽמÝעֿבפך־וֿעסמÞ‏ÊמÞמןוְ‏ֽ•ֻסֹ•׀Ýצץÿה׀ּקז׀ךֿו־‏ט‏—ֻÞע•ץֽאßסהץךפד׀ג־גֿעÿמצִצגזְִלע•דלÞֵֽ׳–פד׀׀להזְםׁע’ֶ׀ÿ־י׳זָכ׳ָֿ‎וÞגֿאפןצהצּןהְ”ˆˆ׀ז־ˆˆצה—ְיÞזהמזן׀זזזצִו–׀םֻזכ“זוױךוזֵ“Ýלˆˆˆזהכˆזכפזײזזזְזֱזזזזזצזֿזזזהְלעזדךזקּזזזצזה׀זגה•עןוצךדזצגהÿצ‏וזְמÊפ׀׀להזךזזזֳֻדצגםהפִםףדךÞךףזװלÞִÊםפצÿגץגעבוגץבßזטהו—ױיÝמ•יֽעץיה‏ÊמÝעֿבפמאוֿעסךÝע—ם־‏ֽיפגסמְ‏אבץגעבֿ‏Ýבפג–ךֽ‏•יףעֽבץצנבֽךסמפג־ןז‏ןאÞמויהמִוׁ‏ןאÞמוךÞמֵוְִֵמֱימßװאְִֵמׁךמצּעא׀ןְןועםמפגםבץÝךÝו׀סהפגֿהץעִˆ־זֶבְְֿמצּעא”׃אֿ‏ממצזזזצזֿזזזוסְלעזוִזמ—זְז׀גוזצםֳזזמהםּװגזצזזוס—זוצעֹוע׀ץבßגץבßזאהוָױיÝמ•יֽעץיה‏ÊמÝעֿבפמאוֿעץבו‏נךßעֿמפמֵהזֵָמזג–מוװםהץָֿˆװװֿהועֵזֲזֵב׀ְֿמצְÿאˆ“ְאß‏ןמֱˆˆזהגזזזבנז‘צזמְזֽזזזוו׀ןפזֶ—זְׁזאװ׀גוֽׁךױˆˆזא׀זזזס׀דֱ׀ז־זהךזזזגןזֳעו׃ְהזזֶÝזצאךÞׁˆˆ׀זךזזזוֵזיßזהמזמ׀זזזצִוÝ׀ןאזכ“זוױךוזױ“Ýלˆˆˆזהגזזזבנז‘גזמְזֽזזזוו׀ןץזֶזזְׁזאװ׀גוֽׁךױˆˆזמצזזזס‏דעְז־זהךזזזגןזֲּזזזהזזֶÝזצאךÞװזזצזֿˆÝזוסְלעזהָזקּזבוךהזְגופְּמזְ‏או–—זו׀ִÊפ׀עוזזזוÿצצוזצגֹפ׀זהזְיֱזזךדך׀יךזזזזלְזײגץִץבפצֻגץִלהו׀ױזז‏אבץגעבֿ‏ÝבפךאוֿעעבֽךÞיִֽÿו־ך־םֽע—יִֽֽיףמ•יֽעץיה‏ÊמÝעֿבצג•א׀ּםא־גְם־ֶבְעהß‏ָפÝזׁצÝֲֹמֿװמהֿװְזףעהִ׀ְÿאˆ“ְאß‏ןמץצׁמץְ‏דזפץףגֿלְִֽמצְסא׀ןְאßִממפגזזֱױˆÞ׀וֶזלעזהזזנעׂ׀הסו‏צו“זזזמוזצו׀וזגהזְיֳזזךדםּװזזצגב‏ז‏ווצעÝוע׀ֵצוזזזמוזְזוְֱצוזְמדÿצזדזÞ‎כזזגוונזאזצעבך׀סךנעזטזזזזמזזֱגץגסםÞךןהוּױוֽע—יֽךÞבֿעעוְ‏סבדךÞיץג—ם־‏ֽיפגסמְ‏אבץגעוְ‏ֽספ—ֲןה—מדßךהו׀ְזףעֿא׀ֹּ‏בÿע‎הִ׳םÞמקבץ‏בהÊךה־וװÿההגֿהוִֵˆְ’ֲֽֽ“זזזגזמצזזזִׂהֻזז“זד׃זטדִָד׀“גזז‏ופְװםהזךאוְֳֳהְגןוÞ‎כוצךהז׀זזזס—גזצגום׀בךךÝמßךה׃גץגÿגץג‎מץגעדזְֳלÞצÿןְמÝבפג–ךÝמ–יהִֹוßעעבֿ‏Ýבפג–ךֽ‏•יץג—ם־‏ֽיפגסמְ‏אבץע”יֽע—ם־ךֽיףךסמְ‏קזִֿה‎ְֱִמפךÿˆױ׀־אץא־אצִֵמׁכמֿװמהו׀ֿזףעְא׀ֹ׀דְקאװצְךÞװְÿֶ•נהפ—׳ב־גֿגז—‎’וֱכאß‏ןמפגןבֿװו“ו׀נההגֿהוִֵ“ׂװטדְּךמפגֽלß‎קˆˆזהןˆהְכֹז׳צזמְזױזזזזז׀ןֵזֱךזזזזוזהגזזזמˆז׳צזא׀וספזםעבֿזןְזבזצזזוÿזדזצגוזֻ—זזְמÊפ׀צוזזזאÿְזאו־ִאףו׃זן׀זבזצזווצוז׀גוזצםֳזזמהםּװגזצזזוֻ“זוְ‏ֹוּß‎צזָץג־ִץגץִצו׀ְֵלÝִÞיֽ‏–גףצÊם־ך–מץע־וְ‏סגץצנבֽךÞיִֽÝוÞגֿמֿװמהו׀ֿזףעְא׀ּןאץ’נ‏וז׳דק”ׂמצִנא׀ןְןו‏ממפגמבßׁםוװסהד׃טױְדˆˆ׀זֿזזזהק׀טּזהמזכצזזזצִו“זז‘זכ“זוױךוזֵ“Ýלˆˆˆזהגזזזמˆזײזזמְז׃זזזזז׀ןעזֹװזזקˆˆזהןˆהְמˆז׳צזמְז׃זזזזז׀ןֵזֶזזזזוזוזזזםגז׳צזמ׀וױצז—ֵאּֿ‏ה׀ָםהזְאזְבלפזםעבֿזן׀ִווְמוזצ‎׀וזגהזְיֳזזךדםּװבזצגוזב“זזזזֹזג׀ֵצהזןזצ‏הזצמאזÿ“גזצמהז–—זז׀ךÊפ׀עוזצגזÿְזזזהִזףבֻזד׀זזזהךזמÞװץגץװץגצְמא־װֻוÞג–ךֽ‏•יףעןיףִץיה‏ÊמÝעֿבפמאוֿעסיßעןגץצנבֽךÞיִֽהץזÝ־מֵהגßךהו׀ֿזףעְא׀Êזְזִ‎ןֻ‎ְגל‘ׂמצִנא’צÝצדךודו׀נההגֿהוִֵÊססזסֱאßעמט—“זזצזפזזזדק׀לעזה“זֶױִÊמְ—דזזגופּׂ׀בֻו‏צהזגזצגוזֻ—דזצמהםּװזהזְֹפ׀ּןוצךזזז‎ֳהְגאו־ִאףו׃זמ׀זמזז‏זהז‎וזגוזצםֳז׀גהז־‎כהצִבז׀זזוֻ—לזצ‏אם׀‎ךנעזצכ־—װלֿ‏ץגץִץגßגÿמזװמןפװ”ךÝמ•יֽעץיה‏ÊםÝעÝגÝךףךßעטזֿעץבו‏נךßעֿיףמ•יֽעץמ׀ךֽזÞךץבו‏Ýךßעֽג׀—‎אזְםןפןÝײ׀אÊ‘הזִהזִּןˆפןץּמזװםזÞזגסםופמצָסבְןּאֿ‏מזפןעזא׀מצגמבֿױןßּÿההגֿהץ‏‎זִק׀ןˆּצֿבהגזזצזִˆˆּהְָלעזהמזיגזßבצזהזזךופְִבזְךדוב—אזצצגםּװהזצזזזס—זזצגֹפ׀זמההִמףומֿגפצץב־גץםזּמןפװףמßגעבֽךÝבפך–ךÝמ•יץג—ם־‏ֹיףךוךßג—מÞך–ךßעֽמֿעץמ“—ובץ—ֵׁוִ‏ב׀ֳּמֲ׀וכצךÝןכּףכֹצהגׁ’דןץִֿמץֵּזֲעֶבְְומֱ“ײז‏ע׀מפג׀ˆֵֵˆˆ׀זִˆˆּהְָטּזהמזך׀זזזצִו“זהֿזכ“זוױךוזֵ“ÝלˆˆˆזוÝˆצל־ז”זמְזÝזזזוו׀ןנזֻצזְׁזאװ׀גוֽׁךױˆˆזןקלזײמהֻזז־זדךזזזזדזֳװו•׀זזˆˆזןקˆ’זײמדֵצז־זדךזזזגןזֳּהף׀הזזֶÝזצאךÞװזזְז־ˆˆ‏הÞְלְזזװזב׀זװצהּזזְמזÿ׀זזזה’כוצגדז׀בֱוזגוזפוףז׀ךזזזךב׀׀נגֿזזה׀זלםז‏מבפװנםֽע—יֽךÞבֿעעו־ך•יֽע—ם־ך־וֿעעבֽקףװֵאָֽאßָ–ֿןףסם‏ץ—ֳ‏הױהֻ׳ֵה׀׳ֶנ׀מ‎נֱÊ’Êסֹ’סˆˆזמׁˆ•זװָד׳זז־זדְזזזגןזֳמה‎׀הזזֶÝזְאךÞׁˆˆ׀ז־ˆˆ‏הÞְיˆזהמזטזזזזצִו–צם׀זכ“זוױךהזֵ“Ýלˆˆˆזהכˆְכלז”גזמְז“זזזוו׀ןקזָזזְׁזאװ׀מהֽׁךױˆˆזמׁˆ•זװָדָצז־זדְזזזגןזֳגהנְהזזֶÝזְאךÞׁˆˆ׀ז־ˆˆ‏הÞְיפזהמזטזזזזצִו‘צה‘זכ“זוױךהזֵ“Ýל׀זדזהכˆְכלזײזזג׀זֵזהצזטּז”מפזנבץךצהצ‏מוצצופְזדזÞ‎כזזצגזֻזזְמׂפ׀‏ווצעזÿ׀גוזזזׁזג׀ִןו׀ּןהךֻג־עפמ׀ִמאפװזבץצאמÞמֹוÞך”םֽע—יֽךÞבÝִÝו׀זÿזפ‏ֽמְ‏סגֽ‏–יהִובֿ‏Ýזװײßָ“יעכֽמנכאֱֽבךֹקּדֵצְוןה‎ֱנגֱ”ץ׀ׁ“ץבדי׀ן”ױלנ׀טֽ‎ססײֶֻװדצׂפˆ‘ײך׀בקֶ׳נֱˆװÞסֹ–םזˆײ—‘טֱˆˆזהכˆְכלז•—זמְז“זזזוו׀ן‎זÊּזְׁזאװ׀מוֽׁךױזזמזמְזזז׀הֻזז׳זדִומעׂ׀הסו‏צדּזזצמגזְב׀זזְבו׀ִמִזזדזז‏בז׀‎ֻהְגהזְוֳזזזזםּװזוצעגÿצזגוהֻכדצװהו׀ִםÿְ׀והצֹּהע׀ֵפזלעבֿזטְזוזְצהזÿזזהזעןוצְןְֱזדזז‏בז׀‎ֻהְגהזְוֳזזזזםּװזוצעגÿצזגוהֻכדצװהו׀ִםÿְ׀והצֹּהע׀ֵפז׃עבֿזט׀זוזְצהזצץזזְבו׀עמו”“זז׀זאוצךא‎צָוזְמזÿצזזזה‎כזזעבוב—זוזצ׳פ׀—כזְִןהס“ךזצּםם׀ֻךא—ז’זזגהוזמוון“זהזעןוצְןְֱזדזז‏בז׀‎ֻזזצזוצְגונעלזצמהזב—זזזזÊפ׀—כזְִןהס“ךזצּםם׀ֻךנסֻ‎צוָײלְזזלִֽײיֽמ׀זהּזלומּמßגףמÝךץםז“מןפװÞםֽע—יֽךֿבפךׂז־ךֽמְ‏סבףךÞיֽ‏”ךßעֽכְמֽמßעעבֿ‏Ýךֽ‏”ך׀ִֿיֽ‏–גףצÊם־ך־וֿעעבֽקֿׁÝז־מ׳דפך”ךדװעגנ—ֵןז“במפגגדß׀ֵֵצ“ֹל—ßפדÞּךˆֳץאא׀ֶּא”‎ױֵןאֹ׳לפֹֻףךÝגְף”ְÊםעָם׀ִןץװלטסהׂםßִֿזֳע‎אז־ֱֵָאװזזזהזהגזזזםֱז׳צזאצזּזדץזךצְווְזדזז‏ד‎׀ִוזצגהÿצזהז־‎כוזגזזזסֳזזעבם׀סךאßָֿןßָּאÞצץבהצֿבßזםהוָױיÝמ•יֽעץיה‏ÊמÝעֿךֿ‏סבז‏ֽמßעעבֿ‏Ýבפגוךֽ‏–יה‏ֽמְ‏סגפג־א׀ְםןהזוך“הכֹ׳צֵהץֲָˆװ“ודף׃םקÝ—ÿדפגמבץװו“ץָÿההב־ÿא’־ױץָנההגוכֻבעףעךבˆ־זזזהזהגזזזםצז׳צזמזזײזד’זט׀זגזזּמוזֹֻהְגמזזעזהזסֹז׀גוזצםֳזזמהםּװאזצזזו–—זו׀ִֹו—׀־מפִֻמפָ־לֿגעםהצץגץִצה׀ְִלÝִÞיֽ‏–גףצÊם־ך–מץע־וְ‏סבףךÞבֿעעו־ךֽבץצנבֽךסמפעÞיףצÊמÞמאבץעֿמֿװמוßװֽזף‏ֱןזָ•ְ‏ֲװֲץּןאÞןÝזגבֱÝָÝב׀ֿוßִִזֳ“ִבצּֿמצְÿאÞ‏סנֳקףו׀סהפןק־ּץבדוק—זזמזמׁסזװָהָזזÿזהךזÿּזךדְִהז׀זגהזגוזזםלפזםעבֿזאְעווזךזזזץ׀זזזזזצזו‎זזדז׀םֱזזמהכְיךא—זֵוצגגז׀זדוזוזזזזזצזו‎זזדז׀םֱזזמהכְיךנעזיאוְ‏מßְ־םÞִּםז‏מאהװּוְִנבֽךÞיßִאו־ך־ם־ִÊםֽע—יֽךÞבֿעהיֽע—ם־ך־וֿעעבֽךהÞָץזפגנןÞִנגעְׂנב—הֲ“טßָ‘טßˆגֳיעֻֿןץ–־ײßע”ךß׀׳גהבנעֶֿײֽײנ׀װלÿÝםנֱÊ’Êסֹ’סזזמזמצזזז׳ִהֻזזױזד‏זקּזגצגבהזבלהְגמזזעזהזסֹהצגוזצםֳזזמהםּװאז׀מזזזץֳו׀גגוהִגףה—װךÝגװי־—•גץצÊגץ—ֿבßזכהו׀ױיÝמ•יֽעץיה‏ÊמÝעֿךֿ‏סבז‏ןבץ‏נבßֲִזֽךסמÞ‏ÊםÞִÊם־ךֽבץצנבֽךסמצגÞיֽע—ם־ך־וֿעסמפמֵהזִּמזגÝֹֿ’ֲףד—”דְ׀םג־גֱßצ“ֶוß“ממהמ׳הץֲָˆװ“ודעךטףÿד־גמבץװו“ץָÿההבףף—ֿפדזמלטעצ“לÞװעמצָ—ןָָÊם׃ֶּבְְֿזס׳הפּ‎דדץֵÞזקˆˆזהגזזזלÿז‘צזמְוגזזזוו׀ןְזם—זְׁזאװ׀מוֽׁךױˆˆזמצזזז׳ִדֱ׀ז־זגצזזזגןזֳ‏העזהזזֶÝזְאךÞׁˆˆ׀זֿˆ׀ָהֻ׀לעזהמזץזזזזזךו•׀ןÿזזזזזצז־ˆˆצוצלְזדִזß—ׂ׀ןבו‏צדךזוְ‏הÿ׀זהז־’כזזךדםּװזוצעגÿצזגוה‎כזזְמם—װזזזזםÿצזםהפֳכזזגוו–זו׀ִׁו—׀ֵפזְעבֿזיְזמזזגזהזבזז‏אזֻזזְמׂפ׀זדזÞ‎כזזעבוב—זוזצÊפ׀זזזזֳֻזזּםם—װזזצגןÿ׀זןוÞןףו׃זטצזדוְעאז׀סזזְזזצזמזÿ“זוְ‏הÿ׀זהז־’כזזעבוב—זוזצÊפ׀זזזזֳֻזזּםם—װזזצגןÿ׀זןוÞןףבֻ‎צז“”י־ךװמֿגפמÞ׀ֽגזָמןפװ”ךß“הךÝמ•יףצÊםÞִÊםֽע—יֽ‏ÝךִֿנבֽךÞיִֽÝבÞךÊם־ך־וֿעעבֿ‏ÿבß‏סבז‏אמÞמֹם־‏ֽמְִֽמ־ּאך–ג׀יג׀–י—ֳÿעÝ׳ֹצÞּׁוו—טדְװדמצָ׳ד–׀יג‏ֹלפֳ‎ֻ—ץװטÝוזוץ“לבְְֿװÞסךךÝְ“לֽצףאץ’ֲףףֳךֿגוהצָםײ—סףטה׀ְלßמטמדֲכפÊעßבזגםגׁˆˆזהכˆזן–ז‘צזמְומזזזוו׀ןְזבזזְׁזאװ׀גוֽׁךױˆˆזמׁˆ—זֱעדֱ׀ז־זגְזזזגןזֳ‏הז׀הזזֶÝזצאךÞװזזצז־ˆÝעוצלְזבגו•ּזÿןצגוזזצווזגצזצךגד׀גהז׀ץלןזגגזעֻכװז׃צנגולזזגזוזךוִזזגז׀זגְֵזידצֱֻזזּםכּװזהְָÊפ׀זךדז׃ֳזזװכםּװזוצעֹפ׀זןו׀‎ֳזז‏אם—װזהזְזÿ׀זזזהכזזךדזÊזזזְמױזּ׀ֵפזצעבֿזפ׀זוזזצזזצץזזצדזזץׂזז—יהסזהצּׂפ׀זלה־‎כזז׀ךה–—זה׀װÊפ׀זבופֳכזזִןוֻ—זוְ‏ֹפ׀זמהזוֱזזזזכ—װזז׀ךה‏זזהז־װהףו׃כװוßצנגוךזזגזוזזוון“זוזךזוזיזז—יהסזהצּׂפ׀זלה־‎כזז׀ךה–—זה׀װÊפ׀זבופֳכזזִןוֻ—זוְ‏ֹפ׀זמהזוֱזזזזכ—װזז׀ךה‏זזהז־װהףו׃כװהוצנגוקזזעןהזִבהן“זזצזגזזגגְֱזגז׀זגז”׀זדצ—םÿ׀זםהפ’כזזָלםּװזדז׀כÿצזכהÞ‎כזזִןוֻ—זוְ‏ֹפ׀זמהזוֱזזזזכ—װזז׀ךה‏זזהז־װהףו׃זעְזלדצ׀יהְßזזעןהזִבהן“זזצזגזזגגְֱזגז׀זגז”׀זדצ—םÿ׀זםהפ’כזז׀ךה–—זה׀װÊפ׀זןו׀‎ֳזז‏אם—װזהזְזÿ׀זזזהכזזךדזÊזזזְמױזּß‎נסֻ‎צו‎מץּץדצּגˆקףָ“מßגץלהצֽםהךפדְְֳלÞצאוְִןיֽ‏Ýךֿ‏סבז‏ֽמ־ִ”בֽךÞיֽע—ם־ך־וְִֹיÞ‏ֹם־‏ֽמְִֽםÝךֲזֽךÞיֽע—ם־ִֹם־‏–יד‏•ךÝמÿבֿ‏Ýךֽ‏”ךßִֽם־‏ֽמְ‏סבו‏נבßִנבצן–קÊצ’בזִÿדוװעד‏“מßמ־בßךֳגֿגלדצגץם־ז–וץ“לבְְֿדהּאך–ג׀יג׀–י—ֳÿעÝ׳ֹצÞּׁוו—טדְװדמצָ׳ד–׀יג‏ֹלפֳ‎ֻ“’־יזצ׃זְךֽמה—ֹדÞ‏קגßצצג׀ִוהבזדגזגםגױךֻףדך“טהָ—גßֲּÿּ—ˆÿףמץזצּלהֶ׃בעÝְװמהװפד־ז”־׀דˆˆ׀ז־ˆ׀ָוצלְזהמזפזזזזזךו•׀אלזזזזזצזעזזזהִ׀לעזוְזנגׂ׀הסו‏צוגזצמוזזגהִזעוזצגדÿצזדזÞ‎כוְגזזזֳֳזזִןם׀ֳךא—זְוזגהזצזוזְווצגוזציֳזזךדםּװאזצזזו–—זו׀ִֹו—ß‎צזװץבהגץגץמּגזְמןהװ”ךֽ‏•יץגֽמְ‏ןמÝִֿבפךÊמÞךץבו‏נךßעֿױהזֶהה——פצ‏ײזצםֲלוץ”םצְֶןˆצמצְסאְמִפ—־Ýװ’ק’וָסההגזˆˆזבזזזזֹךדֱ׀ז־זג—זזזגןזֳ‏הקזהזזֶÝזצאךÞװזזצזעˆÝעהִ׀לעזדךזּזףדצגןווּווְִ‏זצעאז—ָֻזצִופעׂ׀הסו‏צדּכזצזוזְגזִזזגז׀ִאוןזזו׀‏דו׀‎הְגוזצßֳדצגךדה‎כהצגהזְיֳהזגדזÞֳכזז‏אונזזוצעױוע׀ֵפזכעבֿזטְװוזזגהזצזהְֱזגז׀ִאוןזזו׀‏דו׀‎הְגוזצßֳדצגךדה‎כהצגהזְיֳהזגדזÞֳכזז‏אונזזוצעױוע׀ֵצדװכזצזוזְגזזֹ“זוזךןז׀צןְֱזןוְךןוֹ׀לזצגודב—יזצ׀ךםּװםזצמהז–—מזצךדם—װזוְ‏ב‏זזבופװבףבֻ‎צוְזזזזÝזדךÞךפ׃לפְעםהךּמßגעמץגטהו—ױזץעֽם־ךֽגץצנבֽךסמ׀ִ•יֽךÞבֿעעו־ך־םÝִנךÝמ•יףצÊמÞמאוÞִ”מÝעÞיֽ‏–גפך־וְִֽי׀םÝלוץ”םצְֶן“ךֶוßִךןÞßציְֽֽג־מÿגß—פגצָיזץגװְ־זֶהה——פצ‏ײזצלעװ’ק’וָסההג’זְךֽמה—ֹדÞ‏קגßצצג׀ִוהבװֿהועֶזֿßכפכךזˆˆזבקלזֹךהֻזז־זג—זזזזדזֳװו׀׀זזזזגזןֱˆ—זִׂהֻזזֻזה–זלְ‏גזְךזזזבֳוצגוזפ‎כזזךדו–מזצִןכ׀ֳךזזזזםצזּגץגנםֿגץבְּמאÞװנםֽעץיה‏ÊמÝעֿבפמאוֿעץבו‏Ýךֽ‏–גףצÊם־ך–מץע־וְ‏סגץצאמײםהוװֿזףעֿא׀ּÝצּמ•הץװֿזףמֿא׀־םÊזß׀ֲצבֳאß‏ממפגןבßׁֹנונס–ו‏ßװÿוÞגֿהו‏ֵˆײי’ִקˆˆזו”ˆזכֹז‘צזמְוץזזזוו׀ןפזֹךזְׁזאװ׀גוֽׁךױˆˆזןֱˆ—זִׂדֱ׀ז־זבגזזזגןזֳעהֱזהזזֶÝזצאךÞׁˆˆ׀זֳˆˆצה’׀יßזהמזעצזזזצִוÝ׀לךזכ“זוױךוזױ“Ýלˆˆˆזו”ˆזכֹז‘גזמְוץזזזוו׀ןץזÊ‏זְׁזאװ׀גוֽׁךױˆˆזןֱˆ—זִׂדעְז־זבגזזזגןזֲּזßְהזזֶÝזצאךÞׁˆˆ׀זֳˆÝזה’׀לעזהמזעצזזזזךו”צךׁזזדˆˆ׀זֳˆˆצה’׀טףזהמזעצזזזצִו•זמדזכ“זוױךוזױ“Ýל׀זוזזְזזזלֻז׳צזא׀זָצהעךהצמאזזבלוצךהז׀זזזס—גזצגוםּװזוְ‏ֹוּ׀ףגץג׳מץגפו׀ְֵלßךÊם־ך–מץעֽמֿעעבßךÝגÝ‏–יהךֽיףךסמְ‏ןזÞיסהÞגֿזע‏ױמצנסזָ׀גמהׁהן־מיÝÊעהצץ“עמפגֵו׀ˆ‎זאֲה׀װ‎מפגֳםֱ”קזזזוזזְזזזט׳ז׳צזםְוֶ׃Þךץדצךןזזבלפז־עבֿזאְזדזÞ‎כוְצהז׀זזזס—בזצגוםּװמזצִןם׀ֳךא—זֳזזךוזזגדזן“אוזמדזזזוÿצעוזצגÊפ׀ְוו׀ִֹו—ß‎צז׀ףבוגץםßִֿגץמםהו—ױגÞ‏ÊמÝעֿבפך־וֿעעבßךÝגÝךףךßך•יףצÊמÞך–ךßע־וְ‏ןזÞךדמ׀ךֽףצֵּמצגםֿגקז•ךהֹֿלזזָֻדגֿעּׂו‏‎ג׀ײסעםָהֹגװהצץ׀נמפגכדצּךˆײזוָק’ָזס‏ךהצ“ךמפגכמÞÿ“זןֹˆּֿזזצזיזזזה׃זלעזדּזט—ז“טהּ‎ה׀צזוְבלה׀ּמז׀‏או–—לזצִןםּװבז׀מדזזזוÿצצוזצגֹזע׀–ידךÞךפֿגץְץגפּֿגץגךהו—ױםו‏Ýבפג–ךÝמ–יהִֹמ׀ִאבץצÝךßעֽיףמ•יÝִ–זÞ“המÝעֿבפך־וֿעעבßִÝיÝ‏–יה‏ֽמÝעÝבפמאו׀ִףזֻ׀׀לק‘ÊמßװיִצלדהוװÊ׀פךּב’ײֽדßג‏אזבמאְ“צו–הנ׀װצגוקולהֳִּײבגמÞגֿג׀עׂצךדועֿמץְְ•זגודְֿעוÞגֿדזָלה‘פקגץגיגפגֿא־Ê׃ˆִׁזזצזמזזזהֻ׀לעזהָזי—ז—מץךאז׀גזזעָןוְצדזזזבÿצּמזְעבםּװדזצגוזֻ—זזְמֹזּ׀זזזזײזהָײמץג‏גץג‏גצָמןהװובפמאוְִדבץצנבֽךסמףעÞיֽ‏–יצךׂז־ך–מץעֽמֿעעבßִÝיÝ‏–יה‏ֽמÝעהֻßְֲבזעהֿ׀ֿˆװְָא׀־־הֿזֲןזבפםß׀כֲצבÞהְֿקמזלעמצֳןׁֳױוװÿוÞגֿהוִֶָצבאבץךלמפג‏גוֵֿעצגßךֿˆˆזהזזזז׳ִד׳זז־זב׀זזזגןזֳמהצצהזזֶÝזצאךÞׁˆˆ׀זמזזזהֻ׀יˆזהמזÿזזזזצִו–צםלזכ“זוױךוזֵ“Ýלˆˆˆזזְזזזלÿז”גזמְוִזזזוו׀ןקזָֻזְׁזאװ׀גהֽׁךױˆˆזהזזזז׳ִדָצז־זב׀זזזגןזֳגהיזהזזֶÝזצאךÞװזזצזעזזזהפזלעזוךז‎ִלזצזזזצךהפעׂ׀הסו‏צהךזזצזגזזב׀זזצדזזצדֱזזזזזםֳזזמהםּװזז׀ךבÿְזבופִבףו׃זםזזוזזצזזצץזזצדזזצדֱזזזזזםֳזזמהםּװזז׀ךבÿְזבופִבףבֻזהץגףמֿגףמצ‏מא־װ”זפך־וְ‏ןמÝעֿו׀ג”קְמ”ך׀ִֿבזבִִÝֻגמְ‏׳זְצוˆײץ–ץ—ְßבהּךˆְֳֿזֻמֳקףנ׀מֱ•׃זצגפצגֲזקˆˆזוצזזזםמז‘צזמְוֿזזזוו׀ןְזןךזְׁזאװ׀גוֽׁךױˆˆזבזזזזְּדֱ׀ז־זאגזזזגןזֳ‏הםְהזזֶÝזצאךÞׁˆˆ׀זעזזזהפזיßזהמז‏צזזזצִו—זןפזכ“זוױךוזֵ“Ýל׀זהזוˆˆזמֳזֲמזכצז•זדßזטץצוז׀מÝךְ—דוצךאזצזבז—ָזז׀מבזְךבְֱזהזְץֱזזצגךעװאזצעבזבוזצזזכ׀וךםהעֻלפִֽמְִמאÞװֻוְ‏ֽמ־‏ֹו־ך־יףצ•יÝע—ם־ך־וֿעעבִֿנבץצאמÞמÊיףצ•יֽךÞבֿעסבו‏Ýךֽ‏”םו‏Ýךִֽ–וְ‏סזֿ—ֳקפצּכ׀—‘ע׳פףְßװּבֿ׀ןזצ“ױמÞך׳כÊֻפנֻמלדוגעזֱ‘ׂןו—ִמף““בץךטאומײֵ—ם‎אבך׃לצ—יוְװהגßצֵל־ְֶןףִÊסבףֵמץ‏כזץ‏ֿאלָףטÞׁˆˆ׀זֱˆˆצהןצכÊזהמז‎צזזזזךו—ְמזזזדˆˆ׀זֱˆˆצהןצל—זהמז‎צזזזזךו–׀מאזזדˆˆ׀זֱˆˆצהןצכוזהמז‎צזזזזךו–צמםזזדˆˆ׀זֱˆˆצהןצלÝזהמז‎צזזזזךוÝ׀מ‎זזדˆˆ׀זֱˆˆצהןצכֽזהמז‎צזזזזךו—צןÝזזדˆˆ׀זֱˆˆצהןצלעזהמז‎צזזזזמו‘סךזזזמזןˆ׀זֿ—ו“ְזזגעזסּוףא׀גדזּםובזךבזÝעיה׀ךווצךהזְִווגָזז׀מבזְךבְֱזהזְץֱזזצגךעװמזצעבזסאזצגוכ—װםזצִןזבזזזזÝזג׀זזגזזד׀זטßצֻםפֹּלהצלהוװױוד‏”ב׀‏ֽמ־‏–יד‏”ם־ִאמÞמ–יד‏”יףצÊמÞמאבץצנבß‏סבז‏ֽמ־‏–יד‏•ךÝמנבץעעבֽךÞיִֽÿוְִאבץצנךÞ‏נךÝמ”יצ‏אבצא•בזװנלגװ׀כÝּ׀כץ‏‘ע׳פףְßװּבֿ׀ןזצ“ױמÞך׳כÊֻפנֻמלדוגעזצ׀ױטּגֶבְִׂןץ׀ֿקֽ־עדזפץףגֿםÝ‏ÿהץײֵ—ם‎אבך׃לצ—יוְװהגßצֵל־ְֶןףִÊסבףֵמץ‏כזץֳזÞ‏Ýאוֲֽמץ־ײגÝװױזקˆˆזוˆˆזמֳז׃עזמְוֻזזזזז׀ן‏ז‎זזזקˆˆזוˆˆזמֳזײזמְוֻזזזזז׀ן‎זְמזזזזדזוˆˆזכˆזֲמזךְז’זגךזִעוׂכץ׀הוצצסזצזםקףװךו׀‏בזצזדפְזבוזּגוצֻדזגםה׀גזזצּז‎צְווזצאÿ׀ִווְ‏ßפ׀זוזצםֱז׀גהז־כדצגלהְםֱז׀גהז־הףדָ‘ךÝךוזד׳דטּמÝטףך’יÝע׀כ־׀ײםפךֶאוזטה׀ּבז׀זÞזףמטהוצױםפגנבֽךÞיßִאו־ך־ם׀‏אמÞמÊיףצ•יÝע—ם־ך־וֿעעבß‏נבץצאמÞמÊיףצ•יֽךÞבÝ‏Ýךֿ‏סםÝצÊמÞמאבצ‏”םֽעאוֿעעבֽךהˆˆנזÝך“ÿ־װּןב–ְִÝֹּנד׳מפ’ֻאÞצנןזּאוÞָּמÞּ•ÿÝ׃נכֽ׃ףֵÿהֹןהעֿמֵגÞמף““ןץׁ׳‎סםֲגף’יצץ“ֽטדבמס׀׃־כפּידצְכהְךןפָ׳אß”מ־‏Êֱןִֵ‎סםטֲֶגָטבִייÞֻן׀זזזְזסˆˆצהצצלÞזוִזמ׀וץצג“צזצמדג׀גבוהגְהזךאוצילזזמדוזךהון“זז׀ךָפ׀זבוצץֱו׀גגודבכזזגום—װמזצ‏אזבזזזזׁזג׀‏אזזזאהך‏מֿֳזוִזבֿמֽגÞצםהוְױזו‏סבז‏ֽמ־‏ֹוÞךץיה‏ֽמÝע”ךßגÝיֽ‏Ýזֽ‏•יףצÊמÞמןגץ‏Ýזֳֿ׳ֿÿִװץÞעֿי׀װפמ‘ְ”זץ׀לßֹּג־ָׁם־ִּלזן־ֲÿיִֿֿנמצםנבז—־אֱˆאוֹךÞֵֻעאוÊלˆ‘Þמצזזזצזֳˆˆצו–ְן־זהעזיעזÞמפזהז׀גופְזוזְךהזציזזמהזבזזזזßפ׀זדז׀ץֱוצגגוהגףזזזזהעזםה‏ָםהצאהוְױב־‏–יד‏Ýךֿ‏סבז‏ֽמ־‏–ידִ•יףצÊמÞמאוֿעעבֿ‏Ýךֽ‏”ב׀“המ’ֿֹֿםסÿ־צÊמפִמוֶּֿאÞגץבÞ׳ךִֽנםומָעּמךֱÿץ‘ְ—צ•מהְֱןֿגצגזּףבÞוץפסיֳםפ“׀גפּ“לְדˆˆ׀זֳˆˆצו–ְכÊזהמזִצזזזזמו“ד—זˆˆזןֱˆ—זֳ‏ה׀צז־זןגזזזזדזֳ‏וזזזזזגזןֱ–זֳ‏ו“ְוזזליזןד׀זְִבאְגמו׀גוז׀זיזצמדדזגוזְסלאצגדזעֻכװז׃צנגז–זזעאו׀‏בו”“זזזְדזְו׀זזךההזךהֱזזאוְץֱזזצגךעװזו׀ִמÿ׀זמההכזזמהזנזזזצגױזע׀ֵצד‏זוצ‏ןוְעןְֱזזהזךמזזיזזךההזךהֱזזאוְץֱזזצגךעװזו׀ִמÿ׀זמההכזזמהזנזזזצגױזעß‎צז׀נם־ְּלפצֽםהךםהו—ױוצִ•יֽךÞבֿעעו־ך־םÝִנךÝמ•יףצÊמÞמאוÞִ”ם־‏–יד‏Ýךֿ‏סבז‏ֽמ־‏–ידִ•יףצÊמÞמאוֿעעבֿ‏Ýךֽ‏”ב׀“המ׀גןבזִÿדוװעד‏“מßמ־בßךֳגֿגלדצגץם–ßֹּֿםסÿ־צÊמפִמוֶּֿאÞגץבÞ׳ךִֽנםומָעּמךכצמדמÞז׃ם׀Êדßךעגוךןזצֿפה”׃ֲָָיגי־זָןß“ץגוזםגßְִעעֻףÿפעׂךוג׳טהָזזזמזןֱˆ–זּעהװְזִזהִזס—ועבצגדוז“ווְמֱןְךדו׀‏דפְזדוזמגז׀םזזצגלגװזוְ‏הÿ׀זהזֽבכהזגבוצוֳזזזזם—װםזצִןזסזזצגׁזע׀ֳןצזזןפֳִם־מְזו׀זאßמֻםהךץהְְ‎לÞעסמÞִאו־ך־םֽע—יֽךÞבÝך–יה‏ֽמÝע”ךßגעבֿ‏Ýםִֽץם־ך־וֿעעבֽךהץֳגןמעמָÿנ־זֳפװÊוז—טםֶָ—וצ—ק’העֽםֽמװכÞ׀ֿמפװֳאÿ׃׀ֱ‏עךְßגימֹֿָץִעו׀ִ׃זסזִ‏Êבױֶ׀זהזו”ˆזמֱזװךזןצז׳זדֻזיְ—וזְגופֿװֶאץְנבץךפגץזלזעְזזְמוÿ׀זוזףבכוזגדז׀וֱזזזזכ׀וךןֿ“ֲלץ“ָםהמּםזעמב־װזבֿעעו־ך־םֽע—יֽךÞבÝִÊם׀ִֹיÞ‏ֹיß‏ÿיßִןבִֿהיֽע—ם־ך־וֿעעבֽךודטדְן‘וְןּנאזגֲמ‏“ְֳÞ–ןל––־ß–’כה–ֳםה‏Þך־ָײיזא’ֳג‘וְֹß‘ֲÿ—גזפ—ֽק־ָ’להִ־כפצלֽעֽךׁ“ֶ‎נ׳ÝֶאֿװֶÊ׀זˆˆזןֱˆ–זױךהװְז־זןעזזזזדזֳצדיְזזזזמזןֱˆ–זּעהװְזּזהז‎עו־אצגבוְ“והְמֹםְךדה׀ָדפְזבוְצאוצץו׀גגהזגדזְצד‎צזאו־ֿכזזָלזֻזזְמßפ׀׀והצּזÿצזזזהֳכדצגכה׀בֱזזגוכ׀בךםפעזזהעׁםפ“ײלזזּזהךץגץמֽגץךּמßגטהו—ױםץעֽם׀‏אמÞמÊיףצ•ךÝמÿךÝעֽיףך–יה‏ֽמÝע”ךßעÝבפךץבו‏נךÞ‏”גפ‏ֽמְ‏סבו‏ÝזּÿץוÞבהלב–ְָןעױםְץֱצ—טםֶָ—ידצבדצˆּםפךÊך־׀ׁכהגֿלß—‎ֲ”וֿצßץל׀ִץדפמ‎‏הׁכוִעו׀ִ׃זסזִ‏Êבױֶ׀זהזו”ˆזןׂזֲמזג׀זֶזגוזקצִאזְגזזעָןזצעאזצזווצוֻזזצגז–זז׀ךßפ׀זוזצםֱזזמהכ׀םךבוצוזוצֶבוָ‏בֿמצדזָבז׀זףזץךמהוצױםפגנבֽךÞיßִטז־ך־םֽע—יֽךÞבפִ—ם־ך־וֿעוׁנזÝך“ÿ־װּג־’ÿצ”ם•ֲÿףּ׳ß׀ֻמפן׳‎סםֲגפְלןß‘ֲ””Ýא•ספףÊֹˆˆ׀זֳˆˆצוְכÊזהמזֲצזזזזךו—ְן–זזדˆˆ׀זֳˆˆצוְכוזהמזֲצזזזזךו–ְןזזדˆˆ׀זֳˆˆצוְכוזהמזֲצזזזזךו–צןזזדˆˆ׀זֳˆˆצוְלÝזהמזֲצזזזזךוÝ׀מטזזדˆˆ׀זֳˆˆצוְלÝזהמזֲצזזזזךו—זאָזזדˆˆ׀זֳˆˆצוְכֽזהמזֲצזזזזךו—צןָזזדˆˆ׀זֳˆˆצוְלעזהמזֲצזזזזמו‘עְזˆˆזןֱ׀זֲ“ו“ְז־זןּזזזזדזֳ—הנזזזזזגזבְזזזֵ׀ה׀זז׃זד׃זטזזגוצמבוזםזזעבז–זז׀ך׀פ׀ִוזצגהÿצ‏וזְמ׳פ׀ְוזזזםÿצזםהפִםףה—װבוגףל־צּגץצצהְְֳלÝִÞיֽ‏–גפך–ךÝע—יֽ‏Ýךֿ‏סבז‏ֽמ־‏–יד‏”יֽ‏–יה‏ֽמְ‏סבףךסמßגעבֿ‏ÝבפגנןץָםצגזÝÿֽ’הספצ־מה‏מהז‏בגצ—ְאבֳÿדפךֹˆװָֿוßצÿזנמֿךד‎עךדִÝמהִֽןז“צהצִלו׀—יקÝיֱמֱ‘ֲבßצןמצזדזזˆˆכזמÝזֲמזיזוזזג׀זˆגזץךְמז׀זולֿ‏הזְְÊזצּדז—׳כװו‎צנגזזזזוהזגזִז׀והזזהז׀ְה‎׀זןו׀סֱה׀‏הוצעßפ׀זוזצסֱה׀‏הוצעßפ׀זדז׀ֳֻזזּםם—װזהְָגÿ׀זגודךגףו׃כװו׳צנגזזזזוהזגזהן“ךזצְזזְךמזÊִזו׀ִבÿ׀װאזְעבךעװזזצגבÿ׀װאזְעבךעװזז׀ךםÿצזםהפֳכזזָלובזוזצÝוג׀ֵצד׀זזזגמזצזמְֱ׀והזזהז׀ְה‎׀זדזזּלז׀ֻֻזזִןוסכוְמבוףבכזזגווסכוְמבוףבכזזָלובזוזצÝוגß‎נעזֵיףעזזג׳מץגמ–צדעˆטÝּזיזזÝכ־ך—םפ‏ּדצְֶל׀זנבץצאמÞמÊיףצ•יףצֽמְִנבץצאמÞמֹוֿעעךÝךÞבץצאמÞמÊיףצ•יÞ‏–ידִÊםֽע—יֽךÞבÝ‏Ýזֽ‏–יה‏ֽמְ‏סבו‏Ýב־‏ױזְ‏סבדךÞיֽעהגפמנבֿגעז׀“סגÞ‎‘‏ß—ְלגםׁ׃מֲמ‎”ךװכהבלידֻ•‏אמאÝÝÿןץװֲןֿװ‎ןײֳאפ”ִדמָ–לסְן־ןץְףאז“טוצ׀דהץְ׳טע׃צוצעןםוÿנףע”מִֽףןÞ׀ˆםßבןיג–עלÞׁ”Ý׳ךפףִ’ףעָ•פגֲכָֻׁכׁˆˆזזˆˆכזמÝזױצזמְהדזזזזזְןֿע׀זזוזזקˆÞ׀הך׀כךזומזץ׀וףזבוÞעזנץפמֵז׀מדקפּהוזָ’זצװבז—ָםוצמזפגׂ׀הסו‏צג‏זזְךלז׀ם׀זזזיזצגןזזבֹד׀גלזזצבהְץֹזזּםו–טהזמןוÝבכזזךדו–טהזמןוÝבכזזעבה–—זה׀װֹפ׀זךדז‎ֱזז‏אך׀‎ךא—ׂ׀בבו‏צגְזזְךלז׀ם׀ד׀גלזזצבהְץֹדצגוזצוֱזזזזםּװזהצּןÿ׀“מזְִןךעװזז׀ךןÿ׀“מזְִןךעװזוצעכÿצזכהÞֳכזז׀ךוֻזוְ‏Ýוּ׀ֵפזנעבֿזץְזהז׀ָדזֹזזזז—וזצִזזנִקזצָזוזעלואִזהצּןÿ׀“מזְִןךעװזז׀ךןÿ׀“מזְִןךעװזוצעכÿצזכהÞֳכזז׀ךוֻזוְ‏Ýוּ׀ֵפזֶעבֿזץ׀זהז׀ָדזְ׳זזזיזצגןזזבֹד׀גלזזצבהְץֹזזּםו–טהזמןוÝבכזזךדו–טהזמןוÝבכזזעבה–—זה׀װֹפ׀זךדז‎ֱזז‏אך׀‎ךא—ובזזמדהְךההֹ“זזז—וזצִזזנִקזצָזוזעלואִזוצזכדזעכ‎צזםהצֱֳדְְהו׀ִßפ׀זדז׀ֱֳדְְהו׀ִßפ׀זךדז‎ֱזז‏אך׀‎ךנסֻ‎נעזָפגְףג׀זזÿס׃ÿסעֿףפבםטףויןג—‎גצֽצÞכÞ׀ָם־גֱאץִזגְזץןוזמבפװפםֽע—יִֽÿוְ‏סבו‏ÿבֿ‏סבז‏ֽבֿ‏סבז‏ֽמ־‏–יד‏–יהך־וß‏סבז‏ֽמ־ִאבץצÝךÝמסבז‏ֽמ־‏–יד‏”םֽע—יÞ‏Êיףצ•ךÝמÿיֽךהיֽע—ם־ך־וֿעעבֽךנם־װהוֿעעךÝמ•יֱגֹצÝצדאפ‏מדץ“ֲמßˆמֿ‏נגץצדדֿעףםֹ׳ֽןפזָצÊ—ֿ“ִֹֿÞ׀װמעָ—טÿ‎ְ‏ֽ—ֵקיֳִאß“ֲאßֲּ׳—‎כֳ׀ך־ֽע׳נזְךׁםףמהוּדאץזאז׀גהמְֶֿםהגֳאוך‏דְ“בדזךםאהּ’פ–זבדßצִּבֳ‎יףִ־יßךֱכדֹגעִ—ףסצױלˆֱטּßםיÝֻיפֵֽ–מץ“ׂנ־ׂזזגזבצזזזÊגהװְזױזגםזקÞמוו׀ְֻגצמזז׀םלזזִמהצְןהÿ“זהזְָפ׀זדז׀ֱֻזזּםךעװאוזמדזזזוÿצעוזצגֹזע׀׳םßמÊגץגסםֿגץגְָמןפװּבֿ‏Ýבפג–ךֽ‏•יףע—ם־ך־וְִץבו‏Ýבפג–ךֽ‏•יץג—ם־ךֽיףִÝגףך•ךÝמסבצמֹהוְֶˆִׁנבז‏ֿמו‏ֽאֿצ־ˆׂװֳאְּכג־טײיצגÿ׳ִבזְֿמצִפבקז’ךועֶˆ׃װְג־גֿוßצÿזְךעדפגֶˆׂ–ד׳טװזזְזסזזזולְלזזװזןְווצד“נזצךגזעָזז׀צהוזךהְֱִוזצגזÿ׀זזזדוכזזצגלעװבזצמהוֻ—זוְ‏ֹוּ׀זזו“ֳןוװ‏בßעףדצ׀זה׀זלםזְמבפװפםֽע—יֽךÞבֿעעו־ךדךֽ‏•יץג—ם־ךֽיףִÝגץצנךßעֲֿÝּ’םפצ’טהנכןץָםהßמֽײדִעמׁױזְװ—םפצ–יפצּיֱ“נוßצÿזפ׀עדפגֶˆְְֹג־גזזזגזגזזזזפעו•׀זפזה׳זם׀ָוזצמופְזוזְזהזצוזזמהלעװדזצזזוב—זוזצֹוג׀ץגßמÊגזעמאפװ”ךֽ‏•יץג—ם־ךֽיףִÝגץצנךßעֿגו—ֶהצװפמ‘ְ”בהכ‘Þגןבוִוכוצימץױֲהזפמצדˆˆ׀זצזזזוםצכÊזהמז־זזזזזךו—ְאךזזדˆˆˆˆ‘זזזוט׀כוזהמז־זזזזזךו–צאסזזדˆˆˆˆױזזזופ׀לÝזהמז־זזזזזךוÝ׀אֻזזדˆˆ׀זצזזזוםצכֽזהמז־זזזזזךו—צבˆזזדˆˆ׀זמזזזוכצלעזהמז־זזזזזךו•ְאסזזזזזְזסˆÝזולְלזזװזךצוÿצבצ׳זצ‏ןבץצהזְצהפְזאו׀עןוְסהְגוזצוֱזזזזךגװזו׀ִ׳פ׀ְווצעגÿצּווזצֹפ׀זהזְיֱזזךדך׀יךזזזßךהׂלÞָָם־זֱןֿ—‏בֿמצזזװזה־צכהועױג־‏–יד‏Ýךֿ‏סבז‏ֽגְ‏סבו‏Ýךֽ‏”ב׀‏ֽמ־‏–יד‏”מÝעÞיֽ‏–גףצÊמÞך–יÝךץבו‏Ýבפיטףֻּםדּ“םצעׁאֿ‏קבזװנלגװ׀כ—ך’ֱß—ֶהצװפמ‘ְ”בהםֱזְװ—םפצ–יפצּיֱ”ֿכÞג‏אז׀קגּעßמפָ“ןהגןבוִוכוצימץױֲהזפמצזזזׁלˆÞ׀ז“צלזזװזכְוךצגָּזצצבזעָזוזעהוצצהְֱזהז׀עהז”׀ןזצגוזבזזזז׀פ׀זבופֻכזזךדוֻמזצ‏אך׀‎ךדז׀זזז׀ׂדה—ײלפִֻןß—ףגצזכזזָּהצְסלßמÊיףצ•ךÝמנבץצאמ׀מÊםֽע—יֽךÞבֿעעוְִאוֿעעבֽךÞיֽ‏–גףצÊמÞך–יÝךץבז‏ֽÿÝּ’םפצ’טהנאץפֹןץ“׳הצְבוßךםגְגהßמֽײדְֳס׀מכיהעּיףעּםדÿמץִ׀םו׀ױןß—קגְָאדצְםדומׁקזאבז—ֿאׁ“ֹ‏ֹצזזצזסזזזהÿצלÞזדצזףגוםןְגבוֽזֿדזװגזצִהפְזבוְְאוצֿזז‏אלגװםזצִןהב—זהזְ׳פ׀װלוזמגזצגזÿצךוזזזֹזג׀זזזז—זדךװלֿגֻג־‏ץגץװֿגצ׀מןפװֻבפג–ךÝמ•יףצÊםÞִןבץצנבֽךסמףעÞיֽ‏–גףצÊמÞך–יÝךץיÝ‏–יהךֽיץִסמÞמאד׀מÿבֿ‏Ýזֻ”‘ßמלוßמגסצ׀בגßֱֿ—ֶהצװפמ‘ָ–ְהענאװךגמÝּׂבֿÊאמ־׀צמפגֿוצעבןצֶלהָז‏ג׀ִֿמצִעב׀מדבז—ֿאׁ’קִפגעדÞגומפצ׳גßֵזךפ”ˆˆ׀זסˆ׀ָהÿצלÞזהמזּזזזזזךו•׀אßזזזזזצזסזזזולְלÞזומזלּזֹהְגוזְבלזזגהזזמוזן“זזְמָפ׀ךוזזזגÿצזגוהִגףוגףג־‏צוצְ‎לÝִÞיֽ‏–גףצÊמÞך–יÝךץבו‏Ýבפגסןץָםהßמֽײֽעעמׁױמצִעב׀מדבז—ֿאׁ•ֿמומֿזקˆˆזועזזזגײז‘צזמְהפזזזוו׀ןְˆעזְׁזאװ׀גוֽׁךױˆˆזבצזזז‎“הװְז־זםמזזזזדזֳצהמצזזˆˆזבֱלזפָהװְז־זםמזזזזדזֳװון׀זזזזגזג׀זזזףמהװְזֶזדסזךֿךוז׀צ‎אוִנדצ׀כהְְזז׀םלזזךגזזצדזן“זוזצָפ׀מוזזזוÿצזוזפִוףומײגץגץוצְ‎לÝ‏נךßעֿיףמ•יֽע–וÝע”יףצÊמÞך–יÝךסיßעןגֱ׀עמׁױןץָםפָּכג־טײיפ׀װךßמֿמצִעבךׂק־־בז—ֿא׃װֵקֿׁְׂזזזצזףזזזדְּן־זגעזע—וציזגדדד“”מßזגזזװהפְזכז׀זדה׀וזז׀ךלעװןזצךדדסטזצ—יךעװלהז‏גזְעזזזבֳהצעהזצגֹזעßהצד׀‘יֽעÝךפװײלפְסםֿגץב־עץגץמקהו—ױםו‏נךßעֿיףמ•יףע—ם־ך־וְִץבו‏נךßעֿיףמ•יֽע–יה‏ֽמְ‏ןגץצנךßעֿיףמ•יֽעץיה‏ֽמÝע”ךßעÝיֽ‏Ýךֿ‏ÿיֽ‏Ýךֿ‏סבצי‏הוְֶˆׁעְג־צֿמהְןוßע‏ˆׁ—נבז‏ֿמו‏ֽאֿצ־ˆׂװֳאְּכג־טֻיצגֳפÝְ•ץ׀ÿפÝֻקסד—עההגֿגץÝ׀טדגױםֱבֿצממפגןגֿף׀טףזסאׁֵמומֿמצִעב׀גװבז—ֿאּמֿלהְּםÞסיסװזזצזףזזזהÿ׀ן־זה׀זצּזˆמְגדההעץזְזןזָּזו׀ךזז׀ִזְֱזמההֻכזזךדהסזהצּßפ׀‏גזְךזזזבֳוצגוזפִוףהָָג־‏ץגץעÊגץגפהְְֳלÞצנבֽךסמףעÞיֽ‏–יףצÊמÞמאוßגעבֽךסמףעÞיֽ‏–גףצÊמÞך–יÝךסךÝ‏•ךÝמסבצמֻהוְֶˆִׁנבז‏ֿמו‏ֽאֿצ־ˆׂװֳאְּכג־טֻיצגִפÝÊÿקץצממפגןגֿף׀טףזסאׁֵמומֿמצִעב׀גװבז—ֿאּמְלֶףױˆˆזג׀זזזֻה’ְז־זםְזזזזהזֲוזקˆˆזוךזזזםֱזװגזמְה‏זזזזז׀ןנזֽגזזקˆˆזוקˆהְםֱזֲמזמְה‏זזזזז׀ןֵזְֵזזקˆˆזוךזזזםֱזײזמְה‏זזזזז׀ן‎ז־׀זזזזהזו”ˆזמְזֲמזה׀זÿזהßזלצזהזְוֱזזזזךעװבזצךדזסגזצגוכ׀בךדז׀זזז׀ÿדו‏פגזזכזזָּוְְסלß‏Êיףצ•ךÝמנבץצאמÝ‏•יףצÊמÞמאבץצנך’ßˆְ‏טוֱֹ‘דךהָָךÝג׳לףךךֲֹßֲֹֻְֱָֹÿ•ֻ‘ֵא–ִׂÊןˆˆ׀זֳˆˆצהמזכÊזהמזֹצזזזזךו—ְמצזזדˆˆ׀זֳˆˆצהמזכוזהמזֹצזזזזךו–צמ‎זזדˆˆ׀זֳˆˆצהמזלÝזהמזֹצזזזזךוÝ׀מ׳זזדˆˆ׀זֳˆˆצהמזכֽזהמזֹצזזזזךו—צמדזזדˆˆ׀זֳˆˆצהמזלעזהמזֹצזזזזמו‘נךזזזךזןֱˆ—ז־זו“ְזףזו׀זםצווצד“צזצצדמ־גנבץךםוְִבוזםלזזךדלעװזוזצהÿ׀זהזֽבכזזגום—װאזצעבזבזזזזׁזג׀ֳןץ—ֻןפצÊג־עפמ׀ִמאפװזבץצאמÞמֹוÞך”םֽע—יֽךÞבÝִÝו׀צÿיÞ‏ÊמÞמאבץ‏•יףצֹוß‏נך׀מְֱָיױקֿ—‘יףֲוְ–ז”דÝּֿˆׁעו׳זװּןדג׳־Þָבײְְָםְב’ֽÿ’‘לפךˆקÿץֲִֿץםָי׀־מְֵנףÿ•ּךװָ“ךˆˆˆזו”ˆזמְזײזמְהֳזזזזז׀ן‎זֿמזזזזדזו”ˆזילזֲמזןזזײזדמזס—ועב׀גםוְְןזְגזדצגןזצילה׀גםזזזוהצוֻהזגאוְץֱוצגגודבכזזגוזֻדזצמהכ—װלזצִןזֻדזצמהכ׀םךלÞװֳןפװÞלÝמ׀כֿ—ײןפּ׳מ־צ־םהךצדזְֵלÞעֿןְמÝךִֽÿוְ‏ֽמ־ִאמÞמÊיףצ•ךÝמÿיֽךÞבֿעגי־ִ–יפ‏ÊמÞמאבץצנךÞע—ם־‏ֽמְ‏סז—ױ–ְמÿכÞ‎ֲלÞצ‎נסֻÊצעֿÞִ”וֳֹםבצÊםִָˆ“אלְגולדגÞלפְÞז‏עכאßְֽמֻׂבףÞיֲגף׃צקדßֲֹßטד־וֵ’ִּזמדֵÊֳ׃ִא’ֽּֿטמע’׳זזמזגׁ“זּךו“ְזֱזהװזÿגו‎אזגןוץװווזִ׳לזממוזִוזזְגפְזגו׀ְןוזֿזזעבלעװזו׀ִאÿ׀ּווְ‏ßפ׀ָוהזְזÿ׀זזזהכז׀גוזצםֳזזמהל׀םךמהזזזהזױמהָֹםצזֱזו“פםֿגץבהצכהוָױזו‏סבז‏ֽמ־ִסבו‏Ýבפג–ךֽ‏•יץג—ם־ךֽיףִÝבףך•יֽךהיֽ‏–יה‏ֽמְִץבֽךו•ÊÊבֳÞֹבהכ‘ß—ֶהצװפמ‘ע–זץ’וךוֹּג־ָׁל־ְÊל׀ן־ֲÿיְֿ’”מומֿמצִעב׀ן—בז—ֿאֽךִןׁ“Ýלס׃צ‏א‏ßˆױ—Êזזזהזודˆטזםוזױמזןְזײזבֻזסְֿווזעָםßװדהזִןזצזמז—ָזוזעאוצצאְֱזבופֿכזזִןוֻםזצ‏אךעװלזצְמזבזזזזׁפ׀ךוזצגהÿצזהז־װהףוֱזזזֱלֿ׳ם־צזןְזֳג־‏ץגץצּה׀ְֶל׀זנבץצאמÞמֹבץצנךßעֿיףמ•יֽעץיה‏ֽמÝע”ךßג•יֽךהיֽ‏–יה‏ֽמְִץבֽךו•אÊבֳÞֹבהכ‘ß—ֶהצװפמ‘ָ–ןעזׂאפִפל־ײלה‏ױזֲם’ִ”Þאדְִֹג־גֿוßצÿזװװעדפגֶˆֶָׁןק“Ýלס׃צ‏א‏ßˆױ—Êזזזהזו”ˆטזםטזֲמזאְזֻזגםזקß—ִב׀װגו׀‏ופְזבופֻכזז‏אובזוזצßפ׀ְוו׀ִדÿ׀זדזÞכזְגזזזבֳזזגול׀בךאßװֵםץװּםץמּםßגץגְּמאÞװגבֿ‏Ýבפג–ךֽ‏•יףעֽוְ‏ֽמ־‏–יד‏Ýךִֿ”ךßגÊיßגÊמÞמאבץצנך׀מטהִָֿˆׂגֳאְּדמגזײÿנ־זֳסגßץףÿןלהצ׃ך־׀ׁכמװעההגֿוßצÿֹß—‏ֲ”וֿפװּˆֵהֳיצבבן•םֶֿ•װזזצזףזזזוÞְןֱזהּזֶ—זלמ׀גוו־‏וזזגהפּׂ׀ה–ו‏צהזזזזגהזצו׀וצגוזצ‎ֱהזִהוְ‏׳פ׀צוזְמדÿצזדזÞִדףו׃זמצזזזצמוזזםוצגוזצ‎ֱהזִהוְ‏׳פ׀צוזְמדÿצזדזÞִדףבֻזגזזזזהּזלומÊגץגÿבÞצםהוװױזו‏סבז‏ֽמ־‏–יד‏–יהך־וְ‏סבץצנבֽךסמףעÞיֽ‏–גףצÊמÞך–יÝךסךÝ‏Ýז‎ִÝםפְִלז—לגהגנהß—ְˆ׃ֳּאְּכג־טֻיצגׁעְןֱכÞּ־ךהמֲגֿךהוֽיןןכּנבזְֿמצִעב׀גװבז—ֿאֻֽזקˆˆזוךזזזןלזׂ‏זמְה׳זזזזזְןְטצדˆˆ׀זףזזזוÞְכוזהמזײצזזזזמו“־“זˆˆזגˆלזִָו”׀ז־זלּזזזזדזֳװולזזזזזגזןׁˆ—זֶּו“ְזÝזמכװה–צנגז•זזעבלעװזהזְגÿ׀‏ווזצßפ׀זןו׀ץֱוְגגודבכזזזזם—װזזְמוÿצזוזפֳכזזךדהסלזצּםכ׀ֻךא—ז’זזזדזצךזזÿ“זוצע׳פ׀זמהזץֱוְגגודבכזזִןובאזצצגךעװזזְמוÿצזוזפֳכזזךדהסלזצּםכ׀ֻךנעזפזזזזך׀זÞמץגפמÞװ־גץגֽה׀ְֳלß‏ÊםÞ‏ֽמְִֽםÝךנבֽךÞיֽע—ם־ִֹם־‏–יד‏Ýךֿ‏ÿבֽךÞיִֽÝבÞךÊמÞמאבץצנבßִנבֿעעו־טלץעסה׀“כא׀ּּהג—לּֽ־ם—ßאצנ‎‏ןהמנג׀ָלהְךֵוÞגֿÿÞִ׀כÞּ’פÝײ‏ְ׀םו׀ִכָּילםה‏ֶמזָףגִּ–ץ–ִןו׀ִםה‎ם–םץ׀ֳא׀װקבגע”ףסˆˆ׀זֲˆˆצוײצכÊזהמזױצזזזזמו“הּזˆˆזןׁˆ—זֶּה׀צז־זל—זזזזדזֳ‏ו”זזזזזגזןׁ–זֶּו“ְוךז‏ֻזג׀ךווזגקזצךגדְגהז׀ילא׀גגזעֻכװז׃צנגויזזגזוזךוִזזגז׀זגְֵזכהÞֻכזז“טהֻךזצָלךעװזדצ—לÿ׀׀והְָßפ׀זאו־ֳכזזְמו–—זו׀ִֹפ׀זםהצוֱוצגזזהכזזךדזÊזזזְמױזּ׀ֵפזצעבֿזףְזוזזצזזצץזזצדזזץׂזזװכלעװזדְ“לÿ׀׀והְָßפ׀זידצ׳ֱדזגלהֽבכזז‏אם—װזהזְןÿצזןוÞֳכזזּםזבבזצזזכ—װזז׀ךה‏זזהז־װהףו׃כװה–צנגוקזזגזוזזוון“זוזךזוזיזזװכלעװזדְ“לÿ׀׀והְָßפ׀זידצ׳ֱדזגלהֽבכזז‏אם—װזהזְןÿצזןוÞֳכזזּםזבבזצזזכ—װזז׀ךה‏זזהז־װהףו׃זעְזאהצִםוְֳזזגזוזזוון“זוזךזוזיזזװכלעװזדְ“לÿ׀׀והְָßפ׀זידצ׳ֱדזגלהֽבכזזְמו–—זו׀ִֹפ׀זםהצוֱוצגזזהכזזךדזÊזזזְמױזּß‎נסֻזאגיוצדקףװ’יֽצ׳םßגץמֿצּמÞצֽגצמןפװּוְִןיֽ‏Ýךֿ‏סבז‏ֽמ־ִ”בֽךÞיֽע—ם־ך־וְִֹיÞ‏ֹם־ך־וÞךֹךß‏נךÝמ•יףצÊםÞִÊםֽע—יֽךÞבִֿנךÝמ•יÝךÿמÞ‏ֽמְ‏סבו‏ÿבß‏נבצא׳ÿְֻעוßִךןÞßציְֽֽג־מÿגß—פגצָיזץגÊםפעסהְ“כא׀ּּהג—לּֽ־ם—ßאצנ‎‏ןהמנג׀ָלהְךֵוÞגֿÿÞִ׀כÞּ’פÝÿÿצעׂזְךֽמה—ֹדÞ‏קגßצצג׀ִוהבזהדצִכָּילםה‏ֶמזָףגִּ–ץ–ִןו׀ִםה‎ם–םץ׀ֳא׀װקבגע”ˆˆזןׁלזֶּו“ְז־זל—זזזזדזֳװו‏׀זזזזגזאˆˆ—זÊ—ה׀זובזםבכװז׳צנגז’זזָדהזךלהן“זזצִגזְב׀זזךדהסזהצּ׀פ׀זןו׀ֳֿזזְמלעװאזצצגוס—זוצעֹפ׀זהזְוְזזזזכ׀וךא—ז‘זזָדהזךלהן“זזצִגו׀גגְֱזדז׀ֱֻזזּםךגװזו׀ִמÿצזמההֻכוְגגוזסֳזזעבם—װזזְמז‏זזזזהזףבֻזגגזˆקדָץבוגץבפָםהצכהו—ױםו‏סבז‏ֽמ־‏–יד‏Ýךֿ‏סבז‏אבץצנךÝמ•יףצÊם־ִÊםֽע—יÝ‏–יה‏ֽמְ‏סגץצנךßעֿיףמ•יֽעץמÝעÝיֽ‏ÝךֿעעוÞ‏אבץצנב׀מ•י•ביטעךְאßֱִוְ—עדוךעםפ—מי־׃ּד־ִָל־׀צןק–ןץָםצגזבֲןÝפגÞִםהֵßץפ“ףףצֹאפעֵאצ׀יד׀‏כהÞךִם־׀ְופ‎ןםִֻÊמÞ—י—ץֶˆֻמְג־גֿוßצÿזנמֲֿÿא‎כהזוךפְֲלß׀זזצזכˆˆצו‎׀לעזוּזק—זבזגגזועווצצהפְעוזְבםזזצזוצזגוÿ“זזצגÊפ׀ךוזזזהÿצזהז־ֻכוְגבופבףזזזזוּזאהךץגץעףו׀ְ‎לß‏Êיץגֽיף“היÝךסךßעֽגץצנךÝמ”ב׀“המ“’אקפֻצקז׀ֵÿב׀סאß—ֲבצךֹצהִךפ–װואÞגגטֻעױׁ־ן•דגׂאץדןץצזˆˆזהˆˆ—זְִהָזז־זכךזזזזדזֳצהפ׀זזזזגזהˆ–זנִהֻזז—זכוזןÞָוו׀ךױבצממוÝגוזְּמזצגהו׀גזזצסלא׀גבבזגהזֻּכװז׃צנגז”זזִדהזךןהן“לזצּמזְגםִזזהזצְהזÿ׀זוזצÊפ׀‏וז׀ךבÿצזבופֻכזזְמכ—װזזצגז‏זזזזהװזףו׃זטזזןז׀ְדו׀ֿהְגםהזממהצםזזמוהזמוֱזזגוה‎כוְגדז׀סֳזזעבלעװזהזְׁפ׀זוזצוְזזזזל׀וךנעזפזזזזיזזÝםפךץגץע‏םהךּה׀ְֳלß‏נבץצאמÞמֹיß‏Ýךֽ‏–יה‏ֽמְ‏ןםÝִÊםֽעץמÝעזִֽÝבףךסמßגעבֽךÞיßִטז־ךֽוÝ‏•ךˆ—װעד‏“מßמ־בßךֳגֿגלדצגץלפ׀װקפֻצקז׀ֵÿב׀סאß—ֲבצךֹצהִטבזִÿדדצֽמה—ֹדÞ‏קגßצצג׀ִוהבעךףגְואÞגגטֻעױׁ־ן•דגׂאץדןץצ׃זְךזˆˆזהˆלזנִהֻזז־זכךזזזזדזֳװוטזזזזזגזגˆˆ—זֻו•׀זּזד’זטÞגפזְךגא׀‏הוצךהפְ‏וז׀צבוזךבְֱִווזצ׳פ׀זזזזבֳזזגום—װזוצעהÿ׀זהז־הףומֻמßמּםוגפהזְִלÞצנבֽךסמÝעֽוְ‏ֽמֽע–יה‏ֽמÝע”ךßגעבֽךÞיִֽץיה‏ֽמÝע”ךßגהםצְנןיצוןגװ’ֻ׀װפמ‘ְ”מפזנמßָכג־טָיÝגךוהגמהÊּ’ßצימץױׁףּ׀בץָומץצימץױ‎ֱˆˆזוקˆזםֱזׂ‏זמְה”זזזזז׀ןפז־ָזזקˆˆזוקˆזםֱזװגזמְה”זזזזז׀ןסזֽךזזקˆˆזוקˆזםֱזױךזמְה”זזזזז׀ןקזּךזזקˆˆזוקˆזםֱזׂךזמְה”זזזזז׀ןץזֿ—זזקˆˆזוקˆזםֱז׳צזמְה”זזזזזְן׳ֱצזזזצזףˆÝזהÿ׀ןֵזדִזע—וצכֿהוזעָג׀מאוזּמזְזדז—ָןזצצבוְעגוֹ“מזצעבלעװזהצּהÿצָוזְמֹפ׀זאוְיֱזזךדכ—װזזזזוÿ׀זוזףךוףדִ•יףצפםפךפםהצסםהצכהו—ױוז‏סבו‏Ýךֽ‏”ב׀‏ֽמ־‏–יד‏”מÝעֽוְ‏ֽמֽע–יה‏ֽמÝע”ךßגעבֽךÞיִֽץיה‏ֽמÝע”ךßגעבֿ‏Ýבפךוהֶבְעהß‏ָפÝזׁצÝֻצזץßכט‎ִכג־טָיÞגְב־ךֶהßמֽײדִמבֿßיבהֿאוְךדßםבךפגײטו׀מהÊּ’ßצימץױׁףּ׀בץָומץצימץױ‎צךוהןˆˆ׀זףˆˆצהÿ׀כסזהמז׃׀זזזזךו•זא‘זזזזזֱˆ’זזזוˆְןנזוװזלגזֻדזּהוְזופְעדזְךזזזבֳוזגוזפֻכזז‏אם׀‎ךגßגץלפגץגְִמאÞװףם־‏ֽיפגסמÞמסבוִÿךÝִ•יףצֽמÝעÝבפמאו׀ךֽךצּÿאזגפלץצד‎זםָזßצֻּוִ‎הײֿןז‎זנדÞגֿדְעמˆּאוֿגֿמץז‎ˆֹצזזזןˆצזזזׂךו–ְזֽזה’זלÞזצדזּגו׀זופְ‏גזְךזזזבֳוצךהזצג׳פ׀ְוו׀ִֹו—׀ףגßגץםֿ‏ֿגץמםהו—ױגÞ‏ÊמÝעֿבפך־בץצÿבÝךףךßךÝיÝ‏–יהךֽיףךסמְ‏ןזÞךדמ׀ךֽלְִעבְגדןועדק׀םֶֹֻ—הקְךֶג’ז‏אצֲוק”‏בְדוּוִטמפגפוְֶׁזץׁ‘ְֳםוֿמֿמץצסˆֹצוÿˆ‘ֿזזזוזזָזזזמ“זֳ‏זיזזצדּÝםּֿטה׀עזוְבלה׀ּמז׀‏או–—לזצִןלעװבז׀מדזזזוÿצצוזצגֹזע׀׀כÞ“׃כהָֿגץ‏ץגפּֿגץגךהו—ױםו‏Ýבפג–ךÝמ–יהִֹו׀‏סבו‏Ýךßעֽיףמ•יÝִֹם־‏ֽיפגסמÞמסבוִÿיÝ‏–יהךֽיףךסמְ‏ןוßִוˆ־זֶˆ׃װ‎בזֳקעְִכהֲֿÝןÞָעֵ”װךןו—וןץךסהÝ‏ˆו׀“ÿֹßָדסֲייוךֿמצ“םהֹֻ–הְָמהפגֿגßÊיׁומימפגטדזצÿצָןהÞגֿדßב“—זזוˆˆֹˆכזןזֳ‏זיְוױ׃Þ—ײןְךהזזבלפזםעבֿזמצזהזזךדזֹזןוְצדזזזבÿצּמזְעבלעװזז׀ךו‏זזוזףךוףו׃זמְזהזזךזזְיו׀‏גז׀זזוס—םהזמבופֻכזזךדזנזזזצגÝזעß‎צוגזזזז•זד‏ױמץגÿםÞצָגצָמןהװובפמאו׀ךאו׀“המÞמÊיףצ•ךÝמנבץצאבץצנךÝמ•יÝִדכְמֽיפגסמÞמאבץצÿבÝך”יֽע—ם־ךֽיצןבץָקÊ׀װלאהך•להּםß“ֱםוגםהזװֽבונׂהז—ÿאצגֵןצּכז–צדÿזךכהֿ—ו–־גסמׁ‘טאץ׀ץהװ’לו׀׳םו׀ץבְ‏םהÝגßיזאֻבוזבמפגלהְְם”ׂעאוְְלמצדˆˆˆˆ’ˆÞ׀ו׀כÊזהמז׀ְזזזזךו—ְןײזזדˆˆˆˆ’ˆÞ׀ו׀כוזהמז׀ְזזזזךו–צןÝזזדˆˆˆˆ’ˆÞ׀ו׀לÝזהמז׀ְזזזזךוÝ׀מדזזדˆˆˆˆ’ˆÞ׀ו׀כֽזהמז׀ְזזזזךו—צןֳזזזזזצזפזזזו׀צןנזומזֻעזלהצגוזזזוז׀צהפּׂ׀הסו‏צהמזזצזגזזב׀זזצדז׀ץׂזזזזזֻ—זזְמ׳פ׀זדז׀סֲזזעבם׀סךא—ׂ׀ה–ו‏צהךזזצזגזזב׀זזצדזזצדֱזזזזזםֳזזמהלעװזז׀ךבÿְזבופִבףו׃זםזזוזזצזזצץזזצדזזצדֱזזזזזםֳזזמהלעװזז׀ךבÿְזבופִבףבֻ‎צזּץגÞמץג־גאהוָױי׀גֽמְ‏ןמÝִֿבצגÝךֽ‏•יÝךןמץמוזסז—פצָֿה׀אכˆׁםטףװֽגהגכˆֻßאזÿ‏ׁץמ—׀ˆֹענטÝ•׳זקˆˆזומזזזןוזׂ‏זמְדןזזזזזְןְך׀דˆˆ׀זפזזזו׀צכוזהמזß׀זזזזךו–ְןÊזזדˆˆ׀זפזזזו׀צלÝזהמזß׀זזזזךו—זאפזזזזזצזצזזזהֶ׀כוזד—ז־ּׂ׀ןֻו‏צדמזהְװיה׀ָיְֱזכה׀ֱֻזזּםךגװזדצ—׳פ׀ִוז׀ךמÿצ׀והזְ׳פ׀‏גזְךזזזבֳוצגוזפִוףו׃זיזזלה׀—כהְ–זז—מה׀—מֱזזכה׀ֱֻזזּםךגװןזצךדהב—ךזצְמלעװאוזמדזזזוÿצעוזצגֹזעß‎צו‏טÝָ’יֽצײלהצ־גץצץגץצÊגץגץדְְֳלÞצנךßעֿיףמ•יֽעץיה‏ֽמßגעבֿ‏Ýבפג–ךֽ‏•יץגֽיףך–יד‏•ךÝמנבץצאמÞמÊיףצ•יÝ‏•יףצÊמÞמאבץעÝיÝךץזֽעעמׁױןץָםהßללדו־ˆ׃צֳאְֻזצד’’סבץ‘לפצֿם׀׀כוצְ׳ן—װ•‎‘ְ”ךßמֿמצִעב׀בובז”ִֹֿעוÞגֿוßצÿזנמֿןד–ֳיף‏‘מפָֻןוגעהְעלוְ“טע—“׀גק’׃זזגזגזזזזÊה׀זזׂזגֳזץזוזְְופְזגוהֿכזזְמז–זז׀ך׀פ׀ָוזצגהÿצּוזְמ׳פ׀װןוצךזזז‎ֳדזגאו־ִאףה“׃כהװֹם־עּםֿגץגßךֽגץצצדצְֳלÝִÞיֽ‏–גפך–ךÝע—יֽךÞבִֿ”ךßגעבֽךסמףעÞיֽ‏–גףצÊמÞמאבץעÝבפךץבו‏נךßעֿגו—ֶהעוזֵÊְױףß‎ליץִֽˆׂךֲא׀װׁלפ“ֿס–ִךמהק—־גןבוִו‏־ג׀סא‏‎גßָץףמפגןבוִוָÊבץיÝ׃ֱמֱ‘ֲבßצןמצזזזְזנזÿְוÿצלְזהװזיזזˆצד׀סד׀מדז־׃זְעדוְגזוצילזזךהוצמדוÿ“ןוְמבזצגזוצוֽזזמהובזוזץנזּ׀װכה׀—כדךסםה‏ָםהממהָֿױזצ‏אמÞמÊם׀‏אמÞמÊיףצ•יÝע—ם־ך־בץצנבץצאמÞמÊיףצ•ךÝמנבץעעבֽךÞיִֽאיÝע–וְ‏סבדךוÿץעּאוְֱוßךױןÞ‏–נסװצאדמפאץצעאּ’םטףִכדז‏לז׳—צםÞְֹז‏׀להְ׀ץדץזֳמ־•ד־—ֱבֿךדאצץבִֿףמפ“ּל‏“‏גְצווז—ןנ׀ְָאה—זזְזעזÿְוÿזלְזזװזב׀ז׳צה‏בזצךגזצגדזנךזזְמזÿ׀זזזב‏הףז׀ךזזזךב׀׀נגֿזזה׀זלםז‏לבפװפםֽע—יֽךÞבֿעעו־ך•יֽע—ם־ך־וֿעעבֽיװנב׳ךפ–ֳֶפÞזסבß“ֲבץֲִזÿֿצצ—ץץעגיגעץצק—ץוקדגצצזוזוֹˆזםװזֳ‏זל׀זאװÞְלזףזױזצ‏סבדךÞיִֽÿוְ‏ֽמ־‏–יד‏”מ׀‏או׀‏אמÞמÊיףצ•יÝ“הי׀‏אוÞִ•יֽךֿבצןױאדעעאץִטג–ג־טÝצÿבְֹהדזָיטףגֲןצפןÞגףזֽװןßְֳ‏נזוֳצב–‎Ê‎װוצװֵאה‎הפעבÞצ—ֹֿץע׳דןוּףםץְײקֻץזזְ“נבףךˆ‏ֱˆˆזוˆˆזםֶזֻ‏זמ׀ד‎זעָזזזזהזיּזזקˆˆזוˆˆזםץזֻ‏זמ׀דֲזף‏זזזזהזיּזזקˆˆזוצזְׁםעזֻעזמ׀דֲזףּזזזזהזי“זזזזוזוÿˆזן”זÞזזפצודצז’םטֽג‏וזמוכְךהזזמהפּׂ׀לֻו‏צוזזזצמוְ׀זהזזלדזזזזאצוךא—זטזזגהז‏ךזזְזהְ׀זזזןץ‎׃—סגמוֶז׀ִסל׀גאוְִÿבֿעעוְ‏ןמÝצÊם־ִוםֽע—יִֽ”יֽע—םÞִÊיףצ”ךßעעבßִנבץצןו׀‏סבוִÿיִֽ”םÞ‏Êיףצ•יִֽÝבץצנבßִנבֿעעוÞךÊם־ִֹזְֶףדְגֻכְ“סווךטבְֱ׀Þמֹןּ“‏הץִָבוךיךפִָטוךÿױזךֶג׀“ָןֿךפזֿךלבףגִאו‏םז׀ִךבזבְמדךֶלדך’אה‏ֻהזװעאצִונ־‏ײםÝְפכְםוְגאו־ָּל׀ְכז׀׀ללד‏ֹיßך‏אץײבÞז‏זְ‏װםהעם׀‏יגצדוְצױםÝִהצ‏הז׀זוזהקˆזמצזֻעזעצוˆצוםייפךדוזיץךְָדזְצהפֽ“וז—ֿכװוסצנגזנזזךגז“ךזוזמגְ׀זהזְוֲזצגזזוּזףו׃כװה׳צנגזֶזזךגז“ךזוזמגְ׀זהזְבֲזזגואעװזזזז‎זג׀ֵצוָזז׀צדְ׀זגזְפדזזזוזמצזזְמוÿְזוזץּוףבֻ‎צז׳םפה׀ױמץ“סוצִÿלÞענבץצאוÞךÊם־ִוו׀‏סבוִÿבֿעעוÞך–ךÝמ•יףצֹםÞ‏–יד‏”יÞִÊםֽע—יֽ‏”ךßעעבֿ‏ÿבÝ‏”יÞִÊםֽע—יֽ‏”ךßעעבִֿÿבֿ‏סבזִֽם־‏ֹם׀ִאוְִו—־װפבוךוה׀ßגץוÝ‏‎ה‘ִפה׀ְאהצעעא־זׂגצָץבזצףהצג’׀‏סג׀“ָןֿךפזֿךלבףגִאו‏םז׀ִךבז‏ץדְכמכֽ׀‎כ־ךלג׀ומו—ֱבזכנÞָּאץצֿהצװטןדזֵדßְ–לףךÞג־ךפאפײהז‏םדץזבßךֶאזמאכהצֻקפִאדץגקז׀‏גלÞִ”קזּאזְךלןה“‏זזגזןְזזזֳִהסצזֲזג’כװו׃צנגזִזזמדז׀םׂזזגוז–—זז׀ך‏פ׀צוזזזבÿצזבוץּבףו׃זא׀זהז׀לדזזגוז–—זז׀ך‏פ׀צוזזזבÿצזבוץּבףבֻזהץגסךßע•גז‏ןא־װ”מף‏•יףצÊם־ךֽמ־‏–יד‏”ךßעעבֽךÝךֿ‏סבץצןך׀ִֿקזגָגְװךמהאמßנהֿךיה׃מׂךßßזןׁ’ֻׂהעÊן־זְדפְ׳ךענבְ׀ייהףקֽײ“זזגזבזזזזנּהסצזָזהיזמה‏וזְזופְזוזזאדזזזזזֻ“דזצמהאצםךלהִֽמֿ—ְוזִנלÝִÝךֽ‏”יÝ‏ÊםÞִÊםֽע—יִֽÝבץצנבßִנבְִןוֿ‏ÿבִֿנבץצןמÞ‏Êם׀ִֽט‏זֶב׀מדזצףעß—סגßצףדßֳיןְֿההזמצגץמןד׀‏ףה־צ׳קלÊ“ך־מ—בץגדדזעֶמהסןיצ“ץדצךכוו“ֹֽהגׁמהמסלפְםÝ–במֶךזזזגזבקˆזְֵהסצזֽזבל•ד׀ּהזצזופּׂ׀א–ו‏צוְזז׀צגז•“הזצזזוב—בזצצגאגװזזצג‎זע׀ֵצוִזז׀צדְ׀מוזזזגÿצעווזצ‏פ׀זוזץּוףבֻזדצזזזהךזמץע“לוךאוßְױזו‏סבפךאוֿעעבßִנו־ך־םÝע•יֽע–ידִ–מÞמÊיףצ•יÝךסבדךֿזֶּקכֿ‏צזצּהמו—םדְעביׁ‏ױםßעלגßוכ׀מÊדֿפנןהִֿג׀ֿׂלפ‏ההזְֶמ“ִיְמֹךפßטבץזֱזזמזיˆˆזֲעהסצזֽזד‏ז‎ּזיאצגזז־“ֻן׀גגז׀צהפּׂ׀א–ו‏צו—זזצמהזנ“זזזזהÿצזהזֿֿכזזצגז–בוְמדזßּדףו׃זןזזוזְאדזזזזזֻ—זזְמ‏פ׀זגוזיֱוצ‏הז׀ך‎ז—ß‎צוזזזד‏–כהװזמ׀ז־ךßצ“ו׀ִÿל׀צֹיף‏•יףע—יÝעֿמ־‏–ידִÝבץצנךÞגÞבֿעסו׀‏סבוהבז‏ֽמהִ–יֽע–יד‏Ýךִֿסוְ‏ÿבß‏אמ׀אפדז‏דןˆֵלÞֱִג׀“ףזףטדְּקזְָומו”ױְ“לןßּןהצְגזצּהמץװגזְְלב־נעÿÞ“הםףיהףצװסד׀ךּז׀עצפעסֿßגÊםְךןהֿÞקכֽךדוְ‏סגלצֻמ׀זוזוˆˆזגצזֻ‏זןְזְצו—וזצגזזעָזזזגזְ׀מוזצג‎זע׀זזזזֲזו—ץגזךןבהװנםÝע•יֽע–יה‏ÊםÞִÊםֽע—יÝךסבו‏ÿבß“הבßךנו־קידְעגוֿמףסßִץםßךכדְֵּאְּהבצמֶמזצההזְ‎םי‏ֲןז׀דדצצֱןדֿדוזצזְװגגÞך־ˆ׳ְׂכ׀דˆˆˆˆקˆˆ׀וגזלזהמז•צזזזזמוˆם—זזזגזןׁˆזצהסצזׂזו’זאÞזנהְ‏גזזגופְזוזזאדזזזזאצוךלפְסג׀מןבהװזבץצאוְִֽם־‏ֹם׀‏סבוִÿבֿעעו־ך־םÝע•יףצֹםÞ‏–ידִֹכְמ–יד‏”ךßעעבִֿÿזצצדְמםזְְךםְצםםצעֶאזָטו׀‏‎הוָ־ןß“ךבֿגףהßץסזֿב‏מה“‎ז׀ִמזְ‏נבהצֹֽוִקאß׀ההזװצדֿß׀םץ׀“י׀‏בדß—ֵם—ְ׳דץזקז׀׀זזזגזקקˆזֱצהסצז’זד׳זי׀ךוזצעֽד׀ּדזזגהפ־׀וזצבםזזצבומךדזצגווס—אזצעבאגװהזצזזאצוךזזזזטצז”בו׀Êל־׀ןוßּױזו‏סבצִאבץצֱזֿצאמÞמֹיף‏•יףע—יֽ‏”יפגטזִֿÿב־ך־םÝע•יֽע–יד‏•יÝעֽמ־‏–ידִÝבץצנךÞגו’ְ“םד׀מלזפזֳה׀׀אז׀ךהֱ–זץצךזצ‏דקצָךוצענגוךםמ־ֱּג׀“ףזעּהםְךּז׀עצ־‏סֿץגÊםְממהֿ‏ֻּÞ׀אז—הזÞֳום‎׃ןזְְמגֲֹֿמÝװ‏אצגÊךּםיהßעקזזזוזהךזזזמזזֻעזיְו”׃־ךכזְמגזע׳כװה׳צנגזײזזגאז‏ךזזְצבוזמבְֱזבז׀צבז”׀זוזצאÿ׀ִווְ‏‏פ׀זדז׀וֳזזזזאצוךא—זָזזגאז‏ךזזְצבוזמבְֱזבז׀צבז”׀ןזצ‏זוזמאואִזז׀ךזÿצזזזוּזףבֻזד׀זזזד‏זיץךּאוֳָבצְןא־װזבֿעעוְִֿם־‏–ידִֽם־‏–יד‏•יÝךסבו‏ÿבß‏נבץצןמÞ‏ÊםÞִאבץצÿמף‏–יה‏ֽמְ‏ןוÞך”יֽ‏Ýזִִ’םפˆ—ץגÿב׀ך׳ןץמפזßךךגÝזֲבֿ‏םז׀ִךבצ׀יזפִץם־—ֶיצ׀ןאְְקקד‏הךָםײף‎ץֻפמְִצעזבכפךֻטÞּןדצקז׀ִגכפע“קזּןזצך׳כו’וכֽצ“כßִגדיְֶ׀זזזצזעזכ“וא׀םסזוװזטֵךֵזצוןפזֵעבֿזגצזוזְמוְֵזזזזםֳזזמהאזוךא—זצזזגהז‏ךזזזזהÿצזהזְֿזףבÊ–ךֿע—ז׀ִÿלÝִ•יףצÊמÞך־םֽע—יִֽÝבץצÝךÝמנבß‏נבץצאוְֲץעֿ‏ֵףהװֹבצָףן•ךֱמצ‏בההְ—מְֳ•יוִסםÝגװףֿעצןßָטה—ֵָצבצױגצזוזוֹˆ‏זןזזֻעזמזוא׃צגוז׀זופּׂ׀א–ו‏צו‏זזצמהזנ“זזזזהÿצזהזֿֿכזזךדאְיךא—זסזזגהז‏ךזזזזהÿצזהזֿֿכזזךדאְיךנֵ‏‎ךßצ“וזִ‏ל׀צֹיף‏•יץג—ם־ךֽמ־‏–ידִÝבץצנךÞגÞבֿעעו׀‏ÿגß‏אמ׀בדְעגבוֹֿלÞֱִג׀“ףזץצ־ןז‏ךזֿזהאפאְזְְמאפצוֽֿ—עםףיהףצװסדÞגׁדהצ”ךׁ’לÝזזזזגזןְזזזִ‏הסצזְזג׳כװו׃צנגזֵזזמדז׀םׂזזגוז–—זז׀ך‏פ׀זזזזץֳזזצגאצץךא—זֶזזמדזָךזזצגדÿצזדזßֿכזזזזוב—זוזצ‎וגß‎׃ÞּÝבףצְוצִ‎לÝִֿךֽ‏–יה‏ֽמÞמÊיףצ•יÝךסבו‏ÝךÝמנבß‏נבץצאו׀‏ֽמעְובו—ÿמפ”במßÿהץךיהױָֻכֿזכאץ׀‎םֱֽ‘ױְָכףעװלפ׀ױסוךנדז—ְמֻֿײנבץּמדגזזצזעˆˆ‏ו”׀ךְזגזזכעזײבזגהזצבלזזגהז‏ךזזזזהÿצזהזֿֿכוזגדזß“דףזזזזגזזקÞ“ױןֿ—‘וצִסלß‏Êיףצ”יÝ‏•יףצÊמÞך־םֽע—יִֽ•יףצÊםÞִÊיףצ•יÝךסבוִÿבֿעעוְִאבץצנךÝךÞבß‏נבץצאו׀ִאבץצÿבֿ‏סבז‏ֽ–ß’ֵ‏ֿגקב־דÞאִֿכהצְבוßװֲדזָףדףךִדְ׀צאß”“מזװןדֿ׀Ê‎ץָגזצמֶא׀ֱָןעֿדפְ—ֲגßעעך־“ֹצהװֳה׀ִבזְעבלßְֹבְְכז׀װאמּֿׁןהצקגצּ‏גגזײךֻֳףßך‏הֿצגגצִֶמְזהזה—זזזןׁזֻעזבְזּזדץזךצךווצזופְזוזְזוסצצוזזזהÿצזהזֿֿכוְגבוציֳזזךדאציךבßִÿםוִֽםץךÝבץעןוßּױיÝצ•יÝעֽמ־‏–יד‏”ךßעעבֽךֿךֿ‏סגפגֻיףצÊם־ךֽוְ‏סבץצנך—ְ‎מומֳםץ‏לג׀—לזץִׂךˆ’‏זנ׀ךמהןדג׀׀לדיױקה‏הלÞ‏ßףß‏נדז——כˆ“ׂאְּמז—ָךהָ‎גצָזזצזֽזזזוˆצםסזדעזÿױע‎זצצוזע׳כװה׳צנגזֿזזזזזֻ—בזצמהאעװזוזצוÿ׀זוזץֿכזזךדזֻ—בזצמהאצםךא—זֱזזגזוזךוואִזזזזהÿצעוזְמ‎פ׀זדז׀םֳוצגהזּֿהףבֻזהץעּגץְ׃ןְ‏ןא־װ•יִֽ”יֽע—םÞִÊםֽע—יִֽÝבץצנבßִנבֿעעוßִ•יÝךÞבִֿנבֿעעוְִֿיÝך•יףצÊמÞמאו׀‏אבפיםבץְֳז׀—׃אß“‏דßךידדעֱבְצופומכגףנכהּצדֱׁןׂךגץעע—צוֹּמ־׃ױְפ’וְעךזצ‏גל־‏׳ץפגיגז“ההזעױםßצזפץ–מֿצְֹעִÝְ–ֲ“אוְˆספ׀ִל’׳ׁזזגזדˆְזטהסצז׳זג‘–זצגדזזבלפזֵעבֿזב׀זוזְמוְֵזזזזםֳזזמהאגװגזצךדאְיךא—זנזזגהז‏ךזזזזהÿצזהזֿֿכוזגדזßָדףבֻזדזזזזהּזלדךעקצעןבÞװנםÝע•יֽעץיד‏”יֽע—ם־ךֽמ־‏–ידִÝבץצנךÝךÞבֿעסבז‏ןו׀‏אבßךנו־טגדְעגה׀׀ךהצ׳לÞֱִג׀“ףףÞמִדְ—םדזּהדזמ‎מלזההזְ‎םזגֲם־ּנבץךךההעÝצּ—כבצֳלף“עםßָףאÝזְˆׂ׀װכ׀זזזצז‎זזזוטצםסזהמזאּזÿזזגזז‏ךזזזזהÿְזהזּֿהףהמֿןֿזדוß‏ױיÝךÊיףִ”י־‏ֹםÞ‏Êיףצ•יÝךסבו‏ÿבß‏נו׀ִאבß‏נבץצאוÞג”׃׀צוז׀גצגֻךֳבץךעג׀“‏פß“ֶזְָודזִמו׀ֽְנמוָ“בץמהדזצֵמהסןיצ“ץדזצכוו“ֹ׃פגÝמדגֳאפִֵזזמזלקˆ—זִ—הסצזֳזהװזכּזױזזמדזצםסוזגוזציֳזזךדאגװאזצעבזבזזזזֲזג׀ֲןֿ“ױן־ָֹךßע•םזִןאפװזבֿעעו־ך־םֽע—יֽ‏”יפך־םֽע—יִֽÝבץצנךÝךÞבִֿהיֽע—ם־ךֽדְמסבו‏Ýזֵצ‎ֵ•בֶֿֿךפבצמֽןßִםג׀—ל–העׂגב׳מןÞײזßצךץע׀וÞ•׳ÿ־‏–ױÿה׃דמהךהלפ׀ױסוךנדז—ְמׁ‘יֽ׀ßל׀עֽלו‏”ךצזוזהקˆּצןץזֻעזףזזÊצהךßכßִדזזגופ־זוזעְ•גזטוזוןזזגזז‏ךזזזו—ץ—‏ױלְמןבהװזבֿעסבז‏ןו׀‏סבץצאו׀ִ–יÞ‏ֹםÞ‏–ידִֹם־‏–יד‏•יÝךסבו‏ÿבß‏נבץצןמÞ‏ÊםÞִאבץצÿבß‏ÿיÝ‏•יÝ‏”יÝ‏–יהִֹםֽע—יÝךסבו‏ÿב׀אÞןßזמבß׳לÿל‘ֳזץזןצװללו“ףגְמףהֿעßןוְנהצךןדוװואףֹּוז‏ÿבְ—לוßזאגפ׀ָםßךכד־הןהֻּבצ—Ýגה”םֿט‎־׳ק׃ּצצגדִָךֿ—ֱזצ‏װםהעם׀‏יגצדוְצױםÝִהצ‏הוזךמןומױןּעדה־עֽןְ־דזּטז׀ּמטד–ֿהßזצזְִזזזגזבקְזֵ׀הסצזßזכץכװה’צנגזלמזגהזצצוזזךהפֿ׃זה־זוזְגגזצזבזּ׳‎פזיעבֿזמזזןהזֲדזזמבוזמדזזמד‎צ‏וזצגמÿצזמהוֿכזזזזאְוךא—ׂ׀כֻו‏צה‏זו׀ְןְ׀עוז׀צזוזי׀זזמזוזךהואִאזצגוהב—זהזְ‏פ׀זזזוָזףו׃זכזזןהזֲדזזךגוצצדִזזבזזצבזן׀זזְזגז׀מג‎׀‏וזצגמÿצזמהוֿכזזזזאְוךנסֻזדדךעאוג־ג־מ׳גצּןןפװגו־ך־םÝע•יֽעץיה‏ֽמ׀‏סךÝמסבפךÊם־ך־וÞךÊיףצ•יִֽ–מÞמÊיףצ”ךßעעבֽךÝךֿ‏ÿג׀אאפגמדְעגבוÊײגÞ׀ֽג׀צנגפצכלזמסבצךללÞֱִג׀“ף”דזÞזßם׀ךזממהוּּז‏“ֳבו׀ֽמֻגמהßְְוהצל׀ִוםףיהףצװסדÝ׳בˆֿצזזזגזמ׀זזזְִהסצזÝזלוכװז–צנגזÊזזְםוזֿנזזךאוצמגזצךג‎צִוזְמםÿצזםהץֿכזזגוזב—זזזז‎זג׀ֵפזׂעבֿזם׀זדזזעגז׀סֹזזְאזצצוהזץֻו׀גהזְֳֻזזּםאגװזזצגזÿצזזזוּזףו׃זכְזגוצ‏בוז‎זזךזוצצדונִזהזזאזצְא‎צִוזְמםÿצזםהץֿכזזגוזב—זזזז‎זגß‎נעזטך־סיץג־גÞךֽמץ‏לוß—ױזו‏סבז‏ןוÞג”מףמ–יה‏ֽמ׀‏אוÝךÞבֿעסמÞ‏ÊמÞמןמÞ‏–יד‏”יפך־םֽע—יִֽÝבץצנךÝךÞב׀אׂאֿגץהׁ‘ןןְג־כÞגָװזִלז־׀קבוךגבֿגּהÞְהאץצאבÞװÿהץךיה׃ץאןצןיֵג׀‘‏—׀װׂבװ׀ל׀‏פהץצטעצְכאהזגלףגֶזפװ׀םבְצבְ׀יצְזוזזˆˆ‏זןÊזֻעזעצה׳פזכעבֿזג—ךםזְזגצד—‎בצ—בזצזהפּ׀וז—ְֵצוִםזצזהצד—‎בצ—בזצזהפּךוזְבםףזגדפבֻכװז׃צנגזÿזזךגוזיׂזְגזזזץֱזזצגאגװזזצגֶזע׀ֵפזֵעבֿזןְזדוזצדְֵזזזְגהזזבזזמהובזוזצ‏פ׀זוזץָוףו׃זןצזדוזטדזזזהזצמזזÿ“זזְמגÿ׀זגווֿכזזגואְבךנסֻזהÝך׀כפ׀ָםפ—עוצִנל׀זנבץצןמÞ‏ÊםÞִןוְ‏ÿבß‏סבז‏ֽמ־ִ–יֽ‏–יהִדםֽע—יִֽ•יףצÊמÞך־םֽע—יÝךסבו‏ÝךÝמנבץעעוְִןוְ‏סבוִÿיִֽ”םÞ‏Êיףצ•יִֽÝבץצנבßִוÝְֿנהצךןדוֻ׀ידךהבצמֳןזּטוצ‏הןְגכדצ׀םדßױםßףדֿיבמֿ׀טדצּכהְמדלÝבֳגהְֲגßמהג׀ָסץצמֳכהְָפ׀ּאזְיׁך–ּ׃ֿßזןןÞעההזְקגְ‏נזץ“מדßֳּאועףדזְֻך—םיהßעקןפּבהִֶגßְֻבזְפבף“׳ףצמגכ־צֻקפִאדץגקז׀‏זזזגזמ׀זזזֲגהסצואזכוכװז׃צנגזצכְגהוג‏ױז׀ךוזְםלי׀גדפו׃זגÞ“וזְץאזצעהל׀ךהזצעדפִֽוז—ֿ‎פזכעבֿזןזזדוזצדְֵעוזְמגÿ׀זגווֿכזזגוזב—זזזז‎זג׀ֵפזֵעבֿזמ׀זדוזצדְֵזבזְגהוצבזזמהובזוזצ‏פ׀זוזצוֳזזזזאצוךא—ז־זזךגז“ךזוצמוזְעוְֱזהזְץֱזזצגאגװזזצגזÿצזזזוּזףבֻ‎צז׳הצףךעטֿג‎וְִ‎ל׀גאוְִÿבֿעעו׀ִֿיÝך—ם־ִֹם־‏–יףצÊמÞך־םֽע—יÝךסבו‏ÝךÝמנבץעעבִֿÿיִֽ”םÞ‏Êיףצ•יִֽÝבץצנבßִנבץצאוÞךÊם־ִֹזÿזםהְבגםְִֵˆָמװß‏י‎׀להְ׀ֵלÞֱִג׀“ףןÞמִהß‏’דßִ‏דהִָגßמהג׀ָסטÝצכה׀ּההז׀סזף“לן׀—ּבדע‎אנÊ—וצ—איְְנא־גכההעÝצּ—כבצֳלסְָא׀׀ֲםßךעזצעׂמ־עם׀‏יגוגהוְסיאֽ‏ֹו׀ּוזְזהזה”ˆ‏זןִזֻעזל׀זזןֳזהִֽוז׀צ׃זצעדזּ׳כװו׃צנגזֻזזגהזְבׂזזצזז׀זגז”“זזזזהÿצזהזֿֿכוְגדזß’כו׀גבוץָבףו׃זםזזוזְאדזזצזז׀זגז”“זזזזהÿצזהזֿֿכוְגדזß’כו׀גבוץָבףבֻזבה׀װזזזװק־׀יףצזל׀זײךßעהזִÿלß‏Êיףע—יִֽ”יֽ‏–יה‏ֽמÞמÊיףצ•יÝךסבו‏ÝךÝמנבß‏נבץצאו׀ִאוֿעסבז‏ֽו־ִ–יֽ‏–גףצ•ךÝמÿבצ‏סגץצאמ‏קגוÊלג׀—ֽל—ֽןßִםג׀—לÞמ׃גזְןבÞלדגז—טד‘׀מוצעֽאְְמהß“ֶהֿזטופִּבֹ“ץןוגְאהּװל–צףבְ׀ין־עץכפְףß’”דִָֿוְ—צְֻממהומÿזפָ“ך׀ממבֿˆׁ־ךװזזזוזוףˆˆזאßזֻעזןזוט׃צגוז׀זופּׂ׀א–ו‏צוִזזצמהזנ“זזזזהÿצזהזֿֿכוזגדזßּדףו׃זבְזוזְאדזזזזזֻ—זזְמ‏פ׀צוז׀ך‎ז—ß‎צז׀זזזזִזוװÞבףְבוßִױוהִ–יֽ‏–יףצÊמÞך־םֽע—יִֽÝבץצÝךÝמנבßךנו־ךוְֵ“בווזֵ•הװֹבְּףןָ–ם׀מפזְָֿוזממהוּּ•־׀ֳםÝמױףßצצןÝג—ˆ׳ְׂכ׀זזזצזֲזזזהְ׀םסזב׀זךגז׃פדז׳גצצהזצבלו׀צהזצמוְ׀עוזְךהְ׀‏וז׀ךזÿְזזזוּזףו׀סאּֿ‎אֿ“ֶהזִִל׀זנבץעעו׀ִאוְִןמפִÊםֽע—יÞךÊםֽע—יֽ‏”ךßעעבִֿÿבֿ‏סבזִֽם־‏ֹם׀‏סבו‏ÿךÝִֹם־‏–יד‏•יÝךסבו‏ÿבß‏נבץצןמÞ‏ÊםÞִןךÝ‏”יÝ‏–יהִֹםֽע—יÝךסבו‏ÿב׀םׁבוְ־מֽזףהֱ‘“הֿ׀ףדצך׳ןץמפזßךךגÝזֲבֿ‏םז׀ִךבזצצגגßיוÞֳּגֿמדג׀׀ףכß“נבְּדו׀׀לפ׳װֿםצכדֿ—ָםßךכד־“הןְֿÿכףּֿכÞÿÞ—Êֵֻ—ָםÝזבכפךֻטÞּןדצקז׀ִגכפע“קזּןזצךִאפ“Þמכָוופ—ֽםףװ׳ו׀—קד׀ךןוה—ֻטד׀םו׀גוװ—׀”בֿגןו׀ךגוֽ׳ז‏צ׀צגזמאזזגזדˆˆזֱ׀הסצז׀זהזכזצוזזךופְזבוְנדוזגוזצ‎ֳזז‏אאגװזז׀ךזÿ׀מוזזז‎זג׀Þבף‏ץאפְֿו׀ִֵלÞצאמÞמֹיף‏•יףע—ם־ךֽוְ‏סבוִנבץצןמÝִÝםֽע—יÝ‏”יפך־םֽע—יִֽÝבץצÝךÝמנבßךוˆוְָהצ“בווזֵß׀עכדְ׀ÿ׳ֿ’ץוצעגבזךױםß‏םגßˆ‘יפִהגהװׁזְְמאפףֶכו—ןכוװֽףג‏ֶכהנ“טֿגֶבְױזפִÞל—עגוßיק‘‏זזזוזו“זזזןִזֻ‏זפ׀זװצהּׁמוִדזְצופְזגזְפדזזמוזָךדזצגוזב“זזזז‎זגßאץףִ–לÞָץכזעןב־װזבֿעסבז‏ןו׀‏סבץצאמÞך”ךÞ‏ֹםÞ‏–ידִֹם־‏–יד‏•יÝךסבו‏ÿבß‏נבץצןמÞ‏ÊםÞִאבßִנבֿעÝךֽ‏”יִֽ”יֽע—םÞִÊיףצ”ךßעעבִֿÿזֵ—ֱגזְÿאֲּֿÝÞאמז׀—ְמזְכלו“ףגְמףהֿעßןוְנהצךןדוװגןהע‏דפזנבְ׀כוֿגאגה׀ָםßךכד־הןהֻּבצ—Ýגה”םְ׃־ִכְיהֿ—ֳיץװנזצ‏װםהעם׀‏יגצדוְצױםÝִהצ‏הוהז‎מץע׳אÞג־מזװ־דזּטז׀ּמטד’ֿדוזצזְִזזזגזמˆˆ•ז•׀הסצופזןזגָּÞםצװגוזךׁןזמהוזםלט׀גדפגׂ׀אבו‏צו‏זז׀צדְ׀זגזְפדזזמהזב“וזצזזאצוךא—ׂ׀ךֻו‏צוָזז׀צדְ׀זגזְפדזזמהזס“זזצג‎פ׀זזזוּזףו׃זאְזדוזטדזזצהומךזזזגזֿזזהזְבֲזזגואצבךנסֻזהּ‎בלÞָֿןß‏בוßִױםו‏סבז‏אוÞך•ם־ִוו׀‏סבו‏ÿבß‏סבזִֽיףךÞיֽע—םÞִÊיףצ•יÝִֹםֽע—יÝךסבוִויִֽ”םÞ‏Êיףצ•יִֽÝבץצנבßִנבֿעעוÞךÊם־ִֹו׀‏אוßעעבßִדףוּץבזצצזץצÿˆֵװֽאצִןכץצן׳ֿמכהז‏ןוץמסטה׀“םוך׃זֿװדטֿמץלֿ׀ףגְמףהֿע”ןֿ‏נהצךןדוִץז־ָדזע׳כהזֱםß׀בההךךזפ׀ׂמץְלגְ’ימפװנאפגםהְעÊלו“סאֽמֳפßֳִקÝְדהךÿˆׂװײיßמדוÞ׀־םף“ֹוְ—צגזךםופװֻטד׀םוְמגבזמײל׀ּיו־ּזזזגזבקˆזÞָהסצזֽזבל•ד׀ּהזצזופּׂ׀א–ו‏צוְזז׀צגז•“הזצזזוב—בזצצגאגװזזצג‎זע׀ֵצוִזז׀צדְ׀מוזזזגÿצעווזצ‏פ׀זוזץּוףבֻזדצזזזהךזמץע“לוךאוßְױזו‏סבפךאוֿעעבßִנו־ך־םÝע•יֽע–ידִ–מפמÊיףצ•יÝךסבדךֿזßװקכֿ‏צזצּהמו—םדְעביׁ•‏לÞִסהֿךֱזײגהםְ“עּֿ׀ֹמץךכ׳פּÊזְְמא־טףÿד‏הםÝגװפץ‏צן׀זזזְז”ˆˆ׀דס׀םסזהצזי׀וÊצז—ֶזצזהכÞ‏ְזצצדוזםלפזֵעבֿזןצזוזְמוְֵזזזזםֳזזמהאגװזוזצדÿ׀עאזְךדאציךא—זִזזגהז‏ךזזזזהÿצזהזֿֿכזזצגז–בוְמדזßּדףבֻזגזזזיÝ‏׃כזזּזהךÝבףְןוßִױוהִ–יֽ‏–יףצ”יפג־םֽע—יִֽÝבץצנךÞגÞבֿעסו׀‏סבוהבז‏ֽמהִ–יֽע–יד‏Ýךִֿסוְ‏ÿבß‏אמ׀ךגדז‏דןˆ–׳לÞִףדוךטג׀לßדְ“םד׀מלזפזֳˆף׀טהֿ‎ו׀ּמוזגםז־גֵוזממהֿ‏ֻÊבׂז־עÝכגמֳהßעקד׀Þךדוץוםץנכגפ‏Êז׀ִלןמׂך׀ךאוֿעצ׳העֽזזזוזו“זזזך“זֻעזמזולפזֵעבֿזא׀זהז׀ךהְֵזוזציֳזזךדאגװזזזזגÿצזגווּגףו׃זאְזהז׀לדזזגוז–—זז׀ך‏פ׀זזזזץֳזזצגאצץךנִֵ׳ךßע—מזעןאפװ”מףמ•יףצÊמÞג־םֽע—יִֽÝבץצנךÞגÞבִֿנבֿעעוְִאמÞבמזÊְװם־ˆֲִֽןß‏לג׀—לז־׀ֻכֿזכאץ׀‎ם־”ֵױצװכףע׀לפ׀ױעוךנדז—ְמֻֿײנבץֽמףגזזצזעˆˆ‏דעצךְזגזזכעזײבזגהזצבלזזגהז‏ךזזזזהÿצזהזֿֿכוזגדזß“דףזזזזגזזקÞ“ױןֿ—‘וצִסל׀צÊיףצ”יÝ‏•יףצÊמÞג־םֽע—יִֽ•יףצÊםÞִÊיףצ•יÝךסבוִÿבֿעעוְִאבץצנךÞגÞבß‏נבץצאו׀ִאבץצÿבֿ‏סבז‏ֽזֲּּנ•מץדßֱִˆ‎׀ֶב׀ָלהזעןאß“ךהֿךיךß׀טדוזֵןצםײמזװןדֿ׀Ê‎ץָגזצמֶא׀ֱָןעֿדפְ—ֲגß‏ÿך־“ֹק־ֵָדזִבזְעבלßְֹבְְכז׀װאמּֿׁןהצקגצּ‏גגזײךֻֳףßך‏הֿצגגצִֶמְזזזְז׃זזזדס׀םסזועזמ׀ז—צדגדזצעזזעָזזצמזזסעגזצזזזֻ—זזְמ‏פ׀‏ווצעדÿצזדזßּדףו‏נב־ךנמ־עףךßצסו׀ִ‎לÝִ—יִֽ–מÞמÊיףצ”ךßעעבֽךֿךֿ‏סגפגֻיףצÊם־ךֿוְ‏סבץצנך—ְ‎מומֳםפזףדצָהֱÞ“Ýˆקזה–ז׀ֿמק”סג׀׀לדיװקÞ‏הלÞ‎יץץ‏ךדףצׁˆֽ•—ֵפגֿדÞִ—לßּץדְזוזוףˆˆזךֽזֻעזןזוט׃צגוז׀זופּׂ׀א–ו‏צוִזזצמהזנ“זזזזהÿצזהזֿֿכוזגדזßּדףו׃זבְזוזְאדזזזזזֻ—זזְמ‏פ׀צוז׀ך‎ז—ß‎צז׀זזזזִזוװÞבףְבוßִױוהִ–יֽ‏–יףצÊמÞג־םֽע—יִֽÝבץצÝמףמנבßךנו־ךה“ז“בווזֵˆֵ‏װםֿ‏םגßהףֽעֹזֿזהא־זגזְְמאפףֲכו—ּךפ׃קבוזֱךףףÊה“ׁזזזוזזˆˆˆזיׂזֻעזךְזÝצדזִזצךווזגזז׀םלזזעאו‏ךגזצגווֻ—זוְ‏‏פ׀זדז׀וֱזְגזזוּזףדמסטוג‎להגןוßװױםז‏ֽמ־ִ–יֽ‏–יףצÊמÞגאבץצנבß‏סבזִֽיÝך•יפִÊיףצ•יÝעֽמ־‏–יד‏”ךßעעךÞגÞבִֿףז•“ֶמזּטוצצצאˆ”ךבצ׀ודץֲÊןְּאזצךיגְךױםßעלגßהֵדעֹזֿזױכ׀ממהוּּ•־—ְמֽעÿץ׀ֿבןÞ׀ֻׂזװףדÞזצןהּÿזפִÞל—ּנגוßיק‘‏ˆˆזןְזזזָךהׁצז־זט“זזזזדזֱ׀ו•זזזˆˆזןְזזזָךהׁצז־זט“זזזזהזֱ—ׂזקˆˆזו“זזזלדזױ—זמְדׂזזזזם׀ן’זעקˆצגדזֱ׀ו•זזזזזÊßזצא“ˆˆÊ׀ךÞװזˆˆזןְזזזָךהׁצז־זט“זזזזֹזֱּוצˆˆ’זצמוˆפ“זזזÊßזצא“ˆˆÊ׀ךÞװזˆˆזמˆÝזֿזהסצז־זיצזזזזדזֱצזָצזזˆˆזמˆ׳זֿזהסצז־זיצזזזזדזֱעזָזזזזזמזמˆˆ—זֿזהסצוץזב—זָּזפףףעֽז׀צדעףמלז׀‏גזָּזצימפזסעבֿזן׀זדוזטדזזצאומךןזצ‏זוצמאונִזזְמזÿְגוזזז‎זג׀ֵפזײעבֿזמ׀זדוזטדזזצאומךןזצ‏זוצמאונִזזְמוÿְזוזץֻכזזזזאצוךא—זֽזזךגז“ךזוז‏גְ׀זזזצהגו׀גאזזעהוְסֹזזמהזס“זזצג‎זעß‎נעזפעֻםפÿסםִנב‎םפה׀ױמץ“סהזִÿלÞענבץצאוÞךÊם־ִוו׀‏סבוִÿבֿעעוÞך–ךÝמ•יףצֹםÞ‏–יד‏”יÞִÊםֽע—יֽ‏”ךßעעבֿ‏ÿבÝ‏”יÞִÊםֽע—יֽ‏”ךßעעבִֿÿבֿ‏סבזִֽם־‏ֹם׀ִאוְִאבֿעעו־ך־םֽע—יֽךו—־װפבוךוה׀ßגץוÝ‏‎ה‘ִפה׀ְאהצעעא־זׂגצָץבזצףהצג’׀‏סג׀“ָןֿךפזֿךלבףגִאו‏םז׀ִךבז‏ץדְםײאץּפגץֶָגְִׂקוּׂמ׀ָףד׀גְןץעד׀׃ֵל־צ‎בהגםה׀“ִךוװקאדע׳ךÝמפמßמ‎כÞָמוְּיגזÿגßָ‏זְ‏װםהעם׀‏יגצדוְצױםÝִהצ‏הז׀ִָכֿ־באץגפאץּפגץֹˆˆ׀זֲזזזו–׀םסזהמז–צזזזצ‏וÿױ’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזבזזזזנּהסצז־זי‏זזזגאזֱּ׳צזםװצגוׂקˆ’װדךױזזזהזוףˆˆזא“זֻעזמ׀זׁזןוזהְּווצ‏קזצגבזּ׳כװו׃צנגזֿזזךגוזיׂהזגאזזעווְסֹזְגזזזץֳו׀גגווֿכזזגואצבךא—זְזזךגז“ךמזצ‏זוצגאונִהזצזזוב—ןזצצגאגװזזצג‎זעß‎צועּםזזזםהּכ־ָָזהךזמץע“לוךםוßְױזו‏סבפךאוֿעעבßִנו־ך־םÝע•יֽע–ידִ–מÞמÊיףצ•יÝךסבדךֿוֿ‏סבז‏ֽמ־‏–יד‏Ýזֶּקכֿ‏צזצּהמו—םדְעביׁ‏ױםßעלגßוכךִןוצעןו׀עז־‏טבם‏ִםÞגףה‘ג׳םְממהוָֽֽ–׀•ז־ִßכג“סגוˆ־ןוךףןו׀ףגß׀זˆˆזיˆˆזֲעהסצז־זיְזזזגןזֱּזײקˆ’זזÊßזְא“ˆˆÊ׀ךÞװזˆˆזןׁˆזץזהסְז־זיּזזזגאזֱּצצזםװצגוׂקˆ’װדךױזקˆˆˆˆדˆˆזגקזֻעזמְדֵזזזווְן’ּׁׁזהֵגוזֵֽˆֵזÝל׀דˆˆ׀זֽזזזהזזםסזהמז”צזזזצִוצדםˆ“זהֵגוזֵֽˆ”ױזÝל׀דˆˆ׀זעזכ“וא׀םסזהמז”ְזזזצ‏וץָטזזֶÝזצגטךÞׁˆˆ׀ז‎ˆ•זו׀זםסזהמז”׀זזזצ‏ונֱ’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזןְזזזִ‏הסצז־זטזזזזגןזֱּזֿקˆ’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזבקˆ•זֳדמזז־זטגזזזגןזֱּז־ׁˆ’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזמ׀זזזֱ—הסצז־זטךזזזגןזֱּז”ˆˆ’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזאצזזזףּהסצז־זטעזזזגאזֱּ־צזםװצגוׂקˆ’װדךױזקˆˆזהֽˆזןיזֻעזמְדÊזזזוו׀ן’זלןˆצזםװצמוׂקˆ’װדךױזקˆˆזוףˆ‏זאזֻעזמְדָזזזוו׀ן’זךֵˆ•׀זםװצגוׂקˆֵװדךױזקˆˆזהךזזזןמזֻעזמְד׳זזזוו׀ן’זיכˆ׀זםװצגוׂקˆ”װדךױזקˆˆזהךזזזןֿזֻעזמְדױזזזווְן’ˆׁעזהֵגוזֵֽˆֵזÝל׀דˆˆ׀ז׃ˆ•זו”זםסזהמזזזזזצִוצהֶˆˆּזהֵגהזֵֽˆֵזÝל׀דˆˆ׀זעˆˆ׀וװצםסזהמזצזזזצ‏וס”’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזןְזזזָךהסצז־זט“זזזגןזֱּוצˆˆ’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזדˆˆזֱ׀הסצז־זטזזזגןזֱּז—ֱˆ’זזÊßזצא“ˆˆÊ׀ךÞװזˆˆזןׁˆזץזהׁצז־זיּזזזזהזֱ‏Ýזקˆˆזו“זזזןÿזײ“זמְדסזזזזזְןף׀דˆˆ׀זֲזזזוßְלׂזהמז“זזזזזמו—ְזˆˆזמ׀זזזְִהױְז־זטּזזזזהזֱװזזזוזוףˆְאז׃ָזףזהÝפזםעבֿזלְזגז׀גדוזבזְגוזז‏בזצ‎ֹזזךזוצִדונִזזזזןÿצזןוßֿכהצגמהו“מףו׃כװזßצנגז׀זזצדזצךגזÿ“זזְגאו׀ם׀זזגזוְעווÊִזז׀זבו׀ךב‎׀זזזזֳֳזזִןאגװםזצְמןְֿךא—זßזזצדזצךגזÿ“זזְגאזצמאְֱזוזז‏בזצ‎ֹזזךזוצִדונִזזזזןÿצזןוßֿכהצגמהו“מףבֻ‎צוגזזזוךזגװ–םהךֽםץךֹטְָןןהװנםֽע—יÝִ•יֽע—ם־ךֽמ־‏–יד‏”יֽ‏Ýךֿ‏ÿבֽךÞיִֽ”יֽךÞבִֿסמÞמןו׀‏ֽמ־‏ֹם־‏ֽמְ‏סבץצנךÞגÞבß‏נבץצאו׀ִאוֿעעבßצנבץצאמעֲנ•מץדß‏ְו“‏דְ‏במÞֹּךִֿפהְִבזְעבלÞז׃ז׀—כז׀װאםוָ׀ןß—ָבפז‏בץװוזהזכו׀“ִםÊעקה׀צדאֿװלןß–ןץגָיןֿצסגÝִינָףד׀כהצְבוßװֲבצגףדףךִה׀װלהּֿÿדציאווזלֽםֱןעךבז׀לגְצץהוָ־זזזוזו“זזזןִזֻ‏זפ׀זאװ—עךזףזױזו‏סבץצאו׀ִאבץעעו־ךֽיÝךÊםÞִÊיףצ”םÞ‏Êיףצ•יִֽÝבץצנבßִנבֿעעוÞךÊם־ִֹוִֿÿבֿ‏סךÝמ•יÝ‏”יÝ‏–יהִֹםֽע—יÝךסבו‏ÿב׀אןßזמבß׳מÿװֿ־זךימהזמהÞְֲגßמהג׀ָסךץ׀‏בְּדו׀׀ֵוו׀ֻאז—ְבֿ‏ךה׀‏ץוֿזװלהִףה׀“ׁזֿ׀׳םץעיךßזׁיÞ‏כ‏ֹה“דצֳָןףעֵבְגאכהצֻקפִאדץגקז׀‏גלÞִ”קזּאזְצְאפגסלץװֿמ־זכמְ׀םדְךםהדְ‏צ׀צגזמןזזזהזה”ˆזמÝזײזזה׀זֵזהßזלצזהזְוֱזזזזכּװבזצךדזסגזצגוכ׀בךדז׀זזז׀ֵדוָעגְזכזזָּוְְסלß‏Êיףצ•ךÝמנבץצאמÝ“היףצÊם־ך־וְ‏סבו‏נךנמ־ן׃־מֿןÞְסבפְִמהִסבפְֱדכטָֽטÝָ‘טÝמףלאֲ”־מיÝֲמֲןׂאךְזזזצווזזזוְׂלעזוךזמ—זְהצְבז׀זוזעָזזצגÊפ׀מוזזזדÿצזדזÞִדףוגֽאפזגהוְױיÝךÞיֽעץו׀‏ןיף‏”ךßגעבֽךÝבפב׃צז׀ןלףִָץנֻ׀הזגˆױךֿדְֿו’וךִהדגֶסֱ•Ýאז“ֿזזגזלזזזזְָהָזז׃זאנ–דְגוזזבלפזפעבֿזמ׀זוזזצזזצץזזצדז׀ץׂזזזזזֻזזְמׂפ׀זדז׀סֲזזעבם׀סךא—זּזזגזוזזוון“זוזךזוזיזזזזזֻזזְמׂפ׀זדז׀סֲזזעבם׀סךנעזםגץמײםהְײוְְֶלÝִ—יֽ‏”קְמ–יה‏ֽמְ‏סבוִנבץצאמÞמÊיףצ•ךÝמנבץצאוְִןוְ‏ןמףמ•יÝךןמפְֹקֽ׀ÝטÞ‏׃לץעֲוְָ׳םפצֲָס’ײֱפ׃ÿףדוןפ׀ְולה‏ּוÞג‎ˆִֽמט–‎זך־װעף‏פומץוֿזנבהג׃לÞ‎הק–ם‎ךג׃גלßװֻיÞזֿםכּזזזגזמˆˆ—זֱךהָזזזג׃זפדצוזְךמזצגזזָּזוצצדוזעדְֱזזזְגהזזבזזךזזְזדזÊִזוזצאÿ׀זאו־’כזזגוו•זמזצִןכ׀ֳךזזזזקצזםהְֽמפך׳םזּמאÞװנםֽע—יֽךÞבֿעעוְִאבץצנךÝמ•יףצֽוÝעÿךֽע—ם־ך־וֿעעבß‏סבז‏ֽמ־‏–יד‏Ýךֿ‏נבץצאוßעֲזֿעעוְ‏ּֽא—ׂמפגײוזגבןוִßינֻדטס—ֽםßְÿוְְ׳מפך׃ֵ–ֳבֶדֻ׳עÝְֿטֽ–•עְ׀יפך׳לץָמד׀ךידוךףנע‘ֶזÞ‏הֿ—מˆבץזלהְ“צןÞעָמֽעם—ע׃קֻצלזְצװעףְ“ספזזזמזאצזזזֿעהֹזזנזו׀זטעז•אזגדזְִוזצךהפְְןזְךגזצגזז׀בֻזזמהםּװבזצזזוֻ—זוְ‏ֹוּ׀ÿבßִִבß׀ץמßגץבוצצהצְֵלÝִÝךֽ‏–יפג–יֽ‏”ךßגÝבפךסבו‏Ýךßעֿגßגֽו׀‏ן•ֽממהׁצמ־ֵס’ֲהצ׀—ˆ׃׳גזֲֿדם־גיגÊֻם‏װנדˆÊ’ֶֿץךךמצגלזץצְװּמזזצז׃ˆˆצוצלׂזה—זףגוםמְגדזְבלזזךהזזמדזן“זזזגהזזבזזִזזְךןזÊִזוצעָפ׀זאוְץֳזזצגםּװזזצגמÿ׀ּוהזְׁהג׀זזזז׃זה׀ֽגץמֿג־צָםזָמןהװנםֽע—יֽךÞבֿעעו׀‏סבו‏Ýךֽ‏–יה‏ֽמְ‏ןמßךֿךֽ‏”ך׀ִֿוßִ•ךÝמנבֿעעוְ‏ֽÊ•“׳מÞגװהְְֳבÞ–ךףךּטßװָםצגׁאומגמץׂßךהךבגִגבזֳ–גךקÝ‏ֿלÞִִדßזטהֿגס‎ב–‏פÞךÊזנצםג‏ׂ’זףגßÿד“‎דָזזזמזכֱˆ—ז־הװְזנזהמזקגז’ה׀גבוזבלזזמזוזעהואִזזצגזÿ׀זזזהֿכו׀גבוציֱוְגדזÞדףוִÿזזזÿמִֿֿןץװזבְזסםֿגסהזְÿלß‏Êיףצ•יֽךסמְ‏אבץִ•יֽךÞבֿ‏סבז‏ֽיֽ‏–יה‏ֽמְ‏סבו‏Ý׃‏ֿÊ׀ְָֲסךואעמ–קבָÞֿÿע׃כףמװלֽזװךזÞפּÿ•’‎פבוֽנּומפִ•ÿÝ’Êֳהבֲפֻבֲס–םך‏ְזזזצזֲˆˆצוזלעזוװזעױעצזצזהזע׳כװוֿצנגז‏זזגזז׀זוִזזזזזםֳזזמהםּװגזצךדכ׀יךא—ז‎זזגזז׀זוז”“זזזזהÿצזהז־‎כוזגדזÞדףבֻזדזזזזוװזאֿגףם׀עמבÞװנםֽע—יִֽ•יÞג־וְִןמÝִֿבצ‏ןוֿעעבß‏סבז‏ֽױ־–קףא‏ֶˆׁךֱמזָןמץגוßף—עזצהךפװךך־װ’ֽאלדםצ—‏גֶ׳קסגß•ֲßװ־ןזְׁךזזדזהֽˆזמהזײזזאְזָזד‏זיעזÞךהְףוְצדזְבלזזמהזבזזזזׂפ׀עוז׀ךוÿ׀צוזצגׁזע׀׳לצזזלף‏׳יפגֱזוָזאפװאהועױב־‏Êיףצ•יÞ‏–יד‏•ךÝמנבֿעעוְִנבֿעעוְ‏ֽגֽ‏–יה‏ֽמְ‏סבו‏נבßִהיֽע—ם־ִÊם׀‏אבץצנךוÊצּז‘‎ֽ׳קףוֲצגג’צּ׃אִ—ם׃ןעגßכף“ÊךÞְּא—’ףץÞִםןָֿˆצז׀־פּֽ“ףֿ—‎Ý׳‎כß’הךֽצןהםִצֽֳךזאßץ־גÞצףעָןÞֱבץדֿףָ׃ךגמֽבזעִקהֳזסְזהזדכˆ“ְמ—זײזזבְז־זבÞ–וזגבוזבלפזִעבֿזןְ‏ווצזוזזעו‎׀זגוזםֱזזמהכּװזזזזדÿ׀זדזÞדףו׃זא׀‏ווצזוזזעו‎׀זזזזךזז•ךזוזצהÿ׀זהז־“גףבֻזדִֿÿבÞמÿמפעסםפ‏צו׀ְ‎לÝִÞיֽ‏–ם׀‏אמÞמÊםֽע—יֽךÞבֿעעוְ‏ֽגֽ‏–יה‏ֽמְ‏סבו‏Ýֿד׃’ע׀ג‎צֽענֽלבֳ‏המ‎װלמ–ֽזװךה׃ך־׀דצ‏–׳זפגֹיֻ‎ֹפפּÿ•’‎צבאס–םך‏ֻ’לעס“זזְזָˆˆצהא׀מÞזזװזב׀וךפזײעבֿזב׀זהזְוֱזזזזאגװבזצךדזסגזצגוןְבךא—זסזזזזזְךזזÊִבזצךדזסגזצגוןְבךנעזפדז׀זזז׀ÿדו‏פגזזכזזָּוְִסלß‏Êיףצ•ךÝמנבץצאמÝ‏•יףצÊמÞמאבץצנך‘־זְןֻ’ְ‏ב’כÞ“ׂכÞ׃כפךָֻÊםֻ׳ֶם־‎‏ֳֿ“ֲןֳ”ֶמ־ן‏זזצזזזזוְָמÊזוךזמ—זְהצְבז׀זוזעָזזצג‏פ׀מוזזזדÿְזדזßּדףוגֽאפזגוßְױיÝךÞיֽעץמ׀‏ןיף‏”ךßגעבֽךÝבפבָצז׀ןזסצײץנֳֻהזגˆװ‏ֿדְֿוֳ־װךךץ׳סˆ־ג‏ד־גזזזגזמ׀זזזֲצהךְזׂזםה–דצגוזזבלפזֶעבֿזמ׀זוזזצזזצץזזצדז׀ץׂזזזזזֻזזְמ‏פ׀זדז׀סֲזזעבאצסךא—ׂ׀לֻו‏צהצזזצזגזזגגְֱזגז׀זגז”׀זזזזהÿ׀זהזֿֿכזזךדוס“זוצע‎וע׀ֵצהמזזצזגזזגגְֱזגז׀זגז”׀זזְזזזצמז‎׀זדז׀סֲזזעבאצסךנסֻזהץגףלÞצָלצ‏ןא־װ”יד‏”יÝ“היףצֽמְ‏סבוִנבץצאמÞמÊיףצ•ךÝמסבז‏או׀‏או׀‏אוÞגÞיֽ‏”ך׀ִֿמ—׳לבÞִ׃ן—ּ‏ןְ‏ללפעּלןֻֿ—הץטפוךֲהÝ׀‘וצגוןץ“פוהג‎ˆְֻיקנ‏“גץ—ױצפ’ֿגֿגאגו‏עמפ—ױםּמˆֽ־ָיÞךםדְעֵמßעאבוֲֻזזזוזוˆזאזֽגזקצהגצזָֿזצעגיזגהז׀םלפז׃עבֿזכְזבוזךגוציזזזהזצמזזÿ“זז׀זהזזךה‎׀זגוז‎ֱזז‏אאגװזזצגןÿ׀ְוו׀ֲִו—׀ֵצה׀זוצצדוזעדְֱזזזְגהזזבזז‏זוזעאואִזז׀זהזזךה‎׀זוזצֱֳהזגןוß“ןףבֻזגזזזזד—זקהצÊםהג—להצםוßװױב־‏–יד‏Ýךֿ‏סבזִאבץצנךÝמ•יףצÊמÞמןיץִÞיֽע—ם־ך־בץצנבץצאמÞמÊיףצ•ךÝמנבֿעעוְִסןְמסבז‏אמ“ֳ׳לוװִם׀צגמוצ׳כפװ׃ב־מׁךו“ֳמףגךםֿ׀ֳם•ץץטס——‏ע‏׀סףע“ֶגעךךÞ׀ֲם־ִנהצ׀טהזצפּגˆקצמײזּגױיÝעֱהועיא־צֹןה—Ýמףָֻיג‏םזְךֻץהׂץÞְזזזמזבזזזזִזהםְזסזוװזקגז’ב׀גדזְִוזצךהפְעוזזגאזצזאְְֱןזְךגזצגזז׀בÊזזמהאגװזוְ‏‎וּ׀נבֿ‏ֵבֿװץמßגץגßצצהצִֵלÝִÝךֽ‏–יפך–יִֽÝגףךסמßעעבֽךÝבפך”יפךןוְֲßלצִמ–נטףֶג’טו׀ָױˆףְהב•ְֳמצָצפּל‎ßׁ‘–סָּצה־ןֵ’ההפךְזוזהֽˆזא–זֽ׀זכְגק׃פמוז׀מופּׂ׀ה–ו‏צדךזו׀‏הוְִהְֱזהז׀‏הְֵזדזז‏דזן׀זזזגאזזבזז‏אוב—בזצצגאגװזזצגמÿ׀ּוהזְֲהג׀ֵפזךעבֿזיזזןוְמאו׀םזזמדוְמדֱזזדזז‏דזן׀זזזגאזזבזז‏אוב—בזצצגאגװזזצגמÿ׀ּוהזְֲהג׀ֵפזÿעבֿזטזזןוְמאו׀םזזמדוְמדֱזזדזז‏דזן׀זזזגאזזבזזעבאגװזוְ‏גÿצזגווֿכזזגוהבםזצְמןְֿךא—ז“זזעגו‏ךזו׀‏הוְִהְֱזהז׀‏הז”׀זז׀זאז׀וזזזווְזוֱזזאוְץֳזזצגאגװזזצגמÿ׀ּוהזְֲהגß‎נסֻזגצזזזה“זכפצץג־גץםהּּהְִִלß‏Êיףצ•ךÝמנבץצאו׀‏סבו‏Ýךֽ‏–יה‏ֽמְִֽגÞגÞיִֽÝוÞגןבÝ‏•ךÝמנבֿעעוְ‏ֽ־אזÊןß—ּוצךןבץךָכÞ׀ײקֽזנא׀גדבזגאßֹ‘ְואעָײי–ְÞטנֳדדדּ׃ןפָּאזּיוְָכדֿבקףגֻוצ׀גׁו׀מֿ׀גסא־׃טךֽסנךצזזזְזָˆˆצו“׀םגזועזמצז‘צדִכזצעגזעָזזזזוזְזו‎׀זהזזצבזְץֹו׀גבוציֱוְגדזß“דףו‏נזזזנמץ‏ְןוָזבצזעםֿגסהזִÿלß‏Êיףצ•יֽךסמְ‏אבץע•יֽךÞבֿעעו־ך•יֽע—ם־ך־וֿעעבֽטֱֳ–־ִֹףבÊץץּ”כגßֱֳאךÊםפָֻמÞֻּלצßֲא־ֲס־ג•ֳסְומהוִע–׳־מגװץגלץדטזזזוזוֹˆזאױז־‏זאְוÿצזָקזצזהבצגדזצםלפזִעבֿזאזזוזזךזזÿזזזזזהÿצזהזֿֿכוזגדזß“דףו׃זאצזוזזךזזציזזזזזֻ—זזְמ‏פ׀צוז׀ךֲז—ß‎צז׀זזזזֶזוּץגÞ‏בוßִױב־‏–יד‏”יÞך־וְִןמÝִֿבצִאוֿעעבß‏סבז‏ֻֽÞֿאט•ֿׁאֿװמוץטז‏ץְםֿ—דז־װֻדהָּךָבדְֲװעדײבהֽֽֿֿכ׀‏׃בְְֹלזזזז׀זֽˆˆצוׁצמÞזוָזם׀ז•זבֳזהףזֹג׀‏גז׀מופּׂ׀לֻו‏צוִזזְמזÿ׀זזזוֿכוצגדז׀בֱוזגוזץ“וףו׃זבצזזזזמדזזםֹוצגדז׀בֱוזגוזץ“וףבֻזג־ְָזזזָי־ְ–מץזאְז‎ל׀‏ןבפװנם־‏–יד‏”םֽע—יֽ‏Ýךֿ‏נבץצאוß‏נבץצאו־ךפיֽע—ם־ך־וֿעעבִֿÿזֽ‏–יה‏ֹם־‏ֹוְ‏סבו‏Ý׃ֻּ‘טדם‎טבװÝלבך“טדמ’צף–ּטב׀‏י־װÊךָֽ—אֿ‎זץף׀מאצִֶבףצ“דו׀ךה’האףץסךעָּאףִײלÝצ‏ןע“”יע“ָזנ““ןהָÞם־זֻכßָיˆװךײםפְ”ןְציווְׁמד‎גזזמזךׁˆ־זֲ—הךְזסזהגזֿױעגזצעגזע׳כװוßצנגזֲוְגבזזגזוצבֹזזצגזֻזזְמ‏פ׀זזזזיֱזזךדןְיךא—ׂ׀לֻו‏צוװאזצעזזצזבזנִזזזזדזזיֽזזצגזֻזזְמ‏וג׀ֵצהגזזְזגוצמג‎׀‏ווצזוזזעו‎׀זזז׀ךזס׀זזזזיֱזזךזז—‎נעזטבֿ‏נמץ‏ְםץעּםֿזןוßּױיÝמ•יֽע–וְ‏ֽמ־‏–יד‏Ýךֿ‏סבז‏אמßמ•יףצÊמÞמאבץצנך”—ß‎ּע‎יÞßךÿ”ץֵֽÿֳ‏׳”אÝלפע׳להעײםצך•ֳסְומהוִע–׳־ֱןָֹֻֿ‏ובע׳גק—’כקעץקזזמזלקˆ—ז־הךְזכזוִזףגׂ׀לֻו‏צוִזזְמזÿ׀זזזוֿכוצגדז׀בֱוזגוזץ“וףו׃זבצזזזזמדזזםֹוצגדז׀בֱוזגוזץ“וףבֻזגְ׀ךזזזךב׀׀נגֿזזה׀זלםז‏ןבפװנםֽע—יֽךÞבֿעעו־ך•יֽע—ם־ך־וֿעעבֽטß־‏ֻ‘ֲָײלֲ־ׂכ־ׁכפ—ׁדםֲמ־םֲÿ־מ־ÿמÿֲןֿ”ֳ•־מֿ•זזגזקזזזזֵעהםְזףזהיזמזּמוצךזזצבלזזגואגװהזצזזז–“זז׀ך‎ז—׀ץמßְּוזִ‏לÝִÝךֽ‏–גצִאוÝע•יÝךץבו‏ÝךßעֶֿגזךוÞּ‘ןגס׳ִזְקץק‘Ýמצ“‏זÿ‏ףןזְßאֻÿמץְטמצזוזדמזזזןזֽמזכְהצ׃צ—וזצזופּׂ׀אֻו‏צהךזזצזגזזגגְֱזגז׀ךגְֵזזזזםֱזזמהאגװזז׀ךבÿְזבוץּבףו׃כװה׳צנגזּזזגזוזזוון“זוזךזוזיזזזזזֻזזְמ‏פ׀זדז׀סֲזזעבאצסךא—ז־זזגזוזזוון“זוזךזוזיזזמזזזגהזאִזז׀ךבÿְזבוץּבףבֻ‎צזּץגÞװּלהּאוßָױיÝצ•יÝִזֽע—מÞמאבץצÿבֿעעו־ך־םֽע—יֽךÞבֿעעוְ‏ןוְִאוְִÝךֽ‏•יÝךןמףםלפִֹֿכץםאו“אה־ֻּםהֿ’‏נס–לבםלהß‎דטְֱ’ןץ“פוהג‎ˆּ“יקנ‏“גץ—ױצפ’ֿגֿגאגו‏עמפ—ױםּמˆץעּ׳קףִּוְָֿםְֿאבוֲֻזזגזםקםזֱצהיצזזמ‎זהֽצוזְךמזצגזזּ׳כװהבצנגזױזזעגז׀צבז”“זזזמוזְזוְֱזדזזמזז׀םֹזזגמזצִוו•צזוזצאÿ׀זאוְֿגףו׃זךצזבוזךגוציזזזהזצמזזÿ“זוְזגוצ‏ג‎׀זדזזמזז׀םֹזזגןו׀בÿזזגוו•זמזצִוו–ו‎צוזזזזזזד׀ּלהךֿמÞּּהצִֵלß‏Êיףצ•ךÝמנבץצאו׀‏סבו‏Ýךֽ‏–יהךןיץִÞיףצÊמÞמאבץצÿבֿעעו־ך־םֽע—יֽךÞבֿ‏סבז‏ןבץ“הבץצאו־טץֵפ“ֿמפָגזצעִבÝג–ֶעך’ÿפךֹאוִאההּֿמÞ–ׁס—סָטנֻףטאז‘קÿ‎פֳÝ׀–מÞּ׳אְְקז׀—ךגßי‎ף׳ָדםְלןצֽסגזָלדֿזֱםפְ־יף—ֹץפ—סזָהוהßץטדֿסכ׀זהזוׁˆְּמÿז־“זבְזִזד‎זךßְוז׀מןזצגדזָּמו׀מדוזגוזזךו‎צעוזזזאזז‎־זזמהאזםךבßִÿןוִִגפךץגץצעגזּןאÞװÿךÝמ•יףעֿיף‏•יÝךץךßעֽבץצנךÝךסמץךץמ׀ִאו׀Þהזױ—הק‏Ê–ֲÿְּךיקֶץזמÿְÞ‎ידץם׳פנכבְˆ’ׂ‏נּףדהגוהְגעמכםהזזזוזדקˆְֿןˆזּזזכצה’׃פמוז׀מופּׂ׀הֻו‏צהװזז׀מזזְךזְֱזזזצמזזÿ׀זו׀זהז׀ִה‎׀זוהצגמזצֽֿזז‏אוב—בזצצגאז‎ךא—ׂ׀ךסו‏צדזזוצצגונ“זז׀מזזְךזְֱזזזצמזזÿ׀זו׀זהז׀ִה‎׀זוהצגמזצֽֿזז‏אוב—זוזצ‏וּ׀ֵצהזוצצבְ׀זדזְזהז׀וזזזוזְזוֱזזןזזמדו׀םֹזזגםזצְוהאךזוְ‏גÿצזגווְאףבֻ‎צוגזזזז׃זה׀ֽגץמֿג־צָםזָןןהװנםֽע—יֽךÞבֿעעו׀‏סבו‏Ýךֽ‏–יה‏ֽמְ‏ןמßךֿךֽ‏”ך׀ִֿוßִ•ךÝמנבֿעעוְ‏ָֽנ“׳מÞגװהְְֳבÞ–ךףךּטßװָםצגׁאומגמץׂßךהךבגִגבזֳ–ב‘קÝ‏ֿלÞִִדßזטהֿגס‎ב–‏פÞךÊזנצםג‏ׂ’זףגßÿד“‎דָזזְז”ˆˆצהטצלÞזו‏זמְז‘צדִכזצעגזעָזזזזוזְזו‎׀זהזזצבזְץֹו׀גבוציֱוְגדזß“דףוִÿזזזÿמִֿֿןץװזבְזסםֿגסהזִÿלß‏Êיףצ•יֽךסמְ‏אבץִ•יֽךÞבֿ‏סבז‏ֽיֽ‏–יה‏ֽמְ‏סבו‏Ýׁ“ֿÊ׀ְָֲסךואעמ–קבָÞֿÿע׃כףמװלֽזװךזÞפּÿ•’‎פבוֽנּומפִ•ÿÝ’Êֳהבֲפֻבֲס–םך‏ְזזזצזֳˆ“‏ו׀מÊזוװזעכעצזצזהזע׳כװוֳצנגזÿזזגזז׀זוִזצוז׀טהזזזזזֻ—זזְמ‏זג׀ֵצוְזזצזדזזגדְֱצוז׀טהזזזזזֻ—זזְמ‏זגß‎צז׀זזזזֵזוָץגÞִבוßִױב־‏–יד‏”יִֽֿמְ‏ןוÞך”מץעאו׀‏סבוִנבץצאמ‘—׃ף—ßÊאׁÝןÞזלוÞגץזִעˆיבזגזֽגױֲֽמױט‏ß־ְÞעיאואײף–ץךֳֹװֵמֿ׀מכÝזזז׀ז׃ˆˆצהו׀לְזוָזלזז•זדיזךדזָג׀‏גז׀מופְזזזזמדזזםֹוצגדז׀בֱוזגוזץ“וףהּ׳זזז׳י־ּ–מץזאְז‎ל׀‏ןבפװנם־‏–יד‏”םֽע—יֽ‏Ýךֿ‏נבץצאוß‏נבץצאו־ךפיֽע—ם־ך־וֿעעבֿ‏ÿב׀מ•יףצÊםÞ‏ֹוְ‏סבו‏Ý–נ‎הצד׳Êק•ּךב’זצףֻהפ—‎ÝצÊ—ֳצףג׃ק־‏Ýלפזֵףֻיןם׀ֲּאֽזדהםלטףֿטןף׃ֹטֻּׁןּמÞיד“ִמֻßהק–—׀זֵבאמףםויפְֱכßסגק‘בט־—׀צ־ךעוץ׀ם—ונזזמזקˆ•זּגהיזזנזהמזֿױעגזצעגזע׳כװוֳצנגזֲוְגבזזגזוצבֹזזצגזֻזזְמ‏פ׀זזזזיֱזזךדאְיךא—ׂ׀םבו‏צוװאזצעזזצזבזנִזזזזדזזיֽזזצגזֻזזְמ‏וג׀ֵצהגזזְזגוצמג‎׀‏ווצזוזזעו‎׀זזז׀ךזס׀זזזזיֱזזךזז—‎נעזטבßִÿמִֿֿםץעֻםֿזןוßּױבÝמ•יֽעֹוְ‏ֽמ־‏Êיףצ•ךÝמנבץצאו־ךפיֽע—ם־ך־וֿעעבֽטץט”ֻףזץֻהיףßֶךָס–ְמֿÊ׀ָֽנךה׀׀כÞ—Þכאֻוֽנּומפִ•ÿÝ’Êֳםלץֱֵֻֻזע‎ÿעּß־ÿּ׳ץÿׁˆˆזה”ˆזמÝזײזזזְגֵזזדˆˆ׀ו—זזזוצלעזזמוןדךזˆˆזק׀זזז־גהָזזהזץ—ÿזקˆˆזגֽˆזמ‏זײזזזְגֲםצדˆˆ׀זÞזזזהכְלִזזמוןßּזˆˆזפׁˆ—זֿ‏הױְזהזפזֳזקˆˆזהˆˆזמßזױמזזְגֿזְדˆˆ׀ובˆˆצהא׀לעזזמומ־ִזˆˆזצˆˆ—זֿ—הָזזהזפךֵזקˆˆזהˆˆ“ְמßזײזזזְגּˆצדˆˆ׀זֽˆˆצהלְמÞזזמוכˆװזˆˆזֵ׀זזזְֲהםְזהזףזÝזקˆˆזג‏זזזמץזֽמזזְגßבזדˆˆ׀וגˆ“ּהבזמ–זזמוך־זזˆˆזכׁפז־ָהכְזהזףךףזקˆˆזגֵˆְֿמפזּזזזְג—ג׀דˆˆ׀זײˆˆצהכזלÞזזמויֱךזˆˆזצֱאזִֿהםְזהזף‏ּזקˆˆזדˆˆזמ‎זײזזזְג”גְדˆˆ׀זײˆ”‏הכזמ—זזמוטטװזזזןˆףˆˆ—זקצהָזזדזה‎כװהֻצנגזכזזזזםּװזזצגֹזע׀ֵצזּזזזגזְ׀זוזÿץ‎׃וגצזְְנלßךÝזפטטֱ‘עטצלְˆסצזזזךזכֱˆ—זÞָהָזזדזוִזקצגלװצ‎ּץגׂ׀כסו‏צז—ךה׀ְדהזזֽו׀מהוְםלא—זידזװמז׀ְדמ׀ִהזְ‏הפֻֻכװז׃צנגז‘ז׀גזהזהדזזִבהְ‏ןִזזלהצעלהÿ׀זזצװוֿזזמזז‏ההז‎ָוזגהזזעןזְסֻזזּכה׀ֻסזזּםה–—זה׀ּכףץ׃כװה–צנגזז׀גזהזהדזזִבהְעןהֹ“זהְּבהְֻזזגכז‏צזהזזאזְְאֶזצוזְזבו׀מב‎צזםה׀װםסצזםהצ׃ֳזזװםה——ֵצדזזזךזְ׀זדהזטדזזִבהְעןהֹ“זהְּבהְֻזזגכז‏צזהזזאזְְאֶזצוזְזבו׀מב‎צזםה׀װםסצזםהצ׃ֳזזװםה—–‎נעזפקף׀טְֽ•מÞ‏׳גץצֶגץגצדזְֳלגאזגצוך׀גֽזÝךÞיץגאוְִ–יֽ‏”ךßגעבֽךÝבפךויד‏”יֽ‏–יה‏ֽמֿעעבֿעעו־ך־םֽע—ךÝמסבז‏ןוְ‏ןךÝמ•יÝךןמצמ–טֱ‘עט‏מו׀ֻדגץֻמאֻצגוףÝ‘ז‏ןל־ָׁאß‏ÿוßֵא־אֶֹֽ’טכד—קßֿגץהßּÿˆװךהָק–עזףִיזץךדאְךָוÞװנˆ׳—םווÝÝסלןץ—ˆכפזֹגצִנדץְִמץßפֵ־“”מץךײבז׀‏ְִזזוזזˆˆצדלצלְזזךזב׀ז׃זדצזÝֵגא‎גץכװה–צנגזץדזװמז׀ְזכ׀ִהזְְֱזצִםז—ֵָצוגךה׀ְדהזךׁו׀מההווו׀ּדפֻֻכװה–צנגז•ז׀גזהזהדזזְההמךזזצ׀וֿזצוזְזבהצמב‎צ“יזְּלזצִאהצֳֻה׀גאדז׀אס׀װווְ‏ךÿצזךוְßיא—ז‘זזזדזמךזז׀ְדְ׀זמזְ־דזזגךז‏צגזצמזוצּהונעטדצמםהְגןוְּן‎צװווְ׀ךוִֻכזצ‏אדב—זדז‏ךףסֻזא־“ׂכֽצׂיה—װלÞֹּם־עּבוצץגץצֶגץגצד׀ְֳלגאזגצוך׀גֽזÝךÞיץגאוְִ–יֽ‏”ךßגעבֽךÝבפךבךÝמ•יףעֽיף‏•יÝךסךßעֽבץצÝךßעֽיÝעֽוְִאו׀םהטֱ‘עט‏גו׀ֻדגץֻמאֻצגוףÝ‘זֳ׳ו׀ׂ׀ט”זֲנֳּןג־ֵÊט׀מךםÞּקזײדסזג”דצגףזßָדלזִױבׁ‘ֳהצצִ׀ָככפ׃נּßˆװץÞ—סןלנכגדגÞאזזזוזזˆˆˆצדÿ׀לְזזךזקְועזבװזכגא‎גץזבּֿווצִ•זצצבאזגךוב‏וז׀םאזצװיוע׳כװז–צנגוץזזִאוצ‏ןִזזךוזמגדזםזזמדז׀םׂזזגצז‏צמזצזזוְִזוÊִזוצזגדזעג‎׀זדגְגםדצךםֶוךץזְ—טזצװלדצ׃ֻד׀גלגוזלס׀והְָצÿצזצהֿויא—וףזזִאוצ‏ןוÿ“זדזצהוז׀הְֱזהז׀צהז”׀זזץזוֿזְוזזזאו׀זא‎׀זבזזצךוצץֹזזךפזצּיז׀ָֻגßגהדצ“וה׀ָיה•עקזצָצגז׳ÿד׀גלהֿוֳזוזלגג–‎צה‎ססצצגסס׃סנ–ץףעֻוטףעßכפֻּבץגזˆוד“גקפצֹמÞעפםÞעץגוצמןפׂßוְוגזףךומ׀מÊיףצ•ךÝמנבץצאבץצנךÝמ–יהך־וÝענבֽךÞיףצÊמÞמאבץצנבץצאמÞמÊיףצ•ךÝמנבץצאוßעÞבֿ‏סבז‏ֽוףךÞיֽע–מÝע•יִֽÝבףךסמßעעךÝךסמÝִ–מ׀‏ןוְִהֿדֹֻדÊֵק־גֶבß“לד׀—ˆקזִײהץְךךßזֵדז“כןוֵָן—‘קÊזßיְמט•סֶזִֶ׳ו׀ׂ׀ט”זֲנֳּןג־ֵÊט׀מךםÞּקזײדסזגÿמÞזֶןץָÿדץזדוְ‎ÿנזצֹזצםיןהמןוְךףהßךִןß‏ֽמ־ְÝמףזמזְּ•לÝּ׀ָככפ׃נּßˆװץÞ—סןלנכגדגÞאזזזזְזֲˆˆ׀וְֳאצזזװזאְזװצהּזזְמזÿ׀זזזד׳כוצגדז׀בֱוזגוזעךוףז׀ךזזזךאְ׀‎בומזה׀זלםז‏םבפװנםֽע—יֽךÞבֿעעו־ךזֽע—ם־‏ֽמְ‏אבץצנך•׳ךףאוְףגßְבßמדוץמסבֿמגגץ׀גֱג’טֱןßטףֹ׀ֵלגיפצד־כÊֶאגֽמזזצזױזזזוק׀אךזוצזמ—זְהצְבז׀זוזעָזזצג‘פ׀מוזזזדÿצזדזÝװדףוגֽאßזגהץְױיÝךÞיֽעץוְ‏ןיף‏•יÝךץבו‏Ýךßעֽץף׀הוצֻדגץֻמאֻצבודÝ‘ןז׀םזצװדאְךָוÞװנˆײעלהß׀זזצזֶזזזוְֵאףזה‏ז‎ֵעךזצגזזע׳כװז׃צנגזֽזזגזוזזוִזזגז׀זגז”׀זזזזהÿ׀זהזֽ׳כזזךדוס—זוצעוע׀ֵצהצזזצזגזזגגְֱזגז׀זגז”׀זזזזהÿ׀זהזֽ׳כזזךדוס—זוצעועß‎צזּץג־ִֽם־ּאהץָױיÝצ•יִֽ•יֽע—ם־ך־בץצנבץצאמÞמÊיףצÝךֿעעוְִאוְִÝךֽ‏”ך׀ִֿא־װÊמהָׁאß‏ÿוßֵא־אֶֹֽ’טכד—קßֿגץהßּÿˆװךלםעזְבß—ˆכפזֹגצִנדץְִמץßפֵ־“”מץךײבז׀‏ְִזוזוֱˆˆזבֶז‎זזטְהמצז“סזצךבךְגהזßצוזזמדפּׂ׀דסו‏צה׀זוצצדוזס׀זזזהזצגזִזזדזזמזז׀םֹזזצגוֻזוְ‏‘פ׀זוזצְֳהזגןו—ךןףו׃זכְזבוזךגוציזזזהזצמזזÿ“זז׀זהזזךה‎׀זגוז‎ֱזז‏אטּװזזצגן‏זְוו׀ֳדו—ß‎צוזזזזז‘זדּּםÞךֻג־ִּהצֵּלß‏Êיףצ•ךÝמנבץצאבץצנךÝמ–יהך־וÝענבֽךÞיףצÊמÞמאבץצנבץצאמÞמÊיףצ•ךÝמנבץצאוßעÞבֿ‏סבז‏ֽסף“ֿאֲִֿהֿזךקÝ׀ןלְּ‏דדךצא׀׀טהß׀ֶאßקטֽ’ְךף‏הקד׃ֻנְצֽמוֳָאִֿיגזךאוֳֻ‏והִוזּ—ִמְִאזßךכגß׀ֱב־ך־לדךֿךזְההף‏ױטףװזזזמזגזזזזÿָוּצזסזו׀זטעז•ב׀גדזְִוזצךהפְְןזְךגזצגזז׀בֻזזמהטּװבזצזזוֻ—זוְ‏וּ׀נבֿ‏ִבֿ׀ץמֿגץבוצצהצֵּלÝִÝךֽ‏–יפך–יֽ‏”ךßעÝבפךסבדךÝבפך”יפךאו׀‏ןֿפּןהזִו’ֶץ—ִפםׂ‏זְ׀ֹלצִהְװ׃ל–ֶףןßןכץעִ׳‏װצךףמ‏זזזוזהקˆˆזבֿז‎װזל׀דןצזָֿזצמןהזגוזזםלפזםעבֿזךזזדזְזאז”זזזזגוזא“זו׀זהז׀ִה‎׀זבוף׳כזז‏אוב—זוזצ‘פ׀זוזצְֿהצגמהגךמףו׃כװז–צנגזßזזךהזזמדזן“זזזגוזא“זו׀זהז׀ִה‎׀זבוף׳כזז‏אוב—זוזצ‘פ׀זוזצְֿהצגמהגךמףו׃זךְזדזְזהז׀וזזזוזְזוֱזזןזזמדו׀םֹזזעבטּװזוְ‏גÿצזגוד׳כזזגוהאזםזצְמצ׀ֿךנסֻזגצזזזהװזל־צץג־גפםהִּהְִּלß‏Êיףצ•ךÝמנבץצאבץצנךÝמ•יףצÊמÞמאוÞך”ךÝמ•יÝךןמ׀ִÿיֽ‏Ýךֿ‏סבז‏ֽ‎גגְבֿ‏ְהֿצטםָֽֿמְֿֿגו‎Þßזיזֿ׀נ•ְ—ואדזֻפגֱÿצצּןßְֳןוגמבצךאהדצÊידְ‎אי“בהֻֻ־זֿזץצףװˆפזזזזְזֿˆˆּוְֽא־זו‏זמצוֻ׃צװווזמופּׂ׀ךסו‏צוזזְזגוצמג‎׀זוזצוֱזזזזטּװןזצעבז–אזצךדצ׀יךא—זֳזזזזזצמזזנִזזְזגוצמג‎׀ִווצעדÿ׀‏וז׀ידז—ß‎צוצÿב׀זזבÞגÿמו—ֵזו‏זבפ‏ßבזְםבÞװנםֽע—יִֿסם־ך־וְִÿקְמÝךֿ‏סבז‏ֽיֽ‏–יה‏ֽמֿעעבֽיˆÿײטדוְ—ע׀צדוÞגֱג—סכÿבְֶן־ךֳךו—ִו•ב‎ֱןךבןזבטפזגהדצ‎ביֽßצמדמֹלֽסטכד“זזזגזבˆˆ’זס“וֽזזִזבל–גזגזזְבלפזֻעבֿזאזזוזזךזזÿזזזזזהÿצזהזֽ׳כוזגדז—ךדףו׃זאצזוזזךזזציזזזזזֻ—זזְמ‘פ׀צוז׀ידז—ß‎צז׀זזזזִזוװץגÞִבהץִױב־‏–יד‏”יִֽֽמְ‏ןוÞך”מץעאוְִאבץצÿבֿעעו־י’לֽוזקהפ•גß—דוּֿלזף—ךיצ“וזמָןזְִןß׃כץדְדְִיֵףגםקוילפßצֶגזע‏אְזדזוױˆ׀בׁז‎גזאצזֻזדזזיעזÞלÞעפוצצדזְבלזזמהזבזזזז‘פ׀עוז׀ךוÿ׀צוזצבדזע׀ÊםְזזםֽזÊכÞזֲזוּזאהװאהץעױב־‏–יד‏”ם־‏–יד‏•ךÝמנבץצאוß‏נבץצאו־ךפיֽע—ם־ך־וֿעעבִֿאיֽע—ם־ִאבץצנך“בֹךß—ִם־ֳטיÝ׃ףטפזׂטד‎פלÝקםֿװ‎ןÝךײדפצצץִ׳םזעׂי־‏ױוְװׂמ־גםהְ׳מÞעגגֽעׁכףװֵזצ—ּגוְְאֿמÿםזÝֹןßצֶםץװעלÞ‏ָזזזהזהןˆ’׀אץז‎זזבְזֿזבÞ–וצגווצבלפז׃עבֿזןְ‏ווצזוזזעו‎׀זגוזםֱזזמהטּװזזזזדÿ׀זדז—‏דףו׃זא׀‏ווצזוזזעו‎׀זזזזךזז•ךזוזצהÿ׀זהזָֽגףבֻזדִֿÿבÞגÿמהצעםה‏׀ו׀ּ‎לÝִנךÝמ•יÞִטז־ך־םֽע—יֽךÞבֿעעו־ִ•יףצÊמÞמאבץצנך•ְבהÝ–‏וזךבמÞמעץג׃ֵנב’ֱ׳מנֹמו׀‎ןפגֳוזבפפזגהדצ‎זטף’צ‏סֻ‘ֳצÿךף־׀ך־ּױךְזהזו“וה׀ב•ז׳זה׀זֶזהßזלצזהזְוֱזזזזסּװבזצךדזסגזצגוס׀בךדז׀זזז׀ֶדוּעגְזכזזָּוְָסלßמÊיףצ•ךÝמנבץצאמÝ“היףצÊם־ך־וְ‏סבו‏Ýֶּßך‏אוךףאזÿגְךבגֿענגְצץןזגכֱג’טֱןßטףֹ׀ֵלגיפצד־כÊֶאגֽמזזזגזל׀גקזףהÊ׀זףזהץזמצְןוזךגזזגופְזוזע’כזְגזזזיֳזזךדף׀יךגץצֶגזצלאהװףךÝמ–גצ‏אוÝע•יִֽÝגץצנךÝךסמ—עו׀ֻדגץֻמאֻצגוףÝ‘זפװיזץךדאְךָוÞװנˆ׳—םוו׀זזזגזאְגקזנ“הְָזÊזאנ–דזגוזזבלפזכעבֿזמ׀זוזזצזזÿזזוזךזוזיזזזזזֻזזְםנפ׀זדז׀סֳזזעבף׀סךא—זּזזגזוזזוון“זוזךזוזיזזזזזֻזזְםנפ׀זדז׀סֳזזעבף׀סךנעזםגץמֹמÞ‏׳וְֶָלßך—יֽ‏”יֽ‏–יה‏ֽמֿעעבֿעעו־ך־םֽע—ךÝמסבז‏ןוְ‏ןךÝמ•יÝךןמץָױם־זײכßװנב׀ֱִאßָֿÊ׳“ף־׀ד‏ץגצװ‎בˆדזץֻּצהזÿןף׃מהִץוß‏יבÞזֿןבםׂכִֽֿגÞָעדוֿÞזזזוזוִוה׀בֶז׳זטְדדצז“סזצךבךְגהזßצוזזמדפּׂ׀דסו‏צה“זוצצדוזס׀זזזהזצגזִזזגוז‎ֱזז‏אסּװזזְמדÿ׀זדז–ֻכזזגוו•זמזצִןס׀ֳךא—ׂ׀אבו‏צדזזוצצדוזעדְֱזזזְגהזזבזזצגוֻזוְ‎נפ׀זהזְיֱזזךדנעװזזצגן‏זְוו׀ֳÿו—׀ֵצה“זוצצדוזעדְֱזזזְגהזזבזזךזזְזדזÊִזוזצאÿ׀זאוֻ‎כזזגוו•זמזצִןס׀ֳךנסֻזגזזזזדָזטפצֹמÞעפםÞצםהֿװױג־‏–יד‏Ýךֿ‏סבז‏סבו‏Ýךֽע—מÞמןיץ‏נךÝמ–יה‏ֽמְ‏סבו‏סבז‏ֽמ־‏–יד‏Ýךֿ‏סבז‏ןבףמנבֿעעו־יסק־גֶבß“לד׀—ˆקזִײהץְךךßזֵדז“כןוֵָן—‘קÊזßיְמט•סֶזצװֽמוֳָאִֿיגזךאוֳֻ‏והִוזּ—ִמְִאזßךכגß׀ֱב־ך־לדךֿךזְההף‏ױטףװזזזמזגזגקזÿָהָזזסזו׀ז‏ּזלב׀גדזְִוזצךהפּׂ׀לסו‏צו׀מו׀מדוזגוזזךו‎צזהזּ’כוצגזזז‎ֳזז‏אף׀‎ךא—זִזזמדזָךמו׀מדוזגוזזךו‎צעוזזזאÿצזאוּאףבֻזגו‏נבֿ׀נןוג־גץגעבוזםהֿװױגÝךÞיֽע–מÝע•יִֽÝבףךסמßעעךÝךסמÝִ–מ׀‏ןוְֲבלצִכװד׃׀ןֻ׳ןץßמÊ’ֽװהדהִ׳ד׀גױהְװ׃ל–ֶףןßןכץעִ׳‏װצךףמ‏זזזוזהךוה׀בֿזײָזל׀דןצזָֿזצמןהזגוזזםלפזםעבֿזךזזדזְזאז”זזזזגוזא“זו׀זהז׀ִה‎׀זבוסוכזז‏אוב—זוזץטפ׀זוזצְֿהצגמהבִמףו׃כװז–צנגזßזזךהזזמדזן“זזזגוזא“זו׀זהז׀ִה‎׀זבוסוכזז‏אוב—זוזץטפ׀זוזצְֿהצגמהבִמףו׃זךְזדזְזהז׀וזזזוזְזוֱזזןזזמדו׀םֹזזעבעגװזוְ‏גÿצזגוג’כזזגוהאזםזצְמס׀ֿךנסֻזגצזזזהװזל־צץג־גפםהִּהְִָלßמÊיףצ•ךÝמנבץצאבץצנךÝמ•יףצÊמÞמאוÞך”ךÝמ•יÝךןמ׀ִÿיֽ‏Ýךֿ‏סבז‏ֽ‎גגְבֿ‏ְהֿצטםָֽֿמְֿֿגו‎Þßזיזֿ׀נ•ְ—ואדזֻפגֱÿצגכםו‏ןץ׀ץהועדוְְ—םֽצ“אץֲֽוצ׳‎‏ְמצגעגק—ְזזְזֿזצְוְֽלßזו‏זמצזצדּכזצצהזעָזזְזגוצמג‎׀זוזצוֱזזזזעגװןזצעבז–אזצךדס׀יךבßִזזוִֿבÞזֳא׀זנזועÊךץצמהִֿױג־‏–יד‏ÿבפ‏ֽמְ‏ןבÝ“הךÝמנבץצאמÝ‏•יףצÊמÞמסבו‏Ýֱ–‘ְֽ׀‏יקבךגז׀ִֿןßיבפ–ß‏אֿ“ֽןףזֳןזגמ‏סֻִ׀עִזע’מזצמיוּע•קבזְך־ִײיע“װקְזזזצזÿזצְוÿְלֵזו׀זעױעצזצזהזע׳כװהסצנגז‏זזגזז׀זוִזזזזזםֳזזמהףּװגזצךדס׀יךא—ז‎זזגזז׀זוז”“זזזזהÿצזהזּ’כוזגדז–ִדףבֻזדזזזזו׀זאßגףם׀עלבÞװפםֽע—יִֽ•יÞך־וְִןמÝִֿבצ‏או׀‏סבוִנבץצאמ”ּײךגזםכ‏ףןצךאאצָוקצ׀–דÝְגז־ְִזצְְןß׃כץדְדְִיֵףגםקוילפßצֶגזע‏אְזזז׀זֶזצָוֵ׀לְזוּזםצז׀זדסזך־װֻגְעגז׀מופְזהזְוֱזזזזסּװבזצךדזסגזצגוס׀בךם־‏זזה‏׀ם־ְןְז‎זוְױוְָסלßמÊיףצ•יÞ‏Êיףצ•יֽךÞבֿעעוְִנבֿעעוְ‏ֽגֽ‏–יה‏ֽמְ‏סבו‏ÿוֽ‏–יה‏ֹוֿעעבֽטו‎Ýךֳןה‏ֹףִֽעÝְּכְֽ•ע־װˆדÞ‏ֵאץÝלְ—ּט—גÿלפצוה־“•ם־װאהÞ“־מףװּלהּֽםצצפיפ׃טßװודפצצאהזֶגִּֿדטֱִבוָֻאßצױם־ְזזְזֿזק‏וּצלֱזו‏זמצהג׃צעוזצעופּׂ׀אֻו‏צהזזוזצהÿ׀זהזֻ‎כזזגווסאזצעבעעװזזזזדÿ׀זדז–ִדףו׃כװהוצנגזֳזזזזז׀זד‏׀זגוזםֱזזמהסּװזזצגבÿ׀‏ווצסץזע׀ֵצוװאזצעזזצזבזנִזזזזדזזיֽזזצגזֻזזְםנוגß‎נעזטבßִÿמץְִםוצּםֽזןהּֿױגß‏Ýךֽ‏”ם׀“המÞמÊיףצ•ךÝמנבץצאםÝ‏–יה‏ֽמְ‏סבו‏Ýֶזעכקסְגז׀עֽמֿץגפ–׃‏ÿֻְִֶּֿןוֳּמץ—וג׀בפפזגהדצ‎זטף’צ‏סֻ‘ֳצÿךף־׀ך־ּױךְזזזצזףזפעוִזלֵזגּזטּז”ם׀גוזּמ•לֿ—ץוצ‏זזצמווצזדפְ‏ווצזבֿזךוזצצוזזעוזאִזזְמׂזּ׀זזזוםזגְׁלהְׁלזִמאפװפםֽע—יÝִֹו׀‏ֽמ־ִÊיףצ•יÝִ–םÞ‏Êיףצ”יֽךÞבßִ”םÞ‏–יד‏Ýךֿ‏סבזִןבÝִ•ךÝמÿבֿעעוְִןבץִנבֿעעו׀‏ֽמ־ִֹוßִנבץצאמ‘עֲזÞךגצצָצאץ‏ךגז’ֽ‎ז“קדו‏‎ד׀ßוזÞךדןֿ׀ִן׀ךּזּצכגוִנדץזט‎•ִטגז—סאצ“יצְךּזßִזפעסגצִןÿ׀םטדפצÿד׀ףזֿמדגצךףדֿגנםז’טזנזמוֿגסבץגאהאגהעז“ּבֿמטגְךץזßךהגְ“ץב־ציף׀בֿו׀ִץבצזוזזֹˆזאסזײזזז׀זÊפז׳עבֿזה׀זזזה‎כזזגום׀בךא—זםזזזוזמךזזצב—נֵצץגזממב־װףך׀גֽהנ‏וםÊ‏הָק–עזזזוזד׀ז׃ְדֵזסעזה׀זֲצוװזזזגוזבִזזזזוÿ׀מוזצזוף׀זזזזװזה־צדהועױי־‏–יד‏Ýךֿ‏סבז‏ֶֽ־“ׁמהגׁכÞא•כ־ג־כ־ֿמפ“זזזגזמצהֻזנװו׀זקזדסכװהֳצנגזךזְגוזצוֱזזזזךצבךא—זץזזזוזצוÿזזזזזסהזצגזזע‎צזָזזזזקזז“Êז׀ְסלÝ‏Êםֽע—יֽ‏Ýךֿ‏נבץצאו־ט‏ףהװװףה—׃ףה׀װףה•ֻכג—ׂכעװױכגװׂכּװװזזמזצˆˆ”זטמוײצזכזוִזלּזֹזזזגזצגהזזבֹזזמהז–בזצךדכ׀יךדז׀זזז׀ÿדו‏פגזזכזזָּוְְסלßמÊיףצ•ךÝמנבץצאמ׀מÊיףצ•ךÝמנבץצאמ”גׂךוְךהֿמהׁמהז׀כÞגוהףזֿמהׁמהמׁˆׂ“ׁמהז׀כÞגְכ׀זוזדֽˆְּדÿזם‏זגְזקצז׀פזצוןזזזזֳהװוהועױבÝ‏•יףצÊםÞ‏Êיףצ•ךÝמנבץצאו—“ÿכזָטןפצָם־מׁפףßטווּףהְִגהפְֲמדז׃ךֽֲהזזדזדÝˆ׀יבזם‏זה׀זÿזהךזכ—זװוזמהזזזוÿ׀ְבו׀ךאוצגוכ׀בךאוְךדזזזאהך‏מֿ“ִדוִךבֿמצזזװזה־צםהועױב־‏–יד‏Ýךֿ‏סבז‏ֽמה‏–יד‏Ýךֿ‏סבז‏ֽמה‏–יד‏Ýךֿ‏סבז‏ֶֽ־“ׁמהג׀ךהגובה“ׁמהז׀כÞגובהׁמהג׀ךהגםכÞזְךהֿמפ“ׁמהז׀כÞגֿכ־ְמדזׁמפגׂזזמזףׁˆ”זקצהֹ׀זלזו‏זלגזֻזזגזזְזוזֹ“זזזזׂפ׀זהזְיֱוזגדזÞדףזװכהß‏כבפעעמ׀עמבÞװףםֽע—ךÝמסבזִדמ׀‏Êיףצ•ךÝמנבץצאמ–מגע–ךגיÝזמכÞֿמפ“ׁמצמּאץץטףֿצ‎ˆײֱעכ־גֿכÝזְמפ“זזזמזףׁ‘זקצו“ְזכזו‏זכ—זװזזמוז׀גהז”“גזצגוזבזזזזßפ׀עוז׀ךױז—׀ךדזזזדו‏ךבץגצזזװזה־צאהועױג־‏–יד‏Ýךֿ‏סבז‏ֽזֽע—יßךÝגß‏סבהטוכÞְמפׂמסצגיÝז”ובךוצÞֿמפ“ׂמפז׀ˆֱֳטבוּונֱ‘ֹאץץטזזזהזוךזזזן־ז׳צזא׀זֱזגֻזץְאזְזבז׀מוזְזו‎צװוהצּÊפ׀“צדצךןו׀ֳֿדזָההזְ׳פ׀צוזְמֹזּ׀זזוֲןץ׀זא׀זֵאּֿ‏בß‏סבוךץגץגץגץגץגץגץהו—ױזצִÝבפךןמÝִֽוÞך”מÝעÝיÞך–ךÝִÝוÝך”ך׀ִÝבפךֽוÝךוֿווע‏ו׳פאֻ“ֶעֿ׳ףÿßוס‏ו׳פאֻ“ֶעֿ׳ףװב“צÿְאאֳֻדז׀ךדזען‎צׁױ‘ֻׁו•זזזוזגקˆ׀ד־זם‏זה׀ז‎צו‏זזזזוÿ׀מוזצגׁזע׀זזזזכזזָּז׀ְסלß‏Êיףצ•ךÝמנבץצאמ”מׁכÞזְךהֿהפְמדזׁמפזׁזזמזץˆˆ”זֱךהֹ׀זֹזדךזיּזÝזזגזז׀זוז”“זז׀צזז׀ץזזזזזֻזזְמׂפ׀זגוזסֱוְגבופבףהְָלדךָך־עֵםהָּו׀ְ‎לÝִ—יִֽ•יֽע—ם־ך־וֿעעבß‏נבץצאמÞמÊיףצ•ךÝמנבץצאוְִטזֿעסמ׀‏Êיףצ•ךÝמנבץצאממֳןוּ‏םוָ‏מצװןוÞ—ֻםÞ‘מססס‘מהֹםÞ—ֱלזָׁךהזְךדזְ’ֽללפע’כףִײאßךידצּצדץױךהסוקעץמםד‏Êאץֻּיהמֶ–פְמדזׁמפזׁזזמזיˆ‘זֲךו“ְזכזדךזק—זזזמווזגהון“זוזךווזיוְגוזצוֱזזזזךעװזז׀ךבÿ׀ִווצעױוע׀ךדזזזדדךךך־“װמÞג‏ב׀זכזזָּהזְסל׀זÊיףצ•ךÝמנבץצאמ׀מÊיףצ•יִֽזֽע–ךßעעוְִאוֿעעבֽךÞיֽע—םÞ‏Êיףצ•ךÝמנבץצאמ׀גץךדזְמפ׀ממו‘מהֹםÞ—ֱלו—ִאץְּאְֿֿה׀ִןכפעֹכָֿסזעךׁמפזׁכÞזְךק””ץגְּי־‏‎אפע—מֶָֿק—ָ׳םףּ׃יÞֵָג׀—יהץזיןÞװ׀םעגזזמזלזאֲזעָהָ׀זץזהךזל—זָןצװהזצזופְעדוזךוזצוֱזְגזזה“וףומפזזזפמßמ־אßּזגצזצם׀‏מבפװפם־ִֹםֽע—יֽךÞבֿעעו׀ִאו־ךÞם־ִֹםֽע—יֽךÞבֿעעו׀ִאו־יפגצגעווֱָןßָגבזגצגלזקזץעדאץֱאְצעזץזצז‎“ץה‎ךֲוץעְמועבן׳ךםגץזלּßִכבßְבצעֲּ׀ָצזזזוזהְוְֹה‎זײךזגצזֱצו׀כזצגזזעָהזצגוזבזזזזׂזע׀זזזזץזוזֹז׀ְסלßמÊםÞִÊיףצ•ךÝמנבץצןו׀‏אמ–זקזץעדאץֱאְצעזץזצז‎“צה׳ךÿהßֱִמועבן׳ךלגזזזזְז“ˆ’מז•זא׳זזװזןְז׳צה‏ֲזצםןזזמוזָצזזזגוזבִזזזזוÿ׀ךוזצזוף׀זזאץִזה׀זלםזצמבפװפםֽע—יֽךÞבֿעעו־ךדיֽ‏–יה‏ֹם־‏–יד‏Ýךֿ‏סבז‏ן‎Þׁמהז׀כÞג“בÞ׀לדֿ—ּלה‏־כ—ּזצָׁמהז׀כÞגְכˆ‘ָווּףהְִגהפְֲמדז׃ךֽֲהזזזזצזםˆˆצוֻצלְזזךזםּׂ׀לסו‏צזװזזזזÊפ׀זוזפִוףו׃זהצזזזצהדזזגוֳבÊ—גץזההו‏ױזףךומ׀גׁ‎ׁֶ‎ְלְˆסצזזצזָˆ“׀וק‘זזךזמכגא‎גץזבצזזזצגזסצזזזזבֳזזגזזע—ץגזממב־ׂßוְוגבÞגסמפְו—ק“׀ץ־“זˆˆזףְזזזקצהײזגןזנ—זזזדאזזֶÝזזכאךÞׁˆˆ׀ז”זזזו“׀לָזצִוִצזזזך‏זוױךזזװ‏Ýל׀זוזהֽˆְֱגֽז׳צזמ׀זÞצה‏זצזוזעָזזצזזוזגז‎׀זגוְגבוזסֽזזךדזֻזזְמÊז—׀זזזזֽזהמֱגפעץבצִמאפװנםֽע–יה‏ֽיףמ•יףע—יֽךÝבפמאבץעעוְ‏ןבץ“הבץעעבֽךסמ‘׳ןןß׀ֵמגֿאך־ך‎הפִײל־‏לאפךְּּׁ•׃פעּמהמֱׂףֻאמפִ־׃ֿ—־ןְָבהץ׀ֿןכװֹםפגזזצזֲˆ”“ואצלעזהךזכגז׳הזגגז׀בלזזךזוזזדואִזזזזבזזסֽזזגוזֻזזְמÊזע׀ֻגץעֿןßזאהוָױבÝמ•יףע—יֽ‏”יפ“היףע—ם־ך–ךÝמנבץעעבֽךסמְ‏סבץצאמÞךֲמßּלם־ָײם׀ּ‎מÝםאפהזֵןוןפ־ֿםפֲןהגִהצעלן־מֳ׃־מֹמע‏’ׂץ־מהצֻ׃ף‎םזזגז‎קזף—הֻזזןזוßזאצזהזזךהז•גזזצגזÿצזזזה‏וףוגץגץזגהוְױגÝךסמßגÝבפיּ•סֳÿ•צלעמק—ױמצזזזצזקˆ”“ז‘זלעזזִזןגז‎זזזזז׀זד‏צזוזצםֳזזמהםְבךגץגץגזצמאהװÿךßגֽיףךץמ׀ÿסֹ‎‏צכסמקÝײזזזוזגֹˆֿזב–ז׳גזד׀ז‎צו‏הזצגזז‏צזזזזÊזג׀זזזזקזזנז׀ְסל׀צÊםֽע—יֽ‏”ב׀‏אבץצנב׀ִוב“‎מפמ‎ֵז—יםפּמדֲÊֶ׀ֵÊ‘׀‎׀מ‎ביאמ־ֳגנב׀זוזוÝˆֿזבמז׳גזד׀זףצוזזזצזוֿזזזזה‏זףו‏ÿזְְנלßִ•יֽע—ם־ִ”ןְמסבז‏אוßßהפֻּדז–ׂאפג־אנ•ענ—‏Êמ—ץצ‎זÊֲ׀ֵÊ‘׀‎ְכˆˆ׀זָˆומ׀כסזצ‏וֲצווזזֶÝזזבוךÞׁˆˆ׀זֲˆואצכסזצ‏וְֲווזזֶÝזזבוךÞׁˆˆ׀וּˆוקצכסזצ‏וֲ׀ווזזֶÝזזבוךÞׁˆˆ׀זקˆז‘זכסזצ‏וֱזווזזֶÝזזבוךÞׁˆˆ׀וםˆעוֳצכפזצ‏וֱצווזזֶÝזזבוךÞׁˆˆ׀זִˆעופזכפזצ‏וְֱווזזֶÝזזבוךÞװזזצזזזיךדֹ׀גֽזזךזאגזסזזזוזצוסזזזזזס—זזצזוףץגצזְְנלßגֿבפגדֹˆßֿזפיצזזזוזזזז—׀ןצזפךזז׀ז‏צועזזזגוזבעזזזזוÿצזוזזביגץזההו‏ױגפגסמצןצˆֽזומ–זזזזגזט׀דמזסזוכְזדזוֿזבצזזזצגזסצזזזזבֳזזגזזע—ץגזממב־װףמץעֿט׀גסˆׂװוכÊֵˆˆ׀זזזצְדֹ׀ב‏זצ‏וֿצז–זזֶÝזזג–ךÞׁˆˆ׀זזזצְו—זב‏זצ‏וְֿז–זזֶÝזזג–ךÞׁˆˆ׀זזק—ועזבֽזצ‏וֿ׀ז–זזֶÝזזג–ךÞװזזְזֶזוְהןזןֲזזעזה׀וך׃ְּדזְגזזע׳כװזֻצנגזיז׀גוזזאגזְגזזהּזףו׃כװוץצנגזיזְגזזהֻכז׀גוזפִוףו׃זדצךוזצזוֿזמוזזז׳זגß‎נֵ‏פגֿמץוזְ‏לÝִ”ך׀ִÿמÝִ”ך׀ִÿמßױֽמבססמֿ־מס‎נמֽׁׁ“קֽ“קֽזזמזלצז‏ז־װו”ְזבזזװזףכ‏םז׀מוזזבלפזםעבֿזדצךוזצזוֿזמוזזז׳זג׀ֵפזעעבֿזדצמוזזז׳פ׀ךוזצגֹזע׀ֵצז—דזצגזז‏צהזצזזלצוךנסÊ•גֿמפגצצמאהװ”םÝךÿוÞךֻםÝךÿוÞיˆס־ן־“פמוסבעְ“ג־קֽ“קֽ“ךזזזגזלצז‏זפ׀ו”ְזבזגט–ז׀גוזזבלפזםעבֿזה׀זוזזאגזזזזלצוךא—ׂ׀בבו‏צזװזזזז׳פ׀זוזפִוףו׃זה׀זוזזאגזזזזלצוךנסÊ—גֿגההו‏ױיÝִÝוßִֽלֲךְססע־קֽ“׀זזזצז׳זוְוכזןֲזזעזצעדזצגזזע׳כװזֻצנגזכזזגזז‏צזזזז׳זג׀ֵפזעעבֿזה׀זזזהֻכזזגום׀בךא—זכזזגזז‏צזזזז׳זגß‎נֵצפגצממב־װ”םÝךÿוÞיספדֽ“פכ“קֽזזזהזד”ˆּצאֻזם‏זגְזֻזויזגהעפזְוןזצגזזןצְן־װההועױוף‏•יףצÊםÞ‏Êיףצ•ךÝמנבץצאוÞִ•יֽע—ם־ִÊםֽע—יֽךÞבֿעעוְִוןוִװהְ“ֳםהְÊמ־םקך—ÿכזָטןפצָם־מׁפףßטווּףהְִגהפְֲמדז׃ךֽֲהוגאץךלו׀צםלו“ְךה—Þק–“מזזמזקצאׂזֶעהװ׀זפזהעזמגזֳאץְאוצצזפזךוזְךזזןצףג׀זזגÞעףםזזפזוגגהוצױזה‏–יד‏”ב׀‏אבץצנבß‏נבץצאמ׀‏Êיףצ•יßִאוֿעעבִֿנבֿעעו־ךויפםקזצÿכזָטןפצָםׂװׁפף׀גבÞ׀לדֿ—ּלה‏וױÞ—Þק–“ממזצ‎ג׀ָןוזָּן־ז׀זפ—Þק–“ממזצ‎ג׀ָןוזָּן־ז׀זזמזקצאׂזֶעהװ׀זפזהעזבעזפםץמהזגִוזצזזלזוךמו“ױזְְסל׀ג•יֽע—ם־ִÊםֽע—יֽךÞבֿעעוְִֹיֽ‏–יה‏ֹם־‏–יד‏Ýךֿ‏סבז‏ןזץ׀ÿכזָטןפצָם־מׁפףÝיבÞ׀לדֿ—ּלה‏־כ—ּזִגאץךלו׀צםלו“ְךה—Þק–“מן׀צ‎ג׀ָןוזָּן־ז׀כףמˆÿְְזזזגזעְאׂזקגהװְזפזו‎זג׀‏בזְומזצגזזןצזזזזפזוגההוצױג־‏–יד‏”ב׀‏אבץצנבß‏נבץצאמ“גׁפף׀גבÞ׀לדֿ—ּלה‏וױ־—Þק–“ממזצ‎ג׀ָןוזָּן־ז׀זזזוזבגוױְד׀זױמזגְזץצז“פזצוןזזזזלזוךל׀גמבפװףיֽ‏–יה‏ֹם־‏–יד‏Ýךֿ‏סבז‏ן‎ßִװהְ“ֳםהְÊמ־םקזןטווּףהְִגהפְֲמדז׃ךֽֲהזזזזצופˆ’מזצהנזומזד—זךגְגזץ׀זזזןצױזצְסלßִ•יֽע—ם־ִÊםֽע—יֽךÞבֿעעוְֳָבÞ׀לדֿ—ּלה‏־כ—ּףְצ‎ג׀ָןוזָּן־ז׀כףמˆÿְֽˆˆ׀זֶזמּהןזםקזצ‏ו־׀וßזזֶÝזזםßךÞׁˆˆ׀ז׳זמּהל׀םקזצ‏וֽזוßזזֶÝזזםßךÞׁˆˆ׀ז׳זמּוכזםקזצ‏וֽצוßזזֶÝזזבßךÞׁˆˆ׀ז׳זמּוכזםקזצ‏וְֽוßזזֶÝזזבßךÞװזזצז“זזזזְֻמÊזזךזג—זצזזזזאגװזזצג‎זע׀ץגזמןב־װףךßגֽטב’ֲז־ֵ•ְזהזגקˆ׀ד־זֳ‏זה׀זÿזה׳זם׀זזוזגוזְזו‎׀זהזְיֱוצגדזß“דףז׀ךזזזךב׀׀נגֿזזה׀זלםז‏ןבפװפםֽע—יֽךÞבֿעעו־ךהםֽע—יֽךÞבֿעעו־יßכֽזֱמדזׁמפזׁכÞזְךהֿזף‏׀מפזׁכÞז־כˆוכÞזְךהֿמהזזצזֲזסגזׁצםסזומזד—זךגְגזץ׀זזזןצױזצִסלßך•יֽע—ם־ִÊםֽע—יֽךÞבֿעעוְִ—בÞ׀לדֿ—ּלה‏־כ—ּזÿגגאץךלו׀צםלו“ְךה—Þק–“מזזזהזוצועזבזֻעזגְזֻזויזגהעפזְוןזצגזזןצְן־װהוßעױגÝ‏•יףצÊםÞ‏Êיףצ•ךÝמנבץצאוÞִ•יֽע—ם־ִÊםֽע—יֽךÞבֿעעוְֱÝבÞ׀לדֿ—ּלה‏־כ—ּÝץִװהְ“ֳםהְÊמ־םקזבßווּףהְִגהפְֲמדז׃ךֽֲהוגאץךלו׀צםלו“ְךה—Þק–“מזזגזלזבÞזנעהםְזדזההßוÊץגצועזזזגוזבעזזזזוÿצזוזזביגץזהוß‏ױװצ‏זץוךֿוÞגזפּעˆ׃ִהםױצזזזגז‏ׁˆגזלגהÊזזדזויזגזזוזזאגזזזזםְוךגץזההו‏ױגÝךץמ•מˆק׀ל‏ˆפ׀זזְז־זזזוְלעזהגזלזוםצג‏קזצמדםץ—הוזמּמפזדוצצהזצזווגָזזְךגז׀מגְֱזגוצךגוÿ׀זוצגדוצבזזגזז׀גזֱזזדזÞ‎כזזזזם׀וךאה‏ץבץגףוְְֶלÞצאוßעֽיפ“היףצ•יÝעÝבץ‏נבץצאמÞמÊיףצ•יףצֹגף‏”בÞצנבßגאוֿעו‘–בכטגםׁץמֳׂטבבפםפגִםצָÊÿפְ־ˆ׃ְֿלהְּ׳ֻזמףּ—גיÊ‎ןֳממן‏•ךאצÞ—ְמהךִדוָאןזֱְצסץגפֲד׀ב“דב’יזזמזאצו‏זֱװהט׀זֵזהװזפעואדְ׀מוְצהזוךקוצגגז׀מֶבֿצדזצךדפְ—ןזְומאßעהזעִזזזזהז׀זה‎׀צוז׀גוז–ִגזצךדזסזזצךוףß׀ִןהװִל־ּװלצעמבÞװ”יÞ‏–ידִֹיßִ•ךÝמÿיßִןבֿעעוßִןם׀‏ֽמ־ִןקְמ–יה‏ÊמÞמאוֿעעבֿ‏ÝאףעױלÝע“יד–מפד——טדעױלÝע“יד–מפד——”דװֽמÝװֽמÝװֽמÝװּֽדעפגְךÝְ—ל־װ–טדצפגְיףְ•לÞָ–ֶ־צם־‏םהצם־‏םזזזז׀זÝˆ’הגְכִזדעזקזודזג׃זפהגוז׀צ’ךזמבז—מ“ךץִגזְסדבְמדזצמגפְזגז׀פדזזעדזְךבזֹ“זזְגדזְבזזזוזמצזז׀ךׂפ׀זוזפוףהְÊמוֲןפעץג׀‏מבÞװּוְִסמÝעׂזֽע—יֽךÞבֿעעו׀‏סבו‏ÿיפִÊםֽע—יִֽ–ךßענבֿעעו־ך־םֽע—יֽע—ם־ִסבß‏נבצזנבÝעאוֿעפיֽע—ם־ִסזֿם–נףְ‎דֱּןß—ֱוְצלÞסיסÊְֿטג–ֿןÞזֱןזֱָןÞֶֻפˆ‘ץיÝמßטיך’טֽב־‏צֶֿנזךֻטÞמ‎מ־ז‎דומטוֶּֿוטקמאֿאףנװאקף—ןץףזֶמ־גֵדßִןגֿװב“ֿמָÿ—עוקדזסÞְע׀םˆ”ÝכÞּײטֵֿÿזזןˆˆˆ—ז־צהָזז—זג’זפÝצודזגופְזאו׀צןוְץהזגגהצגדזְצד‎צָוזְװוזצ׀הזנעזו׀ִבÿ׀זבופ’כזז׀ךזבזזזזׁזג׀Ýךפׂכפ׀׳לומֹםפמץבוגפמְ—מןפװֻוְ‏ֽמ־‏ֹמÝעÝםֽע—יÞך–ךÝ‏•ךÝמנבֿעעו־ך־םֽע—יÝ‏–יהך־וְִÝבפךסבוִÝבפךנבֽךÞי׀מּאאיֶֶ‎ָ‏קףעהזףצ“ג’ßק–ּ׃םפגֿמ׀ְאיּ‎ווִכגזִקזהעמ‏ּו‘יֻוֳףךֲגֿגמךֹ•טםףְָןפמֿאְ“‏גְּ־ִֹּÞגÞעץך”בִֿזזוˆ‘דˆֽ׀ן’זײזזטצו’פזםעבֿזכזזבוְךאוÿזזזזמוזְזוְֱִוז׀ְוזְזדזÊעזזצָוהצגם‏׀זאוְץֱזזצגכְ‎ךא—ז׃זזעאז׀‏בז”“זזזמוזְזוְֱִוז׀ְוזְזדזÊעזזצָוהצגם‏׀זאוְץֱזזצגכְ‎ךנעזפזזזזטצז“גץצָםהצץבהְֻה׀ְֳלßצÊםֽע—יֽךÞבֿעעו׀‏אבץצÝךֽ‏”יßךֽיףך”קְמÝךֿ‏סבז‏ֽמ־‏–ידִ•יףצÊמÞמאוְִןךßעֽו׀‏אמÝֿםß׀ֶםזװוהו—ִאצָדםÿי”הצָָסג‏‘ספעִןפךםוְ׀טאו׀לוְ‘וֿפמצÿֻ׃ßןÝךֵן־ְְאץגפזֿמלןּךבזגטםֽ’אנÝצ׃ךßֽמו‏ךבוזגדְÞיפ׃Êםׁו–ִ׀זזזצזֶˆˆצהןצלעזדגזף—וךםפצֽמ־גְןß“ץגזטדצ׀לד׀‏הלְװהוצ‏הפְִווְמבזְ‏בְֱצוזְמדÿצזדזÞ‎כזזגום—װזוצעזÿ׀זזזהזףזזזזדגזךה׀ץגץ׀ץםצְמא־װּבֿעעוְ‏ֽמ־ִֹיצִ–יÝעןיףִ–יה‏ÊמÝעֿבפמאוֿעסיßעןבףִסוßגÿבֽ‏–יהִÊיףצ•ך׀ןןÝ׃׀פÝיִטעסבץעעמןהגויפזֵהנ‎Ê‎Ê‏ֳכבּגוֿֳ׃Þמ‎מֽֹהזףצםֽגÊףה‏ßםױװִבְְֿמצְÿא–—“ךףֿךטדג“ˆִׂוזֿ“ִוְ“פדוְּזזמזאְזזזְֻהֻזזֻזדזזֿעׂ׀כסו‏צה׀ךזצְטה׀מןזזְן‎׀‏וזזעוזצמזזנעיזצּםהֻ—זהְָÊפ׀צוזְמדÿצזדזÞִדףו׃זךצ“וה׀ִמה–ִךזצְזו׀זמו•עאזצזבזצגהזזבֻדצגםהצ׳ֳזזָלםּװגזצמהז–—זז׀ךֹז—ß‎צוָזזה“װלה‏זםצזּמו“ֳןוגץגץצץגץצץגצמןפװובףךסמßעעבֿ‏Ýבפג–ךֽ‏•יףעֽיףך–מÝעÝגףצÊם־ך–מףמנבץצאמÞִÝךֽ‏–יה‏ֽמְ‏סזצ׃ֿ‏צֶּןׁטמֿװמץעסבץצִּמזגÝְמֲֻׂוװִט—ּˆקץִיזצ‏כעמֶבְְֿמצְסא—מ׃טפ—ודוָÿההב־ÿא’־לבבעףעךב׀זזזְווˆˆ׀הס׀םסזדזזÿצהקצז׃ול׀מגוְ—וזצִהפּׂ׀אֻו‏צה—םזצמדז׀םׂזז‏זוזזאון“זוזִזוזֳה׀ָהז׀ְוזז‏דזאְזו׀ִו‏זעוזצגֹזע׀ֵצה׀םזצמדזָךזוְזגזז‏גְֱזגו׀זגו”׀כהְמדהזגזוְךזֶזזןו׀בְוצגוזפִוףבֻזאÝגßךס—ßנ–ֻ‏ע–ולפףטדִ׳להצֿןß“ֹמצ׀מב־װזם־ךֽדְמסבץצאמÞמֹיף‏•יףע—יֽ‏”יפך־םֽע—יִֽÝבץצÝךÝמסבץצאמÞמֹיף‏•יףע•בֿעסבז‏ןמפ‏Êיףע—יֽךÞבßעאוֿעסבו‏ÿךÝ‏•יףע—ם־ךֽמ־‏–יד‏”ךßעעךÝךוֱוזֵÊ׀צסדְִהְ׀בוץ׀‏ז׀גװמץצאגßˆÊצוצנהז“בוךּפןֿÝ–זָלבו‏מדְעגוצכֶאֿגןד׀—נבßצאגßנזנגÿוÞזßםכָּן׀ממהומÿßפװ—אצךון־׀ֽ‏׀—צן–קגמץ—ההזִ‏ןפÿײבוÊˆצכיןמ’—’גפגֳזְְןאו—אגÝ—ךכף׀גץ‏יןÞָּ‏׀—צן׀זוזה“זזזמֹזײזזך׀הא׃צךוזזְופּׂ׀הסו‏צהזוזעהוצץ׀הְגםזצְוהצֿוְגהו׀גוהצמו‎צזבוציֱזזךדכּװזהזְזÿצזזזהִזףו׃זךזזגוצמבוזםהְגםזצְוהצֿוְגהו׀גוהצמו‎צזבוציֱזזךדכּװזהזְזÿצזזזהִזףבֻזגְזזזדךזךÝעץבהִּםוגÿגצװמןפװֻוÞג–יֽ‏–יהִֹמÝעÝםֽע—יֽךÞבֿעעו־ך־םֽע—יֽע—ם־ך־בץצÿבÝךסמß‏סבז‏ןבףךÞיִֽ”ז־ִֹˆּֽיו‏אÿ–זקֳÊץ‏Þװ־מפ׀צאֿ’‎בובˆִצ׀ֹםגִםְּךֹ‎—מ—מ׃לגעףךףך׃נאָ”ךפגײםß“צןְעלגסּײץדװßכפע׀פץ—ההßצֵזזזוˆˆָזזזםֲז׳צזטְוֳצבָßזצגזן׀ָהז׀מהפְװוזצָוזְךוזÊעםזצךמזצצבז׀ץֻד׀“ךז׀זזדס—ץגזמידפ‎כו׀גבוצ‎ֳזז‏אם׀‎ךזזזזטְז‘טףִ׃לÞָ׳להִֽמ־גְןֿ—עגץגעגץמץבוגפהו—ױזץע־וְ‏ןוÝךסמ׀ִסךßעֽבץצנבֽךסמףעÞיֽ‏–יפך–ךÝעֹמÝעÝםÞ“המÝעֿבפך־בץצÿבÝך”יֽע—ם־ךֽיצםֲאו—ףגןיְֱֲּבֿצִּמֱ–מוװםְ“ךאֱנטדהßזֳןזגָלֿטֲ׀בׂדוְץןזלעמצִןמÞדֽ׀ßצוװÿוÞגֿהוִֶצדגדדכ‘בץךלמפגסדֿׁÊ•ץְצגֿגֿזזגזמ׀זזזׁװהׁ׀זßזזֶÝן׀“וךהװ”ךß“הךÝךֹכְמ–יד‏•ךÝמנבֿעעוְ‏ןוÝךÞיֽ‏”ך׀ִֿיÝ‏•יףצÊם־ך־וְ‏סבו‏ÿבÞגֽכצעטןÞץÝוד־י–ל‏ֶא־‏עֽֿ־קְץÝםץ“טופ—כˆװךצףעװׂנ—ידנÞ’יפßד׀ךÞלז׀ָד–ם“ץֻײןפּײןנֳּ“עְ“ָדהְÞװ“׀ֶֿ•ֳכֲעֳןֲע׃׳ֿֿÊךזזגזלזהֵזֳצוטְזÿזד־ßוÊץגצה—ךזצךוזעָכזצומב׀גהץ׀זוז׀מוס׀זזזזךהזזיֹזזגוזֻזזְגהףÞךֻםהגגהוְױװצ‏זץדִ•ךÝמÿןְמÝךֽ‏”ב׀‏אמÞמֹם־‏ֽמְ‏ןלהֻכםעממלÞזכאפצסמץ׀ßםÞּ–אÝךֳןהצט’–זֲווךלמßךםÞְֲדßמֻןְזזז׀זֲˆִו׀ןזזװזד׀זֵזד׃זטזזזוְגוזְזו‎׀זהזזךגזְיֻזזצבוצץÿזזצגוסןזצעגועצגזזזגוװצאֿ‏עד׀“ידזזכזזָּהזְסלßמÊיףצ•ךÝמנבץצאמ׀ִֿבפגנםֽע—יֽךÞבֿעעו־קÊךףזֽמÝגßמָו–ֱ“ױßÝזßמ־ךßךפךוסÝג־מÝגßמÞמßקסˆּךפךֽךדג־מÝגזזזמזןְוֵזֱךוְֲזדזזִזמּזֱזזזזזצמזזנעזזְךדזֻעזזְמדÿצזדזְייגץגץגזצמאהװףמץעֿבפגסמץ“ו–ֱ“ױזֳÿל׀ב‘ÿÊיֲזזגזכֱˆ’זְמו”זזאזזֶÝוצגוךהװֻוףעֻםףעבזְכל׀ב‏ˆײְו–ִקלÿ׳פףÿװָזזְזֳˆזוְןזז‏זהְזמ׃צְןוְךהךהװ”םפע–וץעבבףעֿבץ—ונˆ‘ֻזֳÿל׀ןס׃”ם–ÿ‘ֶָֹֻֿ‎נצזהזזזזזם׃ז׳צזז׀זאזז־–וצצהזזמ׀ל׀גÝזפגֻז׀ךוטÞּוהֱ•־זֱֵך’ְלעˆנ׀–זֱ”ז׀זזזֱ׀ˆ“װזÞצךÊזהָזוױךףזזג׀ל׀‏Êיףצ•ךÝמנבֽךÞיֽע—ם׀ךÊיףצ•ךÝמנבץצאמÞמÊם־ך־וֿעעבß‏ÿגß‏או־ך׀מוִֶדץגץוְ“‎זצװגלְֶֽמהזפה׀—צוְּןוזךגהצך־קפ‎–ןץצפמזְצצ–גֲגצגיÿ־–—ְץװ‏אוּםגץ—ֲג–מ׀‎ק—ס”װˆזזגזםׁˆ’זֱװו”זזאזזֶÝוזזוךהװובצעבבפע–זֱׁײזב‏ˆ־װו”ב‘ףֻבלף׀זזזְזֲˆזו׀ןזז‏זהְזמ׃צּןוְמהךהװ”יפעסוצעסופגסמץ“ו–ֱ‘ֻזסׁל׀ןסˆ־ׁנײֱֳֿÿםֲמבּזזזגזןזוֵזֱגוְֲזבזהץזמצזוזְאגזזזהזְוסזזזזזֻ—דזצמזזּ—זזזזבזזעץגצצמב־װףיפגץמÝעִזֳסֱזץßֲˆׂןוזזגזגקװזֻ׀ו•׀ז—זגֿזץףג־זְצבל׀‏הוְצךזצגזז—ָןזצצבוְעגוֹ“מזצעבלעװזזזזוÿצזוזפֳכזז‏אזֻזזְמׁפ׀זדזÝךדףומֻמßמײלהצץגְּמןפװּבֿ‏Ýבפך–מ׀‏אמÞמֹבץצÿבֿ‏סבהך־םֽע—יִֽ•יץג—ם־ךֽיףִÝגץצנךÝמ•יßג—ם־ךֽיףִÝגצמ־הו‏ִ–זגִפÝּ–מֿגוהףװֿאְּוגצװפמ‘ְ”מפזנמßָכג־טָיÝגךוהגמהּעופ’ופזךקֿֱגÞגף—ךוקץצימץױׁףּ׀בץָומץצימץױ‎צזזזצזֲזכװו׀גֶזזךזוױךהזזג׀לÞעֿיפגוˆ“ױזֳנÿ׀זוזהִזגצן‎זִךזה׀זאװ׀ּדזףזױיÝִֹיßִ”ב׀ִÿוÞִןם’ֶנצ’ֶנצ’ֶנצ’ֶנע’ֲנצ’ֲÿצ’ֶÿצ׳ֶנזזגזןׁˆףזֱךהה׀זףזזֶÝד׀עוךהװווÝךסמצִֹיÞך–ךÝִֽיפג”ב׀ִÝבצבסטיֵˆעֿטיןהֳטֳ‏וז—ֿיך”זוםÊ’‎ֽהֳֻננ’‎ֽהּֿנצזזזְזֿˆˆצו–צלֵזוזלְזמ׃פךְאזזהךהװנם־‏–יד‏•ךÝמנבÝצֹם־‏ֹם־‏ֽמְ‏ןםÝ‏•ךÝמנבץצאמÝ‏•יÞ‏ֽמְ‏סבו‏Ýװב“ßיסּ—ךעעֶזצגאהומט־זÝבÞִֹק־–ˆֲ”ץÞעהגטעגטÝ׀–דדßֿיףִֿיפִ‎דצִײצו׀צß‏ÿיץעס׃’־ÿ׀פְנ—וֿק—בֶזזעזיׁˆ—זß׀הָזזדזוזזאצזÊזהזעּוקה׀גבהְגדהזעד‎׀זאזזְםוְֹֿזזצגזבהזצזזכּװיזצּםזסךו׀מוזפוףהִֹאָֿץגצצגםÞֹכ־׀ײא־‏ֶםפזֲגץּץאו‏עווזגדÞעץגז“מבÞװוך׀גֽז־‏–יד‏Ýךֿ‏סבז‏אמÝ‏•יףצֽמֿעעך׀זÊיףצ•ךÝמנבץצאו־ך•יֽע—מÞמסבדךהצדֹֻדָˆÿֻ’כפ–—װףפִבדזßךצבלÿֻ’כפ–—װףפִבדזßךצלְˆסצוףבßפעס’ִעÝבקכֿ׃צצ’פעּˆ‘ֵÿבםץÿֻßףךעׂא–ודֻםפףזזזןזדֵˆ׀ץ‘ז׳זז׀זצזוּזםְזÝזד׀זץצוָצאעקזצעטזצךלוציֹהזגאדזגלה׀‏ל‎׀זגוזוֱזְגזזה’כג׀—פז׀װכזסץהץזןוזגוכ׀בךקף——יהִֹאָֿץגצצגקעעץגםזיד׀—טÝּ”םÝךֹך־—ױא־‏ֶםפזֲגץּץאו‏עווזגדÞעץגוצמבÞװוך׀גֽז־‏–יד‏Ýךֿ‏סבז‏אמÝ‏•יףצֽמֿעעך׀זÊיףצ•ךÝמנבץצאו־ךְםֽע—יֽךÞבֿעעוְ‏ֽםד‏–יהך־בץצÝמד‏–יהך־בץצÝזֽ‏’ˆ׳צ‘יס’ֲפ—׃ֳכג—ׁןוצ׀ךףגויֻ’ֲפ—׃ֳכג—ׁזפֲֳÿּ׃כÿפßיכˆ‘ײבדזßךצאטבדזßךצלֱˆסצוףסßפעס’ִעÝבקכֿ׃צצ’פעּˆ‘ֶÿבםץÿֻßףךעׂÿבםץÿֻßףךעׂא–ודֻםפףעגטעֻםךזזצזֲזזזו׀ןסזזװזם—זּזְגזוְעהז׀צזז•עזזצג׳פ׀זגוהִגףזזזזזװזהßגץגץגץו׀ְ‎לÝִ–ךÝעÝבףךסמßעֽיץ‘ÿױÞÿױ׃ֱׂ׃ֱׂװזזְזֲזזזו׀ןסזזװזד׀ז‘צדִהזצזמוצמדוזזד‎צזגוזבֳזזגולעװםזצִןוֻ—זוְ‏ֹוּ׀ךדזזזדזךד׀“יזזװזהßגץגץגץהְְ‎לßך–ךÝעÝבףךסמßעֽיצעסמףעֲׂ–‘ׁב“ואׁ“ױזציֲֳןץֲֳןפּÿ–זזזגזמׁ‘זֱ‏ה•צזמזזֶÝוְזוךהװÿז׀ִֹיßךףך׀ק—ּפ“ףֶָÊׁךױאזסצסל־ׁװזיֵˆאגזזצזעˆÝָהְֵכ‎זוךזוױךפזצג׀ל׀גומץִֽכְמֽמץךומףמ•יִֽÝוÞגוצˆִזֽמךא׀‏‏יהˆׂכ׀ב׳לפ‏ףוץָךˆֵמוןצא׳פ“Ýבˆ‘ֽˆּּךלהזזזמזאˆˆְזֵצה׃זזבזזּזהכעםו׀ךזזֽזױופךדגÝךףמץךףז׀גץסלל־סלק׀ֹבÞִ־זוְֶבײˆ׳ֵְגפזץגזזזגזסˆ‘זכעה•צזדזויזגזזזזצהדזזגול׀בךגץזההו‏ױגÝךץמ–ֲֳÿְכ‎ˆאגזזְוÿˆ‘—ז׃צםֻזזךזו׀זָצהעזזזזוזְזו‎צזהז׀ךהסצזהזְיֳוזגדזְייוזצגו׀צןגֿגצוצְÿלßךÝבפךץיףךסס–’ֲÿְםֻ‘ק“׀‘טְזזזמזםˆˆ—ז׀הָזודזבזזסּוףמ׀גםז—ִעזְעםצדהו׀גדפְצוז׀זםוצךם‎׀׀לזְעהזצגןוצבֹזז‏אזבזזזזׂפ׀זןו׀ֱֿה׀גמההמףגץגזזוגעגץקפְּזצ׀והם־‏Êבהעֹם־‏יהו׀ױוה‏Êיףצ•יֽךÞבֿ‏סבז‏אמÞמ–ידִ”ם׀‏אמÞמÊיףצ•יֽךÞבֿ‏ÿיÝךדוְ‏סבו‏Ýךֽ‏•יףצÊם־ך־וְ‏סבו‏נךÝמ•יßִאו־ךÊיִֽ”ם־ך־וְ‏סבו‏Ýזףאֽ‎”ֹז‎–Þנסּב׀צע“דדזךֳנףז׳טף’–ףְץגְְדֵעךהו׀ְלמדךִק•׃וס‏ֳכךןסֱכבּ־ה־‎ׂיְ׳ךבפמטגÞ׳דםְװךדגטל‎נ•׃‏ג–פד’׀צÝעכדףגהט—ע–יףֳ—ףצצםז׀Ýˆ׀ְÿוְ‏אט–װ׃צ•ְ“ÿ׳ֳעצןסיגצ“ֳאץֽÿִף׳ֳה–םׁםֿך‎זזךזבˆˆ–ז׀װהָזזׁזדװזצְופצג•ן׀מבו—זˆכÞזץוצְגזָּמזצְופצזבוְגגהזעג‎׀ּוו׀ִדÿ׀זדזÞ’כזזזזזס—זזצגֹפ׀זמהזםֱזזמהכ׀םךךדזקדזךדָץגץ׀װמÞגפהְְֵלÞצנבֽךסמÞמÊם׀‏ֽמ־‏–יד‏•יÞ‏Êיףצ•יֽךÞבֿעעוְ‏ןבÝ‏–יה‏ÊמÝעÝבפמאוְִאו׀זאבץצנבִֿ•יֽע—מ׀מÝךִֹֽוֿעהּףֻּןמוםץץֻףֱא•ץכּּלפװֶד’ײנֿבצֵ‏‎דוװֳ׃הזÿהצצךןקױלßְֲמפְִפ’•ןצÝְׁםנצ”גֿװ‎אדßףנֽבדכוָ׃ףÞּßפה‎דטß—װלßדיפ׀ÿבז‏‎אצצץאגָ‘זֳִװמָֿׁםהמֵיפ‎ֹˆֶ׀ּ‘Þֿצזזמזבׁזְעהֻזזםזומזמ—זְזזגוז׀בלוזגוז׀אגזזךדזבהזצזזםְיךגÞגץגפעבהוּױיÞ‏Êיףצ•ךÝךץמßךÝבפך־וֿעץמ‘ֳגףÿסֿמנֶֿׁףָףהÊֵ–בא׳כ‎ןכ‘ְךנמוך‎ˆף‏זז׀זֲˆ“ה–זלֲזזזן׀ווזןאßוÊץגצא‏קצמםו׀בלזז‏גוצעאִזזזזזמגזזםֹזזצזהזִגהאִזוצזןהצען‎ְזםדצגלז׀ּל‎׀׀וז׀גוז–ִךזצךדזסכזצגדזעְמוזצזזזְצפוזטÝּ–ךÝג׀כÞ“װל־ִֻגוצןְֿנזזזד־‏טהועױװצ‏זץזצÊםֽע—יֽ‏Ýךֿ‏נבץצאו־ךזֽע—ם־‏ֽמְ‏אבץצנבֽךÊםֽע—יֽ‏Ýךֿ‏ÿבֽךÞיÝִÝבÞךÊם־ך־וֿעעבֽךÞיִֽÿוְ‏ֽזץֱׂÿֻ‘ֱÿֻ‘ְÿס•ְÿּֿ”ץּ‎”ץ—ֳ“ץּ‎“ץ–ץײיסװ“אפגנגְִםז׀צקו־זאךה—ךדםזלֽ“כבֿוטקֿםֳֹֻ’ֳֹֻßִֹֻ–ֲֹֻ–בפÿ’יףןםפÿךףÿ’םפÊ–ֱקב׀ÞהזִןהזֳˆלÝץִץ—ץֳםְֿיםֽ‏זוזזֲזק“ו׀צלֳזזזן׀ובזגזִכגא‎גץז‎פוהזװופְזזזזמאזזםֹזז‏ךזצעכוְסֹד׀גכזזְגה׀ֹֿהצגגהְגןז׀צן‎צ“וז׀גוז–ִטזצךדזסיזצגדזעןץֿזצזזוךפּ‎קץ—בץגיהקÝ—’טהָָםÞ‏ֿמוזֱגו“‏בְזקזז“Êגזְסלגאזגצ•ם־‏–יד‏•ךÝמנבֿעעוְ‏ֽקְמ–יה‏ÊמÞמאוֿעעבֿ‏ÝםÝמ•יףע—ם־ך–ךÝמנבץצאוßענבִֿÿבֿ‏ÝבפךÊםÞִÊמÞךסבו‏Ýבפך”ךֽע—ם־ך־וֿעס׃Êז“טאז’טנז’טאג’כגְײלּּײל—ְױל—ְױֶומכהßם“להךֱאץִקוְעדג׀ֳודזעמוßװךהֿם׃ÿ־“‏ג׀װבˆֱֽֿטףֱֿטדֱֿטדֱֻטהָװףה“ׂףה׀װףה“ׂףהßאו׀Þֳדצִטןְֿ‏ןְךווֿצ‏אזװיד׀ָ‎לו׃גדזִקֳÞ—‏בצעםףזזזזְזױˆ’ךהגְלְזד—זף׀וֻצזֻמקÞגהוזגגזע׳כװזֻצנגזֱזזצבזצעגִזזוזְמוְֵזהזזזהזאצזוצעדÿ׀זדזÞ“בףו׃זמצזגוצגבוזבזזגהוצגהֱזזהזזזהזאצזוצעדÿ׀זדזÞ“בףבֻזדדךßלÞּÊםה‏ֽםצ‏מבÞװּוְִנבץצֽמ־‏–ידךÞבץצאבץצנךÝמ•יףצÊםÞִׂזֽע—יִֽÊיףצÝךֿ‏סבהך־יףצ•יףצÊמÞמאבץצנבßֲִזֿעאבÝ‏•יףצÊםÞִÊם׀‏אבץצנבßִהג־“ׂד׳נסÝָ’ה־ךֻל־ְֹטדװצß׀ׂכְ‘סִֻ‘טצָֽםפָָםÝְקעךִּץלהֽךי–זֱהְָÝקֱֽבקß‏ֲל‎‏ךףְ—דָֿןגץ‏ְמß“ׁמהג־יÝָֹיֽנן־ÊנטÝג“יז“ֶוßגנמהךֲכÞזֿמִֽ‘ם—ָ־הץצצמÝְ־ן־װ־הץצצמÝְ־ןְזזזְזָזפזד׀׀לעזוָזץְזמ׃ףךֻאצ׀הךהװףךÝמ•יץגֽמ־מאוÞך–מץעֽכְמֽמßגעךÝךסמÞעÞיֽ‏–יףצÊמÞך–ךßִ”ךßעֽמֿעסבו‏ÝךßעֽיףךÞיֽע–מ׀ךֽזÞךסבו‏נךßעִֽפ‏טהֿװאךßִבב׀בÝב׀‏פאפמִגÞױֿזעג‏בצִמדֳֶֿׂ•‘‏אßִלדßֹדב׀“לומ׀ע־זךןאץיזףװצג׀ג‎אß’נסֿ“‏זˆֹמßװֵהֲָֿ”ְקאˆד׀אßגֿגֵא׀עֱםזףֱֶןßּלא׀זזזְזֱז‎צוכְלֳזז—זאצז“װצ‎ּץגז׃זזזזזְךזזÊִבזצךוזציÿוצגדז׀בֱוזגוז׀בקדְ“זזז“‎דְֿעגְזיזז׀Êוְְסלגאזגצפם־‏–יד‏•ךÝמנב׀‏אמÝ‏•יףצÊמÞמאבץצנך“זםהצםףֿצזציטטהצ׃כפצֽלÞװֽז‎צֽקפעֻקהיךטדֻךךףצְמדךÝמהז—זזזהזהˆזכÞז׳צזןזז׃זז־–םו—אזזמ׀ל׀צÊםֽע—יֽ‏Ýךֿ‏נבץעֿמֿעסבוִנבֽךÞיִֽÝוְ‏ֽגÝמ–יףצֹם־‏ֽמְ‏ןוֿעסבדךוךליֱÿ‘יְ‏ליֱˆִמגההֻßצגם”לÝצÝּ–ףִוְָױֵÝ׀ˆִהװמוזßֶÊֻßִÊֻ׳ֶÊֻ׀מוכְמדה–קדצץ׀בֶוױְךה־׀Þיה“ךהױצאזזמזןˆˆßזֳמהצזֶזהךזהכעֽןצװזזֽזױב־‏ֹוְִֹיִֽÊיףצ•ךÝמנבץצאוß‏Ýךֽ‏”ב׀‏ֽגֽע—מÞמאבץצÿֻ‏ֳמ־װֵךפמ־ֳֵֻדפ”ץױםֻצּטץ“‎פסװָץ־“ד׀—יץ“ֲםפעְנָׁיװ–׃עֳֶ–ֹ‏ß“‎םעוִֽסּס־ףצזוזד‏וצְןעז׳צזוְזֿװצ‎ּץגזנוזגוזזבלזזזוזמךהזצגוֳומץגזךמבÞׂßוְוגגÝךףמÞִןמ׳נ׳אבֵׂ•זהֻק‘ׂֱגזזזגזמˆלז־עהֹ׀ז’זהßזלףג־בזִגזזגופְזבזזנגזזמהכּװגזצזזזסדזצגולצוךאÞצ׳להצײוְְֶל׀צֹםֽע—יֽ‏”דְמֽמ־‏–יד‏ÝךִֿÿםÞ‏Êיףצ•ךÝמנבץצאו׀ִ”יֽ‏Ýךֿ‏סבז‏ֽמ־‏ֹם־ִנבֿעעו׀‏ןמ׀גךבצװיד׀ממצעמנםהמ־םה׳ֽבֿענבףגֹםÝזףבֿ‏ףיגמֶםהמ־םו׳בל׀׀םדז“כג׀ִֽה‘ֲֳגו‏ׂםזִדאßך׃אץּ׃ל׀ּÞךף“‏םפגֿםץִ”יף‏מבץ‏׃אץּ׃בßמאזÞךÝאובֻÊ”זזזזגזמˆצז־עהֹ׀וֽזגֻזץּע•לוװגזְיִףץךאוזזוזָּלזצּזה‏צןזצגמזצזםזצוֹזזצגכּװאזצמהז–בזצךדלצםךזזזז‏׀ו־נסֳףעפצ׳להצׂםהְכהוװױב־‏–יד‏”י׀ִאמÞמÊיףצ•ךÝמנבִֹֿם־‏–יד‏”י׀“המÞמÊיףצ•ךÝמÿבÞִÊםֽע—יֽךÞבֿעעוְִןיÝ‏•ךÝמנבץצאמÞמÊםÞ‏ֹבß‏נבץצאו׀ִ•יÝ‏•ךÝמנבץצאמÞמÊםÞִÿבֿ‏סבז‏ֽˆףגסבֿענ‏Þָּמ־מּא—ּ–הזּלה׀װלהצֿוצֿ‏ּמ־מּלÊךנבץ‏סךפִֹךוךנבֿך—צָּֿמ־מּאּעױדזּןהְּמהְְםדה׃בא־צ־מ־צֶצֽצףבֿ‏ףךהֳ׀מפע‏קֽגÞהפװ׃אץּ׃או‏דבֿע־בוצֽבֿעדאßך׃אץּ׃ל׀ּÞךף“‏םפגֿםץִ”יף‏מבץ‏׃אץּ׃בßמאזßצֶמץךפןßװסז׀‏פבÞ—‎אפ—נבצְ•יףִÿםפגזזזכץְמֲˆ‘‏הװ׀זכזוִזךױגא‎גץזם׀מוזזגוזבִהזצזזזסבז׀צדזצזוף׀׀ךזזזךב׀׀נגֿזזה׀זלםז‏מבפׂßוְוגזה‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽˆֹגױלßֱלÞװֱױפװױןßױלßהן־׀ֲןÞ׀װןß“װכו“ֱכה׀ֱן־׀זזזןˆגְמֲˆ‘‏הװ׀זכזהֶßוÊץגצוװזזזגוזבִזזזזוÿ׀מוזצזוף׀זזזזװזה־צדהועױװצ‏זץזמÊיףצ•ךÝמנבץצאמךױלßֱלÞװֱזֿ“װןֿװכוֲכזזוˆװגהבׁ”זׂךזהְז‎װצ‎ּץגזטזזזוזמךזזצב—ג־עההו‏ױװצ‏זץזגÊםֽע—יֽךÞבßִֽˆ׃ּקהץ׀ףלובטיְלןגֿךכגָּֿײצזזזֱ‘—זֹֿˆְֶכÊזזָזאֵגא‎גץזדְזזזצהדזזגוֳו‏ֿזְְנלגאזגצדיֽךÞבֿעעוְִןמˆ“ץלוךִהצָיְכהםוָפהßךפִצזהˆֻגהבׁָזׂךזהְזסזו•ßוÊץגצומהזצזוזמךדזצגוֳו‏־ב־גגהוְױװצ‏זץזג•ךÝמנבץצאו׀ִֽיÝ‏Ýךֿ‏סבז‏ןוÞקֹßגָגß׀םד•ְ•ßגָגß׀םד•ְ•זױּאֿמכגßםßײפצֶגְװףגֹגזזזןצןÿˆ”—הָזזפזוֿזבץמדזְוןזזזזזסזזצגׂזג׀ּבְממב־װדיֽ‏–יה‏ֹם־‏–יד‏Ýךֿ‏סבז‏ןˆץּÊהז—ֲן־ךֱמÞֳדיזן׀זßּצוְךוז־מ‏א־צׁםףמהזזוˆÊעהבׁÊזװגזוְזֿװצ‎ּץגזנוזגוזזבלזזזוזמךהזצגוֳומץגזךמבÞׂßוְוגזףךÿמÞִןמˆס‏ÿז•ֶÊװ•זװאױס–ִזזזןֶזמנˆ‘ּה׀צזאזהאßוÊץגצו‏הזצמזזעָוזצזהזמךזזְם—גץמצז׀ְÿלגאזגצוךßִ”ך׀ִֽˆÊְ•ֶ•ָ•ִאגה׀סֳÿײ׀זזזֱ’Þזֿףˆָזל—זזזכױגא‎גץזמ׀מוזזגזְ׀זוז׀ךוס׀זוזציֱוזגדזציקזזזזד׀זטג־מףוצְÿלגאזגצזם־‏–ךß‏נךÝמ•יÝךעוְ‏ֽˆ׃ֿגמֽמדקה‏ֻקצךÞמּצßזֿצ׃פפָ־םפע־לּּ׃זזזהˆßִהוֱˆֹז׃עזה׀זÿזד־ßוÊץגצה—זזזזהז׀זה‎׀עוז׀גוז–ִבזצךדזסגזצגדזעךדזזזדוִךבֿמצזזװזה־צאהועױװצ‏זץזמÊיףצ•ךÝמנבץצאמÝ‏•יףצÊמÞמאבץצנך‘׀קה׀ױקף—ױבץ—ֳבץעֳןץעהוף—ױכד׀לÞװיץ—נבֿ—ֳבֿ‏ֳזזזוˆֻּהמׁˆוזײזאצוָװצ‎ּץגׂ׀כסו‏צוװזז׀זוז–ִגזצמזזזגהזאִזז׀ךוÿ׀‏בזְגדזעֵצהּזוזמדזְצדְֱזוזזעזזצסזזךזוציÿזזמזזזגהזאִזז׀ךבÿ׀‏ווצךבף–ֻזדְזזזוּזאומּמֿמּו׀ְ‎לגאזגצהם־ִÊם־ך־וְִֽיֽ‏Ýךֿ‏ÿבֿ‏Ýךֽ‏”ך׀‏אמְּאְִֿגוְֵופמםטדצסםץ‏ÿםוצ‏בְךֽהדּÝז־מידזװךאוך’ף׀—ךדז׀סבÝֳץזזןִ׀מˆ’ְהֻזזדזההßוÊץגצועזזזגוזבעזזזזוÿצזוזזביגץזההו‏ױװצ‏זץזגֿבפןִ׀גֻˆ׃װהֻבּזזזןˆטˆלˆֱˆ—׀זפזהנßוÊץגצוָפז׀מזץ׀זוזזזוס׀זוזצוֱזזזוזגּבְממב־ׂßוְוגוÝ‏•יףצÊםÞ‏Êיףצ•ךÝמנבץצאוך‎םְְיןֿ“ֽןÞךֹצÝףֳזßּצוְךוז־מ‏א־צׁםףמהזזוˆױףˆיֱסזזגזאְו’װצ‎ּץגזףגצגוז׀מוזזגוזצצזז—ָטזצגופעׂ׀ה–ו‏צהזזז׀מוזזי׀זזמזזצזהזנִזזזצגזבִזזזזג‏זעווזזגעו׃זמצזדזְגהז׀בזזמזזצזהזנִזזזצגזבִזזזזג‏זעווזזגעבֻזדצזזזוָזאפךעםהךאהוְױװצ‏זץזצֹיß‏Ýךֽ‏–יה‏ֽמְ‏ןםÝִÝוÝ‏•ךÝמנבץצאמˆÿמßמ־בßךֳגֿגלדצגץכהװֶוßִךןÞßציװװקםְףבוזףו׀גמÿדָהזÞךְכפִזזזןױˆ׀ˆ“גזזצזפזדטßוÊץגצהְצד׀מוזזבלזזזוזמךזזצמהזסִזזצגה‏זךוזְגהעזזזזומזגפעסוזְנלגאזגצגםֽע—יִֽÝוְ‏סבו‏Ýךֽ‏”ב׀‏ֽˆ׃“ׁצÝװ”םÝזֶבְעהß‏ָפזßמפװ“ןוצׁמְֿ‏דזפץצזזזֱ“Êזףכˆ׃צבׂזזךזמכגא‎גץזבצזזזצגזסצזזזזבֳזזגזזע—ץגזממב־ׂßוְוגזפגסמֱ“Êז‏ˆִצבׂקזזזזֱ–נˆˆױˆÝְלֶזזךזאֵגא‎גץזדְזזזצהדזזגוֳוגצזְְנלגאזגצדך׀גִֽדßÝהÊׁ–ְזזגז‏זמ‎זץ‏ה’ְזלזוÊßוÊץגצז“זזזגזְ׀זוזÿצנמצממב־ׂßוְוגגÝ‏Ýךֿ‏סבז‏ןוÞטׂגפְףןזּקֶד‏ה׀־צֶגְװףגֹגזזצזÊזֿצוסזל—זזזכױגא‎גץזמ׀מוזזגזְ׀זוז׀ךוס׀זוזציֱוזגדזציקזזזזד׀זטג־מףוצְÿלגאזגצפם־‏–ךß‏נךÝמ•יÝךעוְ‏ֽֽגצ־ךְךם־עזÝמ־ץדגהבה–םל־מֻםפמײפפ—זזצזÊזֿ‏ו‎׀כוזז‏זמֵגא‎גץזבְמוזְזופְגוזזמזְ׀זהזֹצץגֿזדהוִױװצ‏זץוךÝבÝִÝוÞךÊיÊ׃ײיֹוֿזװבÿס‘װזזצופˆÝעוך׀זוזוָזֲֵגא‎גץזגßגוזצךהזצזוזצגגזזילדְגוזעֻכװז׃צנגזְזזךהזצזדִזזהזזגזזְבֹזזזגוזוÿזזזזואזבזצצזובזֵצהגזז׀מוזְךוְֱזהזזגזזְבֹזזזגוזוÿזזזזואזבזצצזובו‎צז—זזזזֶזוּֽבהצֽוְְ‏לגאזגצנםÝִנךÝמ•יףצÊמÞמאוÞִ”ך׀ִ•יֽךÞבֿעעו־י–מßמ־בßךֳגֿגלדצגץכהװֶוßִךןÞßציװװקםְףבוזףו׀גמÿדָהזÞךְכפֱˆˆ׀זֲזֿ‏וÿ׀כוזזךו–צא’זזדˆˆ׀זךזֿ“וֵזלÝזזךוÝ׀ןאזזדˆˆ׀וÝזֿ“וו׀לÝזזךו—זבֿזזדˆˆ׀וֳזֿ‏וג׀כֽזזךו—צאִזזדˆˆ׀זׂזֿ‏וֿצכֽזזךו—׀ןֳזזזזזצז׳זֽװוףְלעזזךזמכגא‎גץזבצזזזצגזסצזזזזבֳזזגזזע—ץגזממב־ׂßוְוגגÞגסמפּוםֱֵז׳ץ‎ˆˆזףׁ׀זפזזזצזדזֳ—וֹ׀זזˆˆזף׀מבזץה–צזדזְֳוטזזזˆˆזםזמ־ז‏׀הױ׀זדזֳּוÞ׀זזזזמזךׁֹזםכˆׁ׀זכזוִז‎כגא‎גץכװז׃צנגזֲזזמוז׀זהִזעוז׀גדֵצזזזצגזס׀זזזזבֱוזגוזזבקא—זֲזזמוז׀גהז”“בזצךדְְזזזצגזס׀זזזזבֱוזגוזזבקנעזפדז׀זזז׀ÿדו‏פגזזכזזָּוְִסלגאזגצנםֽע—יֽךÞבֿעעו־ךאםֽע—יֽךÞבֿעעו־יטןו׀עבו׀ִבוצִןוצעןו׀עֹß׀ףבוװֵבוךֲִֿװףבוװֵבוךֵזזעזךׁֹז‏ׁˆׁ׀זכזוִזמ׀זׁזדװזנֵגא‎גץזףְצהזְזךוצװדהְעווְזו‎׀ְווְִןוִֻמזצ‏או–טהצ—דו׀‏ןףÝז׀םהצ‏אז׀ךזזז׀טÝז‘יֽצּכÞצׂל־ְ‏מßְ־ןֿ׀ךב׀׀נגֿזזה׀זלםזןבפׂßוְוגב־‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽו־‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽףֿ׀ִבוצִןוץ׃ןוװעבו׀ִבאעִןוצעןו׀עÝץ׀ִבוצִןופֻןו׀עבו׀ִבםֵבוצֵאßצףןוװעבוװֵבוצֵןוךעאßװעבו׃‘אßךעאßװעגßװֵגßצֵאßצףא׀זזז׀זÞˆִׂו־ׁˆזזװזד׀זֵזך־ßוÊץגפזכעבֿזמצזגזצעזוןזןזצעוונ—הזצזוזצוÿזְגזזזבֱז׀‏הזצזוףß׃כװווצנגזֿזזצווצגגוÿ“ןזצעבְְמוזזגוזבִהזצזזזסדוְמוזזבקא—ׂ׀גֻו‏צהמזוזגבזצצבְֱִווצנהזְגזזזךוזזיֻזְגזזזבֱוְגוזזבקא—זÊזזצווצגגוÿ“ןזצעבְְזזזְגזס׀זהזזךוזְיֻזזזזזסאזצגזזע‎נסֻזבֿזצזזזצאßזֶבֿצקדְ—ךזזװזה־צמוßעױװצ‏זץזצÊיףצ•ךÝמנבץצאמÞעÝוÞךגםֽע—יֽךÞבֿעעו־ךוץֿ׀ִבוצִןוף‘׃מפ—ְגעןו׀עבו׀ִבםֵבוצֵאßצףןבוז־ֿװףבוװֵבוךֵזזזדזדכ’׀ב•ˆזה׀זִזהְז“גא‎גפ–דְגבוְבלפזכעבֿזםזזאזצעזוֹזלו׀ּדוצגבֵצךוזזגוזבִדזצזזזס—גזְְדזצזוףץ׃כװווצנגזּזז‏ווצגאוÿ“לו׀ּדוצנהז׀גזזצגזס׀ךוזזזוÿצצההזךוזזביא—ׂ׀גֻו‏צהעזוְגבזצ‏בְֱָןהצךבו‏מדזצזגזצמוזזםֻז׀גזזזבֱהזגוזזבקא—ז׳זז‏ווצגאוÿ“לו׀ּדוצנהזזזדזצוÿזזךגזצמוז׀םֻזזזזזסמזצגזזע‎נסֻזןֿ—ֳדז׀זזו—ָןפִֽמצ׀ִדוװנבץצףגֿגזה׀זלםזװןבפׂßוְוגוה‏–יד‏Ýךֿ‏סבז‏ֽו־‏–ידִ”מÝִÝוÞךÿבֿעעו־ךÞםֽע—יֽךÞבֿעעו־ךוךֿ׀ִבוצִןופא׀געעßלגּזסזֿ׀צֻß׀ִבוצִןופֱאßצעאßװעגßß‘אֿךאוביזצבךמוץמ‏אßךעאßװעגßװזזצזÞˆ•גזּׁˆזזװזםױגא‎גץזא׀זזזצגזס׀זזזזבֱזְגוזזבקזזזזה׀זלםזךןבפׂßוְוגב־‏–יד‏Ýךֿ‏סבז‏ֽףֿ׀ִבוצִןופֱןוךעאßװעגß׀זזזמזךׁֿזץדˆׁ׀זכזוִזךױגא‎גץזם׀מוזזגוזבִהזצזזזסבז׀צדזצזוף׀׀ךזזזךב׀׀נגֿזזה׀זלםז‏ןבפׂßוְוגב־‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽףֿ׀ִגßךֵאßי׃אßװףבוװֵבםֵבוךִןוךעאß׀ףגß׀ִגßצֵזזזדזדכ’׀גפˆזה׀זÿזהךזצױגא‎גץזי׀מוזזִדוְךווזזו‎׀זגוצעגס׀זגוזסֱהזגבוזסקאוְךדזזזאהך‏מֿ“ִדוִךבֿמצזזװזה־צםוßעױװצ‏זץו‏Êיףצ•ךÝמנבץצאמÝמÊיףצ•ךÝמנבץצאמ׀‏Êיףצ•ךÝמנבץצאמ—“ִןוצעןו׀עֵו׀ִבוצִןוץעןו׀עבו׀ִבםֵבוצֵאßצףןו׀ףבוװֵבוצֲֵֿװףבוװֵבוךֵזזגזךׁÝזקדˆװ׀זדזההßוÊץגצועזזזגוזבעזזזזוÿצזוזזביגץזהוß‏ױװצ‏זץוִÝוÞיוױßלװףעזזזצזÞˆּׂוזֱÝזוזזנֵגא‎גפ•דצמהז׀זופּׂ׀הסו‏צוְגזצךזזזיׁזזגזזזבסזזגוזב—הזצזוזג—ֵצוִגזצךזז“צזזצזזזסעזזצגזÿצמוזזגזףסֻזדזזזזוזזדßגץבצעןבÞׂßוְוגג־‏–ידִ”מÝִÝוÞךÿבֿעעו־טלא׀גסעßלגֽעזץװצˆּׂ‎ג׀ִגע—וזע׀צמגßְזזזגזךְםֱזםמהׁצזכזהֶßוÊץגצוװזזזגוזבִזזזזוÿ׀מוזצזוף׀זזזזװזה־צדוßעױװצ‏זץומÊיףצ•ךÝמנבץצאמ—“ִןוצעןו׀עזֻֵבוךִןוךעא׀זוזדמהÿ׀הפזױ—זה׀זÊװצ‎ּץגזֵזזזוזצוÿזזזזזסהזצגזזעזזזזכזזָּז׀ִסלגאזגצפםֽע—יֽךÞבֿעעו־יטןו׀עבו׀ִבזםֱאßצףןו׀ףבוװזז׀זÞˆױמודֱזזװזב׀זֽזג־ßוÊץגצד—זזז‏וזצצזזנִזוזךבובִזזְִוז׀עהז•ִזוזצבÿ׀ְווצצבףßְ‏דז׀זזוְֽאהמֲןז׀ÿדו‏פגזזכזזָּהצִסלגאזגצנםֽע—יֽךÞבֿעעו־ךנםֽע—יֽךÞבֿעעו־ךנםֽע—יֽךÞבֿעעו־יטןו׀ףבו׀ִבה׀ֶאֿךףןו׀ףלß׀ִבוךֵאßט־אßצףןו׀ףבו׃סאßךעאß׀ףגß׃ÿאßךעאßװעגßװזזזגזךְד׃זםמופ׀זכזהֶßוÊץגצוװזזזגוזבִזזזזוÿ׀מוזצזוף׀זזזזװזה־צדוßעױװצ‏זץד‏Êיףצ•ךÝמנבץצאמ—“ִןוצעןו׀עץ׀ףגß׀ִגßךִזזזוזהֹˆהְו׳ˆ—זז׀זאװ׀מזזףזױבÝע”בפֻזײּלײצזוזדמהְֵגעזײ“זז׀זְװצ‎ּץגזסזזזוזצוסזזזזזס—זזצזוףץגצזְִנלגאזגצףך׀ִֽצֳךפ—זלׂצזזזזצזÞזֻזְּלזזװזםױגא‎גץזא׀זזזצגזס׀זזזזבֱזְגוזזבקזזזזה׀זלםזךןבפׂßוְוגג־‏–יד‏Ýךֿ‏סבז‏ֽףֿ׀ִבוצִןוצהÿßװעגß׀ִגßצֵזזגזךְםֱזםמהׁצזכזהֶßוÊץגצוװזזזגוזבִזזזזוÿ׀מוזצזוף׀זזזזװזה־צדוßעױװצ‏זץומÊיףצ•ךÝמנבץצאמ—“ִןוצעןו׀עזֻֵבוךִןוךעא׀זוזדכ‘צגסˆךזד׀ו‎װצ‎ּץכ‏ךזְמדזזבלפזכעבֿזאזצוז׀זזז•זזצזזזסעזזצגזÿצמוזזגזףץ׃זב׀צוז׀זדֿזזוזזזוסצזוזצוֳזְגזזצוינעזךזזזזד׀זטגץגסוצִÿלגאזגצפםֽע—יÝִֽיÝךןמßִÿבז‏ֻֽוװוה–ךפ—ץמˆהְגֶגֱ׳אֿךןזÝעסדםבץּזזזזזאזגÊזזגזזזזזזזזזיזזזזזגזזזזזזזגזגזז—זזגזזזזזזזמזוצוגזזגזזזזזזזךזן׀וםזזגזזזזזזזצזבְוָזזגזזזזזזזעזדצוזזגזזזזזזז‏זבזהכזזגזזזזזזזְזוְהֱזזגזזזזזזזּזדזהֻזזגזזזזזזזװזדְהßזזגזזזזזזז׀זדְהßזזךזזצצםזזזזֶזהˆזזךזזצצםזזגזכזגֹזזךזזצצםזזמזדְבףזזךזזצצםזזךזקְבֿזזךזזצצםזזצזלזאֱזזךזזצצםזזעזאְןןזזךזזצצםזז‏זלזאֱזזךזזצצםזזְזדזןֿזזךזזצצםזזּזאזן׃זזךזזצצםזזװזןזמבזזךזזצצםזז׀זןזמבזזךזזצצםזוזזמזמֿזזךזזצצםזוגזהְםוצ•׀ֲÿם׳‎•ֿ—מדמ׀ךףעְסאֻֿמג‎Þ‏נ’ױמבם–ֶא׀ְףאֻ־ִÊעְעןםֶׁÊסֳֽהווֳÿץֵָ”םÝכּ‎Þ‏נ’ױמבם–ֶא׀ְףאֻ־ִÊסהֵאבֶֽÝעׂךדז׀ט–סכס—“ץֹםֵֿÊ׃פֳנֿװףאֻ־ִÊע׃צÊßֿ‏•׃אִÊבֶׂÞופֳנֿװמגß׳‏ֹםֻמגםװ‏ניױסÊסÞִ•ֵֻׁ־ז–כֽז׀ךג‎Þ‏נ’ױעֹסֵָגß׳‏ֹםֻכעםװ‏ניױץÊֳׂאסÊננבׂ‎נװְפנֳׂאסÊֳ”ֳ”כÊ‎ֵֹׁץֻ‎־’ֵֽ•—זצ׀וׁזןזזֲצוÞזאּז‎׀וָזןצזמזזÞזדזזךצז–זהזז‏ְו’זהזזנצוֿזא“ז‎צוױזהזזפצוׁזא“זֳזוֻזא‏זכְזְזגגזֵזוװזהזזְִו׳זאִזֶזו—זןךזמזוÞזאעזִ׀וֻזןמזְֳוֻזאצזכְואזןמז‏צוׂזאװזמזופזןעזֶזוװזהזזףזו׳זאמזְִוֻזהזזצְוװזאגז‏׀וױזבמז‎צוֹזןעזֵזוֿזןמזיצזׂזדזזךזז׀זדװזסצוכזבִזףְזזג‏זְִוֿזא“זֶ׀ופזןעזֶזוװזג׀זֶצו־זןמז‎צז׃זגמזֵזוֿזאךזֶ׀ואזןמז‏צוׂזאװזעְו–זאְזֵזוךזאּז‏ְוÞזאעזכצוהזא׀ז‏צוֽזאװזסְוֻזןמזִ׀ו׳זאזְֵזְזדעזכְז׀זדזזךזואזאזְֵו—זאעז‎ְו‎זאגזְֵוֻזאװזמזוםזאזְֵו—זאעז‎ְו”זןִזֳ׀זׂזא‏זֵ׀וׂזןצז‎צוÊזה“ז‏׀וׁזא—זץְוÞזאגזְֵוױזהזזעְו–זאְזֵזזְזג׀זֶצו־זןמז‎צוהזא׀ז‏צוֽזאװזזזזזזְזזזזזזזק–זדמזזזזזזזזזזזזזזזזזזזזזזזזזזזןˆזזזזז׀זּזךּוזְדןזאמזױצגדזאךזױְהצזהעזםְדזקז‎זזֹזטּווזגבזהְז‎צגאזךְזÞְגןזךװוהזגםזהּזלְד“זצָזל׀זװזך׀זÝצדטזךוה׀גךזה—זכְגיזהודְגקזץזז“ְז׀זדגוגצגפזץךז‎ְזÞזיזז—צוֹזיךובזהץזלזװזזÝזט—זיזז–זץעובְגÿזד‏ואזדּזקװואצז”זץָוא׀גִזדְז–זדסזאְז–ְגֳזץ“ון׀ז’זדָזט׀זזטװומזהזפגזקצג־זט‏ומ׀וגזאּוםזוױזא׀זְֶגֻזפ‏זְֵו׃זלזזץצואזק“וזזוׁזגִז‘ְגֹזצגזפזו׀זפְזְִוÝזפּזִצגײזפװזפצולזקּוכזוכזג׀ז–׀ו—זן‏זֳ׀ו–זפ—וכְויזג“וכ׀וקזףזוךצגÞזטךזעזוץזףךויזג–זןְזעְו’זןװזֱזו‘זף‏זָצוזכגזע׀דׂזבצזסצג”זףְוטצונזףָז’צדזףװז־צוÿזף׀וקצגזבְזְֱהזזמגזֱ׀גˆזעזוצצו‎זבָזנ׀וִזט׀וצְה‘זעךזÿצבגזטִוץצדזזךגזֹצהֲזםװוץְבןזעְופצבלזעװוףזביזע“וף׀בצזסגועְבףזסצוסצבנזסִונזב‎זסָונ׀בִזס—וÿְבֱזנזו‏צב־זנךו‎זבֻזנ‏ו‎׀בָזנּוְֶבױזנ׀וֵצבׂזנוִזבßזÿמוִ׀ב—זÿעוְֳב”זÿְוֲצב‘זÿװוֱזבזÿ“וֱ׀אזז‏גוְְאדז‏צוֿצאאז‏ִו־זאםז‏ָו־׀אךז‏—וְֽאקז‎זזג׀זעזועזבְזÿזוְזאצזֶזוװזןזאץז‎מוּ׀אעז‎עוְֻאÿז‎ְוÊצאֶז‎װוֹזאֳז‎“וֹ׀אְזֶגוְָאֽזֶצו׳צאÊזִֶוײזא׳זֶָוײ׀אװזֶ—וױְאׁזֵזוװצאÞזֵךו׃זא–זֵ‏ו׃׀א“זכ׀זזד–זק‏וׂצא‘זֵװוׁזאזֵ“וׁ׀ןזזִגו׀ְןדזִצוßצןאזִִוÞזןםזִָוÞ׀ןךזז—זק׀דדזמִזןצזקזלװזוזהֽזז‏זגצז־זלמזוצזלזו“זגְוהזִ—וÝְוֲזאזזקְוזזזװזדזןקזֳזו—צןפזֳךו–זהÝזכמזגזןסזֳ‏ו–׀ה׳זלָזְׁהˆזךעז׃זה–זכ‏ז׃׀דגזְֳו•צןֶזֳװו”זןֳזֳ“ו”׀ןְזֲגזֿזהזזִו“ְהÊזֲךו’זןֻזמעזְֻןÊזאגזׂזזְזהגזֻצןֹזם׀זן׀העזלצו‘זדׁזקזזֽ׀ה‏זזְזßְזטזםךז׳צה‎זכּזÿ׀דָזהךזהצהמזמװז־ְהאזמ׀זְ׀ן׳זֲָזצצההזךמו‘׀ןװזֲ—וְןׁזֱזוצןÞזֱךוזן–זֱ‏ו׀ן“זֱּוְןזמ—ז•׀דֿזי“ז•זהטזי׀זצ׀דֱזיָז“זדֳזיּוˆזןזֱ“וˆ׀מזזְגהזְמדזְצהוצמאזְִההזמםזְָהה׀מךזְ—אצנםÞ‎ÿ‎ֻו—בׁ‎•ׂ‎נװאץאיִֿÊׂוּץִֽÊֳֿז‎ב‏•בÞֵ•“לץנץֳׁאבֽ‏•סֳׂזֳבֵנבִֽÊׂו—סׁ‎•ׂ‎נװךץ•יֵׁנ–ֿ‏ניֽ‎נ’—ו—ֻ׃‏ניÞֵ•“ןפנֵֹ•’ֶֻ׀ßכ‏•׃ֵנבֿ‏•יֵֹֻצאףאבֳֽÿץֻוּßֽ‏ÿםְֵׁßך‏•׃ֵנבֿ‏•יֵֹֻצאףÊבֳֽÿץֻוּ’ֽ‏ÿםְֵׁßט‏•׃ֵנבֿ‏•יֵֹֻצןף•–ֿ‏”םְֵׁ‎פ‏ני–ֳאעאעÊיִֿÊׂדבםֵֽ•–׃‏נבֽ‏•סֳׂז‎ף‏ני–ֳאעךע•יֵׁנ–ֿ‏ניֽ‎נ’—וֻץֽ‏ÿםְֳֵׁ–ֵÊּ׀ךף‏Þו”סֶׂףזÞךעגןסנ–ֿ‏”םְֳֵׁסֵ•ֳֵׁÊסױוססÞֶנ’ֹה–ֶֻֽÿםֳֽנ–Êֵאס“וִֹֻֻÊב•‎צ‎ֶ‏ני–ֳאעלנÊץֳׁאבֽ‏•סֳׂז‎ֿ‏ֹםֳֻÊען‏נ–ֿ‏”םְֳֵֵֿׁ•ֳֵׁÊסױוÊץֽ‏ÿםְֵׁ‎ֻ‏•בÞֵ•“ל‎נץֳׁאבֽ‏•סֳׂזֳֵֻנבִֽÊׂו•סׁ‎•ׂ‎נװך‎•יֵׁנ–ֿ‏ניֽ‎נ’—ו•ֻ׃‏ניÞֵ•“ןֶנֵֹ•’ֶֻ׀ßױ‏•׃ֵנבֿ‏•יֵֹֻצאֵאבֳֽÿץֻוÊßֽ‏ÿםְֵׁßװ‏•׃ֵנבֿ‏•יֵֹֻצאֵÊבֳֽÿץֻוÊ’ֽ‏ÿםְֵׁßׂ‏•׃ֵנבֿ‏•יֵֹֻצןֵ•–ֿ‏”םְֵׁ‎Þ‏ני–ֳאעאִÊיִֿÊׂדןםֵֽ•–׃‏נבֽ‏•סֳׂז‎Ý‏ני–ֳאעךִ•יֵׁנ–ֿ‏ניֽ‎נ’—וֹץֽ‏ÿםְֳֵׁ–ֵÊּ׀ךף‏Ýו”סֶׂףזÞךעמןֳנ–ֿ‏”םְֳֵׁ–ֵ•ֳֵׁÊסױוÿסÞֶנ’ֹה”ֶֻֽÿםֳֽנ–Êֵאס“וִֹֹֻÊב•‎צ‎‘‏ני–ֳאעלֲÊץֳׁאבֽ‏•סֳׂזֳ–ֵÊּ׀יע‏׀ו”סֶׂףז–ץֽגןֳנ’׳ךדסאךְֳ–ֵÊֻאצֽץאו”סֶׂףז–ץדזןֳנ’׳ךדסגךצֳ–ֵÊּ׀יעצÞו”סֶׂףז–ץדךןֳנ’׳ךדסגיזֳ–ֵÊּ׀יעצ–ה”סֶׂףז–ץדע׀יעךßו”סֶׂףז–ץד‏ןֳנ’׳ךדסגי׀ֳ–ֵÊּ׀יעצ“ו”סֶׂףז–ץדּןֳנ’׳ךדסגצצֳ–ֵÊּ׀יעץהו”סֶׂףז–ץגךןֳנ’׳ךדסגץזֳ–ֵÊּ׀יעץבו”סֶׂףז–ץג‏ןֳנ’׳ךדסבךזֳ–ֵÊּ׀יעעßו”סֶׂףז–ץףמןֳנ’׳ךדסבך׀ֳ–ֵÊּ׀יעע—ו”סֶׂףז–ץףעןֳנ’׳ךדסביְֳ–ֵÊּ׀יעע”ו”סֶׂףז–ץףְןֳנ’׳ךדסבטצֳ–ֵÊּ׀יעסוו”סֶׂע‎הךֽזןֳנ’׳ץּמÞךצֳ–ֵÊֻאצֽמÞו”סֶׂע‎הךֽךןֳנ’׳ץּמÞיזֳ–ֵÊֻאצֽמ–ו”סֶׂע‎הךֽ‏ןֳנ’׳ץּמÞי׀ֳ–ֵÊֻאצֽמ“ו”סֶׂע‎הךּגןֳנ’׳ץּמÞצְֳ–ֵÊֻאצֽםדו”סֶׂע‎הךּצןֳנ’׳ץּמÞץצֳ–ֵÊֻאצֽםאו”סֶׂע‎הךÝזןֳנ’׳ץּמÝךצֳ–ֵÊֻאצֽךÞו”סֶׂע‎הךÝךןֳנ’׳ץּמÝיזֳ–ֵÊֻאצֽך–ו”סֶׂע‎הךÝ‏ןֳנ’׳ץּמÝטזֳ–ֵÊֻאצֽך’ו”סֶׂע‎הך—גןֳנ’׳ץּמÝצְֳ–ֵÊֻאצֽידו”סֶׂע‎הך—עןֳנ’׳ץּמ—ךזֳ–ֵÊֻאצֽצßו”סֶׂע‎הידךןֳנ’׳ץּמ—יזֳ–ֵÊֻאצֽצ•ו”סֶׂע‎הידִןֳנ’׳ץּמ—טזֳ–ֵÊֻאצֽצ’ו”סֶׂע‎היגגןֳנ’׳ץּמ—צְֳ–ֵÊֻאצֽץדו”סֶׂע‎היגצןֳנ’׳ץּמ—ץצß–ֵÊּ׀יעץדכֹיÝךדגךֳנ’׳ךדסבך־’ÝִÝזßדן׳ִֻÊֵׂאֵֽגֻÿעְ׃ֵׁÊעֵׂאֵֽגֻÿעְ׃—ֳ•ֵׂאֵֽגֻÿעְ–—ֶןםֻ‎פ’װֵ•יװפסֳפדא‎ֳׁÿמֵׂאֵֽגֻÿעְßÊֶÿ‎ֻכÊßׁ‏•ßםס–מכִ•ֻ“כÊßׁ‏•ßםס–מיִ•ס•‎נ“ֵׂאֵֽגֻÿעְ–ֶֻנֳֳָה’װֵ•יװפסֳפדא’׳ֵÊעֵׂאֵֽגֻÿעְֿ‘‎ÿםׁכÊÝ‎ְֳֵׁÊעֵׂ”יÊו”ץ”ֵÞ’ִׁ•‏םֳאֿÞ‎נעֵׂ”יÊהא‎ֳׁÿמֵׂ”יÊהא‎׳ֳÊעֵׂ”יÊו”י׳ֲה’ִׁ•‏םִ•ס•‎נ“ֵׂ”יÊהנס׳‎•ֿ—כÊÝ‎ְֶֿׂנ’ֻכÊÝ‎ְֳ‘‎ÿםׁכֹץÊוÊׂ‎פ’—‎ְ‎—ֳ•ֳׂא‏מֳאֿÞ‎נעֳׂא‏ן‎Ê–ִ־’—‎ְֳÊֶÿ‎ֻכֹץÊוֹי׳ֲה’—‎ְֿÝ‎ÿ‎ֵֻ־’—‎ְֶֻֿנֳֳָה’—‎ְֳֶׂנ’ֻכֹץÊהÿ׳ִֻÊֳׂאÝ‎ְֵֿׁÊעֳׂאÝ‎ְֿ—ֳ•ֳׂאÝ‎ְ׳—ֶןםֻ‎פ’—ֵ”יÊהנ‎ֳׁÿמֳׂאÝ‎ְֻÊֶÿ‎ֻכֹץִׁ•‏מִ•ֻ“כֹץִׁ•‏לִ•ס•‎נ“ֳׂאÝ‎ְ׳ֶֻנֳֳָה’—ֵ”יÊהנ’׳ֵÊעֳׂאÝ‎ְֳ–ֵÊּÞךדְ׀ו”סֶׂףמ׀טדגןֳנ’׳ךֽז“ךְֳ–ֵÊּÞךדְÝו”סֶׂףמ׀טדצןֳנ’׳ךֽז“יצֳ–ֵÊּÞךדְ•ו”סֶׂףמ׀טדִןֳנ’׳ךֽז“טזֳ–ֵÊּÞךדְ’ו”סֶׂףמ׀יÝזןֳנ’׳ךדוהטצֳ–ֵÊּ׀ךגמÞו”סֶׂףז׀צֽךןֳנ’׳ךֽז”יזֳ–ֵÊּÞךדִ–ו”סֶׂףמ׀יÝ‏ןֳנ’׳ךֽז”י׀ֳ–ֵÊּÞךדִ“ו”סֶׂףמ׀יÝּק‎ÿֵֽֿאב׃‎א”ֵ־’